<script>
const DATA = {{DATA_JSON}};

// ── tokens → JS ────────────────────────────────────────────────────────
// cssVar() is for plain, theme-independent tokens (the font stack) —
// getPropertyValue on a custom property returns its DECLARED TEXT, which is
// fine for a font stack but not for a colour that might be a color-mix().
//
// Every OTHER colour in this file is either (a) drawn to a <canvas> by
// Chart.js, which needs an actual resolved colour string handed to it in
// JS, or (b) plain HTML/SVG that references a shared --rp-* token with a
// bare var(--rp-series-1) written straight into a style attribute — for
// (b), the browser's own cascade re-resolves that at paint time under
// @media print, so it needs no JS help and is never read with
// getComputedStyle at all (see renderTrafficTable, sparklineSvg).
//
// For (a) — bootstrapChartDefaults() and every Chart.js dataset colour —
// the naive approach is to read the CURRENT theme's tokens with
// getComputedStyle and rebuild on "beforeprint" when the theme switches.
// That fails: instrumented directly, matchMedia("print").matches is still
// false inside a beforeprint handler, and there is no later event that
// fires after @media print actually applies but before Chrome captures the
// page — so getComputedStyle() in ANY handler here would return the SCREEN
// palette, baking dark ink into a light-printed PDF. ctVar() sidesteps the
// cascade entirely: every canvas colour exists as an explicit pair at
// :root, --ct-<name> and --ct-<name>-print (see <style>), so the caller
// hands in which one it wants instead of asking. cssColor() still resolves
// through a hidden probe element rather than a bare getPropertyValue,
// because a couple of the --ct-* values remain color-mix()-shaped and
// getPropertyValue would hand Chart.js that function's literal source text.
function cssVar(name) { return getComputedStyle(document.documentElement).getPropertyValue(name).trim(); }
let _colorProbe = null;
function cssColor(name) {
  if (!_colorProbe) {
    _colorProbe = document.createElement("span");
    _colorProbe.style.display = "none";
    document.body.appendChild(_colorProbe);
  }
  _colorProbe.style.color = `var(${name})`;
  return getComputedStyle(_colorProbe).color;
}
function ctVar(name, printing) { return cssColor(`--ct-${name}${printing ? "-print" : ""}`); }

const CWV_THRESHOLDS = { lcp: { good: 2500, poor: 4000 }, inp: { good: 200, poor: 500 }, cls: { good: 0.1, poor: 0.25 } };
function ratingFor(key, value) {
  const t = CWV_THRESHOLDS[key];
  if (value == null || !t) return "none";
  if (value <= t.good) return "good";
  if (value <= t.poor) return "needs-improvement";
  return "poor";
}
// Position a value on its metric's own threshold scale, as a percentage of
// the track. Anchors are fixed so every tile agrees: 0 -> 0%, good -> 40%,
// poor -> 70%, twice the poor boundary -> 100% (clamped beyond that).
// Ported unchanged from full-page-analysis/assets/report.html.tmpl.
function thresholdPos(value, t) {
  if (value == null || !(t.good > 0) || !(t.poor > t.good)) return null;
  const v = Math.max(0, value);
  if (v <= t.good) return 40 * (v / t.good);
  if (v <= t.poor) return 40 + 30 * ((v - t.good) / (t.poor - t.good));
  return Math.min(100, 70 + 30 * ((v - t.poor) / t.poor));
}
