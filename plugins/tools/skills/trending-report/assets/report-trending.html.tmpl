// diamond+X) so colour is never the sole carrier of a verdict. Reproduced
// as inline SVG (currentColor) because this report ships as one
// standalone file with no Strato runtime to import icons from.
const RATING_SHAPES = {
  good:
    `<svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true">` +
    `<circle cx="6" cy="6" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/>` +
    `<path d="M3.5 6.2 5.2 7.9 8.6 4.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  "needs-improvement":
    `<svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true">` +
    `<path d="M6 1.1 11.4 10.6H0.6Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>` +
    `<path d="M6 4.5v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>` +
    `<circle cx="6" cy="8.9" r=".85" fill="currentColor"/></svg>`,
  poor:
    `<svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true">` +
    `<path d="M6 .9 11.1 6 6 11.1.9 6Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>` +
    `<path d="M4.3 4.3 7.7 7.7M7.7 4.3 4.3 7.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  none:
    `<svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true">` +
    `<circle cx="6" cy="6" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/>` +
    `<path d="M3.2 8.8 8.8 3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
};
const RATING_WORDS = { good: "Good", "needs-improvement": "Needs work", poor: "Poor", none: "Not measured" };

function compactFmt(n) {
  if (n == null || Number.isNaN(n)) return "—";
  if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (Math.abs(n) >= 1e3) return (n / 1e3).toFixed(1) + "k";
  return Math.round(n).toString();
}
function fmtMsClient(ms) {
  if (ms == null || Number.isNaN(ms)) return "—";
  return ms >= 1000 ? (ms / 1000).toFixed(1) + "s" : Math.round(ms) + "ms";
}
function fmtCls(v) { return v == null || Number.isNaN(v) ? "—" : v.toFixed(2); }

// ── the shared metric-tile, used both compact (page 1 KPI row) and full
// (page 3 status row) — the CSS context (.kpi-row vs .metric-grid) is what
// hides the name/bounds/tail rows in the compact case, not a second
// template, so the two can never drift apart. ─────────────────────────────
const CWV_METRICS = [
  { key: "lcp", label: "LCP", name: "Largest Contentful Paint", fmt: fmtMsClient },
  { key: "inp", label: "INP", name: "Interaction to Next Paint", fmt: fmtMsClient },
  { key: "cls", label: "CLS", name: "Cumulative Layout Shift", fmt: fmtCls },
];
function metricTile(def, series, i) {
  const value = series[def.key][i];
  const prior = i > 0 ? series[def.key][i - 1] : null;
  const rating = ratingFor(def.key, value);
  const t = CWV_THRESHOLDS[def.key];
  const pos = thresholdPos(value, t);
  const mark = pos == null ? "" : `<span class="mt-mark mt-mark-p75" style="left:${pos.toFixed(2)}%" title="${def.fmt(value)}"></span>`;
  const delta = prior != null && prior !== 0 && value != null ? ((value - prior) / prior) * 100 : null;
  const deltaText = delta == null ? "—" : `${delta >= 0 ? "+" : ""}${delta.toFixed(1)}%`;
  return `<article class="metric-tile" data-rating="${rating}">
    <div class="mt-head"><span class="mt-abbr">${def.label}</span>
      <span class="status" data-rating="${rating}">${RATING_SHAPES[rating]}${RATING_WORDS[rating]}</span></div>
    <div class="mt-name">${def.name}</div>
    <div class="mt-value">${def.fmt(value)}<span class="mt-value-tag">p75</span></div>
    <div class="mt-scale"><div class="mt-track">
      <span class="mt-zone mt-zone-good"></span><span class="mt-zone mt-zone-ni"></span><span class="mt-zone mt-zone-poor"></span>
    </div>${mark}</div>
    <div class="mt-bounds"><span>good &le; ${def.fmt(t.good)}</span><span>poor &gt; ${def.fmt(t.poor)}</span></div>
    <div class="mt-tail"><span>prior <b>${def.fmt(prior)}</b></span><span>&Delta; <b>${deltaText}</b></span></div>
  </article>`;
}

function renderKpis() {
  const row = document.getElementById("kpi-row");
  if (!row) return;
  const plainHtml = (DATA.kpis || []).map((k) => {
    const neutral = k.change == null || k.change === 0;
    const positive = k.lowerIsBetter ? k.change < 0 : k.change > 0;
    const cls = neutral ? "neutral" : positive ? "good" : "bad";
    // "vs prior month" wrapped the pill onto two lines at kpi-tile width —
    // a wrapped pill reads as broken, and "MoM" is the standard shorthand
    // for the same comparison in this deck's own audience.
    const changeHtml = k.change == null ? "" :
      `<div class="kpi-change ${cls}">${k.change >= 0 ? "▲" : "▼"} ${Math.abs(k.change).toFixed(1)}% MoM</div>`;
    return `<div class="kpi-tile"><div class="kpi-label">${k.label}</div><div class="kpi-value">${k.value}</div>${changeHtml}</div>`;
  }).join("");
  const cwv = DATA.cwvMonthly;
  const i = cwv && cwv.labels.length ? cwv.labels.length - 1 : -1;
  const cwvHtml = i >= 0 ? CWV_METRICS.map((def) => metricTile(def, cwv, i)).join("") : "";
  row.innerHTML = plainHtml + cwvHtml;
}

function renderCwvStatusRow() {
  const el = document.getElementById("cwv-status-row");
  if (!el) return;
  const cwv = DATA.cwvMonthly;
  if (!cwv || !cwv.labels.length) { el.innerHTML = `<p class="empty-note">No Core Web Vitals data for this period.</p>`; return; }
  const i = cwv.labels.length - 1;
  el.innerHTML = CWV_METRICS.map((def) => metricTile(def, cwv, i)).join("");
}

// ── flex-bars (page 2) ──────────────────────────────────────────────────
// Bars below carry NO colour of their own — the shared layer's own rule for
// .bar-fill ("neutral ink unless the cell is graded against a threshold, in
// which case the renderer sets --bar-accent from the rating") applies here
// unchanged. None of these four columns is a grading (the header already
// names which column is which), so a per-column hue would be decorative,
// not informative — exactly what the monthly deck's matching panel avoids,
// and the two decks read as one system only if neither invents a colour
// meaning the other doesn't have. Leaving `color` unset lets .bar-fill fall
// through to its default, var(--bar-accent, var(--text-subdued)).
function renderTrafficTable() {
  const d = DATA.trafficMonthly;
  const el = document.getElementById("table-trafficMonthly");
  if (!el) return;
  if (!d || !d.labels.length) { el.innerHTML = `<p class="empty-note">No traffic data for this period.</p>`; return; }
  const columns = [
    { key: "sessions", label: "Sessions" },
    { key: "pageLoads", label: "Navigations" },
    { key: "userActions", label: "XHR Requests" },
  ];
  // % Desktop is a share of a whole, not a magnitude, so it keeps the
  // shared "outlined" (coverage-meter) treatment — same reason the monthly
  // deck uses the thin bordered track for its own proportional columns.
  if (d.pctDesktop) columns.push({ key: "pctDesktop", label: "% Desktop", max: 100, outlined: true, fmt: (v) => Math.round(v) + "%" });
  const maxByCol = {};
  columns.forEach((c) => { maxByCol[c.key] = c.max || Math.max(0, ...(d[c.key] || []).map((v) => (typeof v === "number" ? v : 0))); });
  const header = `<div class="flex-bars-header"><div class="flex-bars-spacer"></div>${columns.map((c) => `<div class="flex-bars-col-hdr">${c.label}</div>`).join("")}</div>`;
  const body = d.labels.map((label, i) => {
    const isCurrent = i === d.labels.length - 1;
    const cells = columns.map((c) => {
      const v = d[c.key] ? d[c.key][i] : null;
      const trackClass = c.outlined ? "bar-track outlined" : "bar-track";
      if (v == null) return `<div class="flex-bars-cell"><div class="bar-cell"><div class="${trackClass}"></div><span class="bar-value">—</span></div></div>`;
      const max = maxByCol[c.key];
      const pct = max > 0 ? Math.max(2, (v / max) * 100) : 0;
      const text = c.fmt ? c.fmt(v) : compactFmt(v);
      return `<div class="flex-bars-cell"><div class="bar-cell"><div class="${trackClass}"><div class="bar-fill" style="width:${pct}%"></div></div><span class="bar-value">${text}</span></div></div>`;
    }).join("");
    return `<div class="flex-bars-row${isCurrent ? " current" : ""}"><div class="flex-bars-row-label">${label}</div>${cells}</div>`;
  }).join("");
  el.innerHTML = `<div class="flex-bars">${header}<div class="flex-bars-body">${body}</div></div>`;
}

// ── opaque canvas backing ─────────────────────────────────────────────
// Chrome exports every <canvas> into a PDF as a vector transparency-group
// form XObject. Poppler (pdftoppm, and every earlier render-and-Read check
// in this file's history) composites that correctly, but Apple's
// CoreGraphics — what macOS Preview and Quick Look use — renders the
// group's region as FULLY TRANSPARENT instead, which paints as a white
// hole wherever the group's bounding box lands (not necessarily over the
// chart itself). Page 4's sparklines are plain SVG, not canvas, and are
// unaffected; every Chart.js canvas on page 3 is.
//
// The fix is two parts, both required:
//   1. Force an opaque backing store before Chart.js ever calls
//      getContext("2d") itself — a canvas's context creation options are
//      fixed on the FIRST getContext() call and ignored on every call
//      after, so grabbing it here with {alpha:false} first is what makes
//      Chart.js's own later getContext("2d") return the same opaque
//      context rather than a transparent one. This alone removes the hole.
//   2. An opaque context defaults its backing to BLACK, not to this deck's
//      panel colour, so something has to paint over it every draw. That
//      has to be a beforeDraw plugin rather than a one-off fill after
//      chart creation, so it survives Chart.js's own resize/redraw passes
//      (e.g. the beforeprint rebuild). It must use source-over (the
//      canvas default) and run BEFORE the chart draws its own series —
//      destination-over has nothing transparent left to composite under
//      once the context is opaque, and paints the whole canvas over the
//      series instead.
// The fill colour is threaded through as a per-chart plugin option
// (opts.bg, set from ctVar("panel-bg", printing) in baseChartOptions) —
// reading getComputedStyle inside the plugin itself would hit the exact
// beforeprint/dark-palette trap ctVar() exists to avoid.
function forceOpaqueCanvases() {
  document.querySelectorAll("canvas").forEach((c) => c.getContext("2d", { alpha: false }));
}
Chart.register({
  id: "opaqueBacking",
  beforeDraw(chart, args, opts) {
    const ctx = chart.ctx;
    ctx.save();
    ctx.fillStyle = opts.bg;
    ctx.fillRect(0, 0, chart.width, chart.height);
    ctx.restore();
  },
});
// Draws the good and poor boundary rules across a semantic-scale chart (see
// renderCwvWeeklyCharts). Registered AFTER opaqueBacking so it draws over
// that fill, and hooked on beforeDraw so both land under the series.
// Colours arrive as a per-chart plugin option for the same reason
// opaqueBacking's do: reading the cascade inside a plugin hits the
// beforeprint dark-palette trap that ctVar() exists to dodge.
//
// Filled good/NI/poor bands were tried here and dropped. The panel is a dark
// blue-purple, so at any alpha quiet enough to stay behind the series the
// base dominates the mix and the three bands come out slate, brown and mauve
// — related muds rather than teal, amber and red. Raising the fill until the
// hues read takes roughly 30%, by which point the backdrop competes with the
// 2px series on top of it. A dashed rule carries the same boundary at full
// strength for a fraction of the ink, and matches the idiom page 4 already
// uses for the identical boundaries.
Chart.register({
  id: "thresholdLines",
  beforeDraw(chart, args, opts) {
    if (!opts || !opts.rules || !chart.chartArea) return;
    const { top, bottom, left, right } = chart.chartArea;
    const y = chart.scales.y;
    const ctx = chart.ctx;
    const clampY = (v) => Math.max(top, Math.min(bottom, y.getPixelForValue(v)));
    ctx.save();
    opts.rules.forEach(({ at, color }) => {
      const yAt = clampY(at);
      ctx.beginPath();
      ctx.setLineDash([4, 3]);
      ctx.strokeStyle = color;
      ctx.lineWidth = 1;
      ctx.moveTo(left, yAt + .5);
      ctx.lineTo(right, yAt + .5);
      ctx.stroke();
    });
    ctx.restore();
  },
});

// ── weekly CWV: three small multiples, one metric each, never a shared
// axis (see the page 3 comment in <style> for why a shared LCP+INP axis
// didn't survive contact with the data, and the dataviz skill's "one axis"
// rule for why a second y-axis on one canvas isn't the fix either). Legend
// is hand-built HTML (shared .chart-legend/.item/.swatch/.dash), not
// Chart.js's built-in legend plugin — Chart.js draws a dashed dataset's
// legend swatch as a small filled+bordered box, which reads as a hatch
// pattern rather than as the dashed line it represents; the shared .dash
// element is the actual mark redrawn small. Being plain HTML it also picks
// up var(--rp-series-N) directly with no printing-flag plumbing needed. */
function baseChartOptions(yTitle, printing) {
  const grid = ctVar("grid", printing);
  const axisText = ctVar("axis-text", printing);
  return {
    responsive: true, maintainAspectRatio: false,
    interaction: { mode: "index", intersect: false },
    animation: false,
    scales: {
      x: { grid: { color: grid }, ticks: { color: axisText, font: { size: 10 } } },
      y: { grid: { color: grid }, ticks: { color: axisText, font: { size: 10 } },
           title: { display: true, text: yTitle, color: axisText, font: { size: 10 } } },
    },
    // opaqueBacking (registered once, below) needs the printing-correct
    // panel colour per chart, not read off the cascade at draw time — see
    // its registration comment for why.
    plugins: { legend: { display: false }, opaqueBacking: { bg: ctVar("panel-bg", printing) } },
  };
}
// ── the semantic threshold scale ─────────────────────────────────────────
// These charts do NOT plot milliseconds. They plot thresholdPos() — the same
// 0/40/70/100 anchoring the metric tiles and the page-4 sparklines use, where
// good ends at 40, poor begins at 70, and twice the poor boundary is 100.
//
// Two earlier attempts failed on the same axis, in opposite directions. Left
// to autoscale over the raw values plus flat threshold datasets, Chart.js
// fits every dataset, so a "poor > 4.0s" line drags a chart whose data lives
// at 700–1300ms onto a 0–4,000ms axis and irons the real trend flat. Scaling
// to the data instead fixed the trend but pushed both LCP thresholds off the
// canvas, so the one thing the page exists to answer — is this good? — had to
// be read out of a legend note.
//
// Normalising the DATA rather than the axis settles both: both boundaries are
// always on screen at the same place in every chart, the series keeps its
// shape wherever it sits, and thresholdPos()'s own clamp at 100 keeps an
// outlier (this tenant's 2,004ms INP week) inside the plot instead of
// stretching it. The cost is that y is no longer a linear ms ramp, so the
// ticks are the BOUNDARIES themselves — 0, good, poor, 2× poor — which is
// what a reader actually wants to locate a point against. Raw values are not
// lost: the tooltip prints the real measurement, and the metric tiles above
// print the p75 figure.
const ZONE_TICKS = [0, 40, 70, 100];
function semanticScale(metric, series, printing) {
  const t = CWV_THRESHOLDS[metric];
  const fmt = CWV_METRICS.find((m) => m.key === metric).fmt;
  // Tick -> the real value that position represents, so the axis reads in the
  // metric's own unit even though the spacing is semantic.
  const atTick = { 0: 0, 40: t.good, 70: t.poor, 100: t.poor * 2 };
  return {
    data: (series || []).map((v) => (typeof v === "number" ? thresholdPos(v, t) : null)),
    ticks: ZONE_TICKS,
    tickLabel: (v) => (atTick[v] === undefined ? "" : fmt(atTick[v])),
    // Chart.js hands the tooltip the normalised y; the reader needs the
    // measurement, so it is looked back up out of the source series.
    rawAt: (i) => fmt((series || [])[i]),
    // Both boundaries are drawn on every chart whether or not the data goes
    // anywhere near them — "nowhere close to poor" is itself the answer the
    // page exists to give, and it only reads if the line is there to be far
    // from.
    rules: [
      { at: 40, color: ctVar("threshold-good", printing) },
      { at: 70, color: ctVar("threshold-poor", printing) },
    ],
  };
}
// Legend items: [{ label, swatch }, { label, dash }].
function legendHtml(items) {
  return items.map((it) => {
    if (it.dash) return `<span class="item"><span class="dash" style="border-top-color:var(${it.dash})"></span>${it.label}</span>`;
    return `<span class="item"><span class="swatch" style="background:var(${it.swatch})"></span>${it.label}</span>`;
  }).join("");
}
// Tracked so beforeprint can destroy and rebuild rather than layer a second
// canvas draw on top of the first with the other theme's colours baked in.
let lcpChart = null, inpChart = null, clsChart = null;
function renderCwvWeeklyCharts(printing) {
  const d = DATA.cwvWeekly;
  const els = {
    lcp: document.getElementById("chart-cwvWeeklyLcp"),
    inp: document.getElementById("chart-cwvWeeklyInp"),
    cls: document.getElementById("chart-cwvWeeklyCls"),
  };
  if (!els.lcp || !els.inp || !els.cls) return;
  forceOpaqueCanvases();
  if (lcpChart) { lcpChart.destroy(); lcpChart = null; }
  if (inpChart) { inpChart.destroy(); inpChart = null; }
  if (clsChart) { clsChart.destroy(); clsChart = null; }
  if (!d || !d.labels.length) {
    Object.values(els).forEach((el) => { el.parentElement.innerHTML = `<p class="empty-note">No weekly data for this period.</p>`; });
    return;
  }
  // One builder for all three: the metrics differ only in which series they
  // read, which accent they take and which thresholds scale them.
  const build = (canvas, metric, label, seriesVar) => {
    const s = semanticScale(metric, d[metric], printing);
    const o = baseChartOptions("vs thresholds", printing);
    o.scales.y = Object.assign(o.scales.y, {
      min: 0, max: 100,
      ticks: Object.assign({}, o.scales.y.ticks, {
        // An explicit tick list, because the positions that matter are the
        // boundaries, not an even division of a scale that isn't linear.
        callback: (v) => s.tickLabel(v),
        autoSkip: false,
      }),
      afterBuildTicks: (axis) => { axis.ticks = s.ticks.map((v) => ({ value: v })); },
    });
    o.plugins = Object.assign({}, o.plugins, {
      thresholdLines: { rules: s.rules },
      tooltip: { callbacks: { label: (ctx) => `${label}: ${s.rawAt(ctx.dataIndex)}` } },
    });
    return new Chart(canvas, {
      type: "line",
      data: { labels: d.labels, datasets: [
        { label, data: s.data, borderColor: ctVar(seriesVar, printing), backgroundColor: ctVar(seriesVar, printing), tension: .35, pointRadius: 0, borderWidth: 2, spanGaps: true },
      ] },
      options: o,
    });
  };
  lcpChart = build(els.lcp, "lcp", "LCP", "series-1");
  inpChart = build(els.inp, "inp", "INP", "series-2");
  clsChart = build(els.cls, "cls", "CLS", "series-3");
  // The two rules the chart draws, named with the boundary value they sit at.
  const ruleLegend = (metric) => {
    const t = CWV_THRESHOLDS[metric];
    const fmt = CWV_METRICS.find((m) => m.key === metric).fmt;
    return [
      { label: `Good ≤ ${fmt(t.good)}`, dash: "--good" },
      { label: `Poor > ${fmt(t.poor)}`, dash: "--critical" },
    ];
  };
  document.getElementById("legend-cwvWeeklyLcp").innerHTML = legendHtml([{ label: "LCP", swatch: "--rp-series-1" }, ...ruleLegend("lcp")]);
  document.getElementById("legend-cwvWeeklyInp").innerHTML = legendHtml([{ label: "INP", swatch: "--rp-series-2" }, ...ruleLegend("inp")]);
  document.getElementById("legend-cwvWeeklyCls").innerHTML = legendHtml([{ label: "CLS", swatch: "--rp-series-3" }, ...ruleLegend("cls")]);
}

// ── browser panels (page 4): sparkline + status chips, see the page 4
// comment in <style> for why this replaced the old per-month table. The
// sparkline is plain SVG, so its stroke/fill is a literal var(--rp-series-1)
// written into a style attribute (same reasoning as renderTrafficTable) —
// no printing flag needed, the cascade already gets this right on its own.
// The y axis is the metric's own THRESHOLD scale, not its data range — the
// same 0/40/70/100 anchoring thresholdPos() gives the metric-tile track, so a
// sparkline and a tile can never tell different stories about one number.
// Scaling to the data instead (what this did first) makes every line fill the
// panel whatever it holds: a 40ms LCP wobble and a 780ms INP collapse both
// draw as full-height swings, and because each panel then sits on its own
// invisible scale, four browsers side by side stop being comparable at all.
// Anchored to thresholds, height means SEVERITY — healthy metrics lie flat
// along the bottom, a regression visibly climbs past its poor rule — and
// thresholdPos()'s own clamp at 100 keeps an extreme outlier inside the
// viewBox instead of overflowing it.
// The good and poor boundaries as two dashed rules, which is exactly how the
// page 3 charts draw a threshold — same mark, same tokens, so the two pages
// teach one visual language instead of two.
// Filled good/NI/poor bands were the first attempt (the metric-tile track's
// own idiom) and they did not survive being scaled up: an .mt-zone is 8px of
// solid colour and IS the mark, whereas here the zones become three tall
// blocks behind a line. Weak enough not to shout, teal and amber were
// indistinguishable over the dark surface and the box read as "cool bottom,
// warm top"; strong enough to tell apart, they mixed to brown and maroon and
// became the loudest thing in the panel. Two hairlines carry the same
// information — where the boundaries fall — and leave the series on top.
function thresholdRules(plotTop, plotH) {
  const plotBottom = plotTop + plotH;
  return [[40, "good"], [70, "poor"]].map(([pct, name]) => {
    const y = (plotBottom - (pct / 100) * plotH).toFixed(2);
    return `<line class="bp-rule bp-rule-${name}" x1="0" y1="${y}" x2="100" y2="${y}" vector-effect="non-scaling-stroke"/>`;
  }).join("");
}
function sparklineSvg(values, metricKey, colorVar, dotVar, label) {
  const w = 100, h = 24, pad = 2;
  const plotH = h - pad * 2;
  const t = CWV_THRESHOLDS[metricKey];
  const rules = thresholdRules(pad, plotH);
  const empty = `<svg class="bp-spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" role="img" aria-label="${label || "Trend"}: not measured">${rules}</svg>`;
  const nums = (values || []).map((v) => (typeof v === "number" ? v : null));
  if (!t || nums.filter((v) => v != null).length < 2) return empty;
  const step = (w - pad * 2) / (nums.length - 1);
  const pts = nums.map((v, idx) => {
    const pos = v == null ? null : thresholdPos(v, t);
    if (pos == null) return null;
    // thresholdPos runs 0 (perfect) → 100 (twice the poor boundary); SVG y
    // grows downward, so it is inverted here to put "worse" nearer the top.
    return [pad + idx * step, h - pad - (pos / 100) * plotH];
  });
  const path = pts.filter(Boolean).map((p) => p.join(",")).join(" ");
  const last = pts[pts.length - 1];
  // vector-effect="non-scaling-stroke" is load-bearing, not decoration: this
  // svg's viewBox (100×24) gets stretched non-uniformly by preserveAspectRatio
  // ="none" to fill whatever box .bp-spark ends up — now a fairly tall one,
  // since bp-visits flexes to fill the panel's spare height (see the page 4
  // comment in <style>). Without it, stroke-width scales with that stretch
  // like everything else in the coordinate system, so the declared "2" was
  // rendering roughly 4px tall: louder than the LCP/INP/CLS verdict chips
  // underneath it, which are the actual point of the panel. With it, the
  // declared width is the final on-screen width regardless of how the box
  // is stretched — the same weight as the page 3 chart lines.
  // The stroke is a neutral series colour while the end dot takes the rating
  // accent: the verdict is the LATEST month's, but the line spans the whole
  // period, so colouring the whole stroke by it would claim every earlier
  // month shared that verdict. Callers that want one colour just omit dotVar.
  const dot = last ? `<circle cx="${last[0].toFixed(1)}" cy="${last[1].toFixed(1)}" r="1.5" style="fill:var(${dotVar || colorVar})"/>` : "";
  return `<svg class="bp-spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" role="img" aria-label="${label || "Metric"} trend against its thresholds">${rules}
    <polyline points="${path}" fill="none" style="stroke:var(${colorVar})" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>${dot}
  </svg>`;
}
// The rating drives three things that must never disagree — the chip's hue,
// its shape glyph and the sparkline's end dot — so all three read the accent
// off this one map rather than each deciding for itself.
const RATING_ACCENTS = { good: "--good", "needs-improvement": "--warning", poor: "--critical", none: "--text-subdued" };
const BP_MIN_VISITS = 10;
function latestMonth(p) { return (p.months || [])[(p.months || []).length - 1] || {}; }
function renderBrowserPerfPanels() {
  const d = DATA.browserPerf;
  const el = document.getElementById("browser-perf-grid");
  if (!el) return;
  // build-report.mjs pads panels to a fixed slot count with null entries
  // (see its comment) — that padding suited the old fixed table grid;
  // here a null slot would just be a blank dashed card that reads as a
  // broken render, so real panels are laid out and the rest of the grid
  // simply isn't drawn instead.
  const all = (d && d.panels ? d.panels : []).filter((p) => p !== null);
  // SKILL.md's long-tail rule: a combination with a handful of visits is a
  // sparkline drawn through noise and three "not measured" chips, which reads
  // as a broken panel rather than as a real finding. Drop them — but fall back
  // to the unfiltered set rather than emptying the page, since on a genuinely
  // low-traffic frontend every combination can sit under the floor.
  const viable = all.filter((p) => (latestMonth(p).visits || 0) >= BP_MIN_VISITS);
  const panels = viable.length ? viable : all;
  if (!panels.length) { el.innerHTML = `<p class="empty-note">No browser/device data for this period.</p>`; return; }
  el.innerHTML = panels.map((p) => {
    const latest = latestMonth(p);
    const rows = [["lcp", "LCP", fmtMsClient], ["inp", "INP", fmtMsClient], ["cls", "CLS", fmtCls]]
      .map(([key, label, fmt]) => {
        const rating = ratingFor(key, latest[key]);
        const series = (p.months || []).map((m) => m[key]);
        return `<div class="bp-metric">
          <span class="status" data-rating="${rating}">${RATING_SHAPES[rating]}${label} ${fmt(latest[key])}</span>
          ${sparklineSvg(series, key, "--rp-series-1", RATING_ACCENTS[rating], label)}
        </div>`;
      }).join("");
    // "Mar 2026" six times across a ~350px plot overruns; the year is already
    // on every page header, so the axis carries the month alone.
    const months = (p.months || []).map((m) => `<span>${String(m.label || "").replace(/\s+\d{4}$/, "")}</span>`).join("");
    return `<div class="browser-panel">
      <div class="bp-head">
        <div class="browser-panel-title">${p.label}</div>
        <div class="bp-visits"><b>${compactFmt(latest.visits)}</b> visits</div>
      </div>
      <div class="bp-metrics">${rows}</div>
      <div class="bp-months"><span class="bp-months-spacer"></span><div class="bp-months-axis">${months}</div></div>
    </div>`;
  }).join("");
}

function chip(label, value) {
  return `<div class="mini-chip"><div class="mini-chip-label">${label}</div><div class="mini-chip-value">${value}</div></div>`;
}
function miniStats(period, chipsHtml) {
  return `<div class="mini-period">${period}</div><div class="mini-chips">${chipsHtml}</div>`;
}
function renderExecMiniStats() {
  const tm = DATA.trafficMonthly;
  const cwv = DATA.cwvMonthly;
  const bp = DATA.browserPerf;
  if (!tm || !tm.labels.length) return;
  const i = tm.labels.length - 1;
  const period = tm.labels[i];

  const trafficEl = document.getElementById("mini-traffic");
  if (trafficEl) trafficEl.innerHTML = miniStats(period,
    chip("Sessions", compactFmt(tm.sessions[i])) +
    chip("Navigations", compactFmt(tm.pageLoads[i])) +
    chip("XHR Requests", compactFmt(tm.userActions[i]))
  );

  const cwvEl = document.getElementById("mini-cwv");
  if (cwvEl && cwv && cwv.labels.length) {
    cwvEl.innerHTML = miniStats(period,
      chip("LCP p75", fmtMsClient(cwv.lcp[i])) +
      chip("INP p75", fmtMsClient(cwv.inp[i])) +
      chip("CLS p75", fmtCls(cwv.cls[i]))
    );
  }

  const browserEl = document.getElementById("mini-browser");
  if (browserEl && bp && bp.panels) {
    const ranked = bp.panels.filter((p) => p !== null).map((p) => ({
      label: p.label.replace(/\s*[·•]\s*(desktop|mobile)/i, "").replace(/^Microsoft\s+/i, "").trim(),
      visits: (p.months.find((m) => m.label === period) || {}).visits || 0,
    })).sort((a, b) => b.visits - a.visits).slice(0, 3);
    browserEl.innerHTML = miniStats(period, ranked.map((r) => chip(r.label, r.visits > 0 ? compactFmt(r.visits) : "—")).join(""));
  }
}

function bootstrapChartDefaults(printing) {
  Chart.defaults.color = ctVar("axis-text", printing);
  Chart.defaults.borderColor = ctVar("grid", printing);
  Chart.defaults.font.family = cssVar("--dt-font-sans") || "sans-serif";
  Chart.defaults.font.size = 10;
  // Must finish synchronously: beforeprint has to leave the canvas in its
  // final state before Chrome captures the page, and Chart.js's default
  // animation runs across several requestAnimationFrame ticks — capture
  // could land mid-fade otherwise.
  Chart.defaults.animation = false;
}

// renderKpis/renderExecMiniStats/renderTrafficTable/renderCwvStatusRow/
// renderBrowserPerfPanels bake colour into plain HTML/SVG as a literal
// var(--rp-series-N) reference (see each function's own comment) — the
// cascade re-resolves those correctly on its own under @media print, with
// no "printing" flag and no re-render needed, so calling them again here
// is only ever about re-running the DOM diff cheaply, never about colour.
// bootstrapChartDefaults() and renderCwvWeeklyCharts() are the two
// functions that draw to a <canvas> and therefore DO need to be told which
// theme to bake in explicitly (see ctVar()'s comment for why beforeprint
// can't be asked instead) — printing=false at DOMContentLoaded and
// afterprint, printing=true at beforeprint.
// Same destroy-and-rebuild contract as the CWV weekly charts: a canvas bakes
// its colours in, so the print pass needs a fresh chart rather than a redraw.
let trafficWeeklyChart = null;
function renderTrafficWeeklyChart(printing) {
  const d = DATA.trafficWeekly;
  const panel = document.getElementById("panel-trafficWeekly");
  const el = document.getElementById("chart-trafficWeekly");
  if (!panel || !el) return;
  // A data directory captured before traffic-weekly.json existed still
  // renders — the page falls back to the monthly table alone.
  // Hiding the panel alone would leave its grid track holding empty space, so
  // the row collapses to a single column and the table reclaims the page.
  const row = panel.parentElement;
  const lede = document.querySelector('[data-page="2"] .lede');
  if (!d || !d.labels || !d.labels.length) {
    panel.style.display = "none";
    row.style.gridTemplateColumns = "minmax(0, 1fr)";
    if (lede) lede.textContent = "Sessions, navigations and XHR requests by month";
    return;
  }
  panel.style.display = "";
  row.style.gridTemplateColumns = "";
  forceOpaqueCanvases();
  if (trafficWeeklyChart) trafficWeeklyChart.destroy();
  const opts = baseChartOptions("sessions", printing);
  opts.scales.y.ticks.callback = (v) => compactFmt(v);
  trafficWeeklyChart = new Chart(el, {
    type: "line",
    data: { labels: d.labels, datasets: [{
      label: "Sessions", data: d.sessions,
      borderColor: ctVar("series-1", printing), backgroundColor: ctVar("series-1", printing),
      borderWidth: 2, pointRadius: 0, tension: .25, spanGaps: true,
    }] },
    options: opts,
  });
  document.getElementById("legend-trafficWeekly").innerHTML = legendHtml([{ label: "Sessions", swatch: "--rp-series-1" }]);
}

function renderAll(printing) {
  bootstrapChartDefaults(printing);
  renderKpis();
  renderExecMiniStats();
  renderTrafficTable();
  renderTrafficWeeklyChart(printing);
  renderCwvStatusRow();
  renderCwvWeeklyCharts(printing);
  renderBrowserPerfPanels();
}

// Theme: dark (default) or light. Set by the preview toggle (dtSetTheme), by a
// `#theme=light|dark` URL hash (render-pdf.sh), or carried in a saved copy's
// <html data-theme>. Print follows the active theme.
const isLight = () => document.documentElement.dataset.theme === "light";
window.dtSetTheme = (t) => {
  document.documentElement.dataset.theme = t === "light" ? "light" : "dark";
  renderAll(isLight());
  window.dispatchEvent(new CustomEvent("dt-theme", { detail: document.documentElement.dataset.theme }));
};
const hashTheme = /[#&]theme=(light|dark)/.exec(location.hash);
if (hashTheme) document.documentElement.dataset.theme = hashTheme[1];
document.addEventListener("DOMContentLoaded", () => renderAll(isLight()));
window.addEventListener("beforeprint", () => renderAll(isLight()));
window.addEventListener("afterprint", () => renderAll(isLight()));
</script>
</body>
</html>
