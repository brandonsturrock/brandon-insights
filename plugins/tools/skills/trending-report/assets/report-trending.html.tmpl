<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{REPORT_TITLE}}</title>
<!--
  CONTRACT for scripts/build-report.mjs (owned by another workstream).
  This file is the 4-PAGE "Trending" report layout (Executive Summary / Traffic / Core Web Vitals / Browser Performance).
  Its sibling report-cm.html.tmpl is the 4-page "Current Month" layout — pick ONE per render,
  they are two separate template files (not one file with a REPORT_TYPE switch).

  PLACEHOLDERS (plain string replace, each appears exactly once):
    {{REPORT_TITLE}}        - <title> text, e.g. "acme-shop — Trending Report"
    {{FRONTEND_NAME}}        - shown top-right of every page header
    {{ENVIRONMENT_NAME}}     - shown under frontend name; pass "" to omit (CSS :empty hides it)
    {{DATE_RANGE_LABEL}}     - shown top-center under "TRENDING" and under frontend name, e.g. "Jan – Jun 2026"
    {{FINDINGS_TRAFFIC_HTML}}  - pre-rendered HTML (glue script runs markdown -> HTML, e.g. via `marked`)
                                 for the "## Traffic" section of the analyst notes. "" hides the panel.
    {{FINDINGS_CWV_HTML}}      - same, for the "## Core Web Vitals" section.
    {{FINDINGS_BROWSER_HTML}}  - same, for the "## Browser" (Browser & Device) section.
    {{DATA_JSON}}            - a single JS object literal (valid JSON), assigned to `const DATA = {{DATA_JSON}};`
                               in the <script> block below. Contains ALL chart + KPI + table data, keyed
                               by chart id. Schema (all fields required unless noted; use [] / null for "no data"):

    DATA = {
      kpis: [                                   // rendered as the KPI tile row by this template's own JS
        { label: "Sessions", value: "1.2M", change: 4.3, color: "#7B61FF", lowerIsBetter: false },
        ...                                      // color = left accent bar; change is a percent, can be null;
      ],                                         // lowerIsBetter=true means a NEGATIVE change is the good/green case
                                                  // (use true for LCP/INP/CLS/error-rate style KPIs, false for
                                                  // traffic/session-count style KPIs)

      trafficMonthly: {                          // bar-in-cell table, page 2 (matches the live app's User Traffic panel)
        labels: ["Jan 2026", "Feb 2026", ...],    // one row per month
        sessions: [12000, 13500, ...],            // each column's bar width is relative to that column's own max
        userActions: [34000, 36000, ...],
        pageLoads: [15000, 15800, ...],
        pctDesktop: [62, 61, ...],                 // optional: renders a "Device Split" bar column (% desktop, filled bar)
      },

      cwvMonthly: {                               // bar-in-cell table, page 3 (LCP/INP/CLS columns, one row per month)
        labels: ["Jan 2026", "Feb 2026", ...],     // bars are colored per-point by good/warn/poor threshold
        lcp: [2200, 2600, ...],                    // ms
        inp: [180, 210, ...],                      // ms
        cls: [0.05, 0.09, ...],                     // unitless
      },

      cwvWeekly: {                                // line chart w/ dashed good/poor threshold lines, page 3
        labels: ["W1", "W2", ...],
        lcp: [2200, ...], inp: [180, ...], cls: [0.05, ...],
      },

      browserPerf: {                              // page 4: grid of bar-in-cell tables, one panel per browser×device.
        panels: [                                  // Selection policy (real apps can report 10+ browsers — showing
          {                                        // all of them doesn't fit the page and buries the ones that carry
            label: "Chrome · Desktop",             // real traffic): keep only the top N browser×device combos by
            months: [                              // total visits over the period. N defaults to 6, overridable via
              { label: "Jan 2026", visits: 12000, lcp: 2200, inp: 180, cls: 0.05 },
              ...                                   // one entry per month, same months/order as trafficMonthly.labels
            ],
          },
          ...                                       // build-report.mjs's `--max-browsers <N>` flag.
        ],
      },
    }

  The template's own <script> block (bottom of file) reads DATA on DOMContentLoaded and builds every
  Chart.js chart + the KPI tile row. Tables are not used on this layout. Markdown->HTML conversion for
  findings is the glue script's job (this template never runs a markdown parser) — vendor `marked` or
  equivalent there, since bundling it here would just duplicate the "no CDN at render time" goal Chart.js
  already solves.
-->
<script src="chart.umd.min.js"></script>
<style>
  /* DT Flow, Dynatrace's brand font, served from Dynatrace's own public CDN
     (same URL @dynatrace/strato-components' AppRoot.css loads it from) —
     requires network access at render time; falls back to system fonts if unreachable. */
  @font-face { font-family: DynatraceFlow; font-weight: 400; font-display: swap; src: url(https://dt-cdn.net/fonts/DTFlow-Regular-v1.2.1.woff2) format('woff2'); }
  @font-face { font-family: DynatraceFlow; font-weight: 500; font-display: swap; src: url(https://dt-cdn.net/fonts/DTFlow-Medium-v1.2.1.woff2) format('woff2'); }
  @font-face { font-family: DynatraceFlow; font-weight: 600; font-display: swap; src: url(https://dt-cdn.net/fonts/DTFlow-Semibold-v1.2.1.woff2) format('woff2'); }
  @font-face { font-family: DynatraceFlow; font-weight: 700; font-display: swap; src: url(https://dt-cdn.net/fonts/DTFlow-Heavy-v1.2.1.woff2) format('woff2'); }
  @page { size: A4 landscape; margin: 0; }
  * { box-sizing: border-box; }
  html, body {
    margin: 0; padding: 0; background: #0f1117; color: #eee;
    font-family: DynatraceFlow, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  }

  .page {
    width: 297mm; height: 210mm;
    padding: 10mm 12mm;
    background: #0f1117;
    color: #eee;
    display: flex;
    flex-direction: column;
    page-break-after: always;
    position: relative;
    overflow: hidden;
  }
  .page:last-child { page-break-after: auto; }

  /* texture / glow, purely decorative, matches the live app's PDF background */
  .page::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image: radial-gradient(circle, rgba(20,150,255,0.05) 1px, transparent 1px);
    background-size: 22px 22px;
  }

  .hdr { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6mm; position: relative; }
  .hdr-left { display: flex; align-items: center; gap: 10px; }
  .hdr-left .brand { display: flex; align-items: center; gap: 8px; }
  .hdr-left .brand svg { height: 18px; width: auto; color: #f4f6fb; flex-shrink: 0; }
  .hdr-left .brand-sep { font-size: 14px; color: rgba(255,255,255,0.25); font-weight: 300; margin: 0 2px; }
  .hdr-left .brand-sub { font-size: 11px; font-weight: 400; letter-spacing: 0.14em; color: #f4f6fb; text-transform: uppercase; white-space: nowrap; }
  .hdr-left .divider { width: 1px; height: 22px; background: rgba(255,255,255,0.15); }
  .hdr-center { position: absolute; left: 50%; transform: translateX(-50%); text-align: center; }
  .hdr-center .kind { font-size: 18px; font-weight: 700; letter-spacing: 0.24em; color: #fff; text-transform: uppercase; }
  .hdr-center .section { font-size: 11px; font-weight: 500; color: #b1b2d2; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 3px; }
  .hdr-right { text-align: right; }
  .hdr-right .name { font-size: 16px; font-weight: 700; color: #f4f6fb; }
  .hdr-right .env { font-size: 11px; color: #1496ff; margin-top: 2px; }
  .hdr-right .env:empty { display: none; }
  .hdr-right .range { font-size: 11px; color: #b1b2d2; margin-top: 2px; }

  .accent-line { height: 2px; border-radius: 1px; margin-bottom: 6mm; background: linear-gradient(90deg, #1496ff 0%, rgba(20,150,255,0.35) 45%, rgba(20,150,255,0) 100%); }

  .content { flex: 1; display: flex; flex-direction: column; gap: 4mm; min-height: 0; }

  /* ── KPI tiles ─────────────────────────────────────────────────────────── */
  .kpi-row { display: flex; gap: 12px; flex: 0 0 auto; }
  .kpi-tile {
    flex: 1; background: #1c1e2e; border: 1px solid rgba(20,150,255,0.16);
    border-radius: 10px; padding: 14px 16px 12px; border-top: 3px solid var(--kpi-color, #1496ff);
  }
  .kpi-label { font-size: 11px; font-weight: 700; color: #b1b2d2; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
  .kpi-value { font-size: 32px; font-weight: 700; color: #f4f6fb; line-height: 1; letter-spacing: -0.01em; }
  .kpi-change { font-size: 12px; font-weight: 600; margin-top: 8px; }
  .kpi-change.up { color: #2ECC85; }
  .kpi-change.down { color: #E8345A; }
  .kpi-change.neutral { color: #b1b2d2; }

  /* ── Executive Summary analysis cards ─────────────────────────────────── */
  .exec-grid {
    flex: 1; min-height: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .exec-card {
    background: #1c1e2e;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 16px 18px 14px;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
  }
  /* Colored top accent bar per section */
  .exec-card::before {
    content: "";
    position: absolute; top: 0; left: 0; right: 0; height: 3px;
    border-radius: 10px 10px 0 0;
  }
  .exec-card--traffic::before  { background: linear-gradient(90deg, #7B61FF, rgba(123,97,255,0.3)); }
  .exec-card--cwv::before      { background: linear-gradient(90deg, #F5A623, rgba(245,166,35,0.3)); }
  .exec-card--browser::before  { background: linear-gradient(90deg, #00A98F, rgba(0,169,143,0.3)); }

  .exec-section-label {
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em;
    margin-bottom: 12px; padding-top: 4px;
    display: flex; align-items: center; gap: 8px;
  }
  .exec-section-label::before {
    content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; flex: 0 0 auto;
  }
  .exec-card--traffic .exec-section-label { color: #a99aff; }
  .exec-card--cwv     .exec-section-label { color: #f7bf68; }
  .exec-card--browser .exec-section-label { color: #3dd9bc; }
  .exec-card--traffic .exec-section-label::before { background: #7B61FF; }
  .exec-card--cwv     .exec-section-label::before { background: #F5A623; }
  .exec-card--browser .exec-section-label::before { background: #00A98F; }

  .exec-card .findings-body {
    font-size: 13px; line-height: 1.6; color: #cdd0e8;
    flex: 1; min-height: 0; overflow: hidden;
  }
  .exec-card .findings-body ul { margin: 0; padding-left: 16px; }
  .exec-card .findings-body li { margin-bottom: 6px; }
  .exec-card .findings-body li:last-child { margin-bottom: 0; }
  .exec-card .findings-body p { margin: 0 0 6px; }

  /* Mini-stat chips pinned to the bottom of each exec card */
  .exec-mini-stats {
    flex: 0 0 auto;
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid rgba(255,255,255,0.07);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .exec-mini-period {
    font-size: 9px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.1em; color: #666e8c; white-space: nowrap;
  }
  .exec-mini-chips-row {
    display: flex; gap: 6px; align-items: stretch;
  }
  .exec-mini-chip {
    flex: 1; min-width: 0;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 6px;
    padding: 5px 8px;
    display: flex; flex-direction: column; gap: 2px; align-items: center; text-align: center;
  }
  .exec-mini-chip-label {
    font-size: 9px; color: #666e8c;
    text-transform: uppercase; letter-spacing: 0.07em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; width: 100%;
  }
  .exec-mini-chip-value {
    font-size: 15px; font-weight: 700; color: #f4f6fb; line-height: 1;
  }

  /* ── Detail page chart cards ───────────────────────────────────────────── */
  .chart-card {
    background: #1c1e2e; border: 1px solid rgba(20,150,255,0.16); border-radius: 10px;
    padding: 12px 14px 10px; position: relative; display: flex; flex-direction: column; min-height: 0;
  }
  .chart-card::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px; border-radius: 10px 10px 0 0;
    background: linear-gradient(90deg, rgba(20,150,255,0.5) 0%, transparent 60%);
  }
  .chart-title { font-size: 11px; font-weight: 700; color: #f4f6fb; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; margin-bottom: 8px; flex: 0 0 auto; }
  .chart-row { display: flex; gap: 12px; flex: 1; min-height: 0; }
  .chart-body { position: relative; flex: 1; min-height: 0; min-width: 0; }
  .chart-body canvas { width: 100% !important; height: 100% !important; }

  /* ── Flex bar chart — rows distribute evenly across full card height ─────
     Used for Traffic (page 2) and CWV (page 3) tables. Replaces the HTML
     <table> approach, which can't flex-grow <tr> elements to fill height. */
  .flex-bars-wrap { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .flex-bars { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .flex-bars-header {
    display: flex; align-items: center; flex: 0 0 auto;
    padding: 0 10px 6px; border-bottom: 1px solid rgba(255,255,255,0.07); margin-bottom: 2px;
  }
  .flex-bars-spacer { flex: 0 0 80px; }
  .flex-bars-col-hdr { flex: 1; font-size: 10px; font-weight: 700; color: #b1b2d2; text-transform: uppercase; letter-spacing: 0.06em; }
  .flex-bars-body { display: flex; flex-direction: column; flex: 1; min-height: 0; }
  .flex-bars-row { display: flex; align-items: center; flex: 1; min-height: 0; border-top: 1px solid rgba(255,255,255,0.05); }
  .flex-bars-row:first-child { border-top: none; }
  .flex-bars-row--current .flex-bars-row-label { color: #e8edf5; font-weight: 700; }
  .flex-bars-row--current .flex-bars-value { color: #f4f6fb; font-weight: 700; }
  .flex-bars-row--current .flex-bars-fill { filter: brightness(1.35); }
  .flex-bars-row-label { flex: 0 0 80px; padding: 0 10px; color: #b1b2d2; font-size: 11px; }
  .flex-bars-cell { flex: 1; display: flex; align-items: center; padding: 6px 10px; min-width: 0; border-left: 1px solid rgba(255,255,255,0.06); }
  .flex-bars-track { flex: 1; display: flex; align-items: center; min-width: 0; }
  .flex-bars-fill { height: 42px; border-radius: 3px; min-width: 2px; flex-shrink: 0; }
  .flex-bars-value { white-space: nowrap; font-size: 11px; color: #e8edf5; padding-left: 6px; }
  .flex-bars-device-cell { flex: 0 0 120px; padding: 4px 10px 4px 0; }
  .flex-bars-device-track { background: rgba(255,255,255,0.06); border-radius: 2px; }
  .flex-bars-device-fill {
    height: 24px; border-radius: 2px; background: #7B61FF;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 10px; font-weight: 700; min-width: 20px;
  }
  /* Compact variant: CWV page shares space with weekly chart */
  .flex-bars--compact .flex-bars-fill { height: 18px; }
  .flex-bars--compact .flex-bars-row-label { font-size: 10.5px; }
  .flex-bars--compact .flex-bars-value { font-size: 10.5px; }

  /* Bar-in-cell table — kept for browser performance panels only */
  .bar-table { width: 100%; height: 100%; border-collapse: collapse; font-size: 12px; }
  .bar-table th { text-align: left; font-size: 10px; font-weight: 700; color: #b1b2d2; text-transform: uppercase; letter-spacing: 0.06em; padding: 4px 10px 8px; }
  .bar-table td { padding: 5px 10px; vertical-align: middle; white-space: nowrap; }
  .bar-table .row-label { color: #b1b2d2; font-size: 12px; width: 1%; }
  .bar-cell { display: flex; align-items: center; gap: 8px; }
  .bar-track { flex: 1; min-width: 60px; }
  .bar-fill { height: 20px; border-radius: 3px; min-width: 2px; }
  .bar-value { color: #e8edf5; font-size: 11px; min-width: 42px; }

  /* Browser Performance: grid of small bar-tables, one per browser×device */
  .browser-perf-grid { flex: 1; min-height: 0; overflow: hidden; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 20px; }
  .browser-panel { border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 6px 10px; min-width: 0; display: flex; flex-direction: column; }
  .browser-panel .browser-panel-title {
    font-size: 9px; font-weight: 700; color: #b1b2d2;
    text-transform: uppercase; letter-spacing: 0.09em;
    margin-bottom: 5px; padding-bottom: 5px; flex: 0 0 auto;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .browser-panel .bar-table { table-layout: fixed; width: 100%; flex: 1; }
  .browser-panel .bar-table th { font-size: 9px; }
  .browser-panel .bar-table td, .browser-panel .bar-table th { padding: 1px 6px; border-right: 1px solid rgba(255,255,255,0.06); }
  .browser-panel .bar-table td:last-child, .browser-panel .bar-table th:last-child { border-right: none; }
  .browser-panel .bar-table tbody tr { border-top: 1px solid rgba(255,255,255,0.05); }
  .browser-panel .bar-table tbody tr:first-child { border-top: none; }
  .browser-panel .bar-table .row-label { width: 50px; font-size: 9.5px; }
  .browser-panel .bar-value { font-size: 9.5px; min-width: 30px; }
  .browser-panel .bar-track { min-width: 46px; }
  .browser-panel .bar-fill { height: 7px; }
  .browser-panel--empty { background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.04); }
  .browser-panel .bar-table tbody tr.current-month .row-label { color: #e8edf5; font-weight: 700; }
  .browser-panel .bar-table tbody tr.current-month .bar-value { color: #f4f6fb; font-weight: 700; }
  .browser-panel .bar-table tbody tr.current-month .bar-fill { filter: brightness(1.35); }

  .ftr { display: flex; align-items: center; justify-content: space-between; margin-top: 4mm; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.07); flex: 0 0 auto; }
  .ftr span { font-size: 9px; color: #666e8c; letter-spacing: 0.05em; }
  .ftr .brand-name { color: #1496ff; font-weight: 600; }
</style>
</head>
<body>

  <!-- ── Page 1: Executive Summary ────────────────────────────────────── -->
  <section class="page" data-page="1">
    <header class="hdr">
      <div class="hdr-left">
        <span class="brand"><!-- brand --></span>
      </div>
      <div class="hdr-center">
        <div class="kind">Trending</div>
        <div class="section">Executive Summary</div>
      </div>
      <div class="hdr-right">
        <div class="name">{{FRONTEND_NAME}}</div>
        <div class="env">{{ENVIRONMENT_NAME}}</div>
        <div class="range">{{DATE_RANGE_LABEL}}</div>
      </div>
    </header>
    <div class="accent-line"></div>
    <div class="content">
      <div class="kpi-row" id="kpi-row"></div>
      <div class="exec-grid">
        <div class="exec-card exec-card--traffic">
          <div class="exec-section-label">Traffic</div>
          <div class="findings-body">{{FINDINGS_TRAFFIC_HTML}}</div>
          <div class="exec-mini-stats" id="exec-mini-traffic"></div>
        </div>
        <div class="exec-card exec-card--cwv">
          <div class="exec-section-label">Core Web Vitals</div>
          <div class="findings-body">{{FINDINGS_CWV_HTML}}</div>
          <div class="exec-mini-stats" id="exec-mini-cwv"></div>
        </div>
        <div class="exec-card exec-card--browser">
          <div class="exec-section-label">Browser &amp; Device</div>
          <div class="findings-body">{{FINDINGS_BROWSER_HTML}}</div>
          <div class="exec-mini-stats" id="exec-mini-browser"></div>
        </div>
      </div>
    </div>
    <footer class="ftr">
      <span>CONFIDENTIAL · FOR CUSTOMER USE ONLY</span>
      <span>Page 1 of 4 · Powered by <span class="brand-name">Dynatrace</span></span>
    </footer>
  </section>

  <!-- ── Page 2: Traffic ─────────────────────────────────────────────── -->
  <section class="page" data-page="2">
    <header class="hdr">
      <div class="hdr-left">
        <span class="brand"><!-- brand --></span>
      </div>
      <div class="hdr-center">
        <div class="kind">Trending</div>
        <div class="section">Traffic</div>
      </div>
      <div class="hdr-right">
        <div class="name">{{FRONTEND_NAME}}</div>
        <div class="env">{{ENVIRONMENT_NAME}}</div>
        <div class="range">{{DATE_RANGE_LABEL}}</div>
      </div>
    </header>
    <div class="accent-line"></div>
    <div class="content">
      <div class="chart-card" style="flex: 1;">
        <div class="chart-title">User Traffic</div>
        <div class="flex-bars-wrap" id="table-trafficMonthly"></div>
      </div>
    </div>
    <footer class="ftr">
      <span>CONFIDENTIAL · FOR CUSTOMER USE ONLY</span>
      <span>Page 2 of 4 · Powered by <span class="brand-name">Dynatrace</span></span>
    </footer>
  </section>

  <!-- ── Page 3: Core Web Vitals ─────────────────────────────────────── -->
  <section class="page" data-page="3">
    <header class="hdr">
      <div class="hdr-left"><span class="brand"><!-- brand --></span></div>
      <div class="hdr-center">
        <div class="kind">Trending</div>
        <div class="section">Core Web Vitals</div>
      </div>
      <div class="hdr-right">
        <div class="name">{{FRONTEND_NAME}}</div>
        <div class="env">{{ENVIRONMENT_NAME}}</div>
        <div class="range">{{DATE_RANGE_LABEL}}</div>
      </div>
    </header>
    <div class="accent-line"></div>
    <div class="content">
      <div class="chart-card" style="flex: 1;">
        <div class="chart-title">Core Web Vitals - Monthly</div>
        <div class="flex-bars-wrap" id="table-cwvMonthly"></div>
      </div>
      <div class="chart-card" style="flex: 1;">
        <div class="chart-title">Core Web Vitals - Historical</div>
        <div class="chart-body"><canvas id="chart-cwvWeekly"></canvas></div>
      </div>
    </div>
    <footer class="ftr">
      <span>CONFIDENTIAL · FOR CUSTOMER USE ONLY</span>
      <span>Page 3 of 4 · Powered by <span class="brand-name">Dynatrace</span></span>
    </footer>
  </section>

  <!-- ── Page 4: Browser Performance ─────────────────────────────────── -->
  <section class="page" data-page="4">
    <header class="hdr">
      <div class="hdr-left"><span class="brand"><!-- brand --></span></div>
      <div class="hdr-center">
        <div class="kind">Trending</div>
        <div class="section">Browser Performance</div>
      </div>
      <div class="hdr-right">
        <div class="name">{{FRONTEND_NAME}}</div>
        <div class="env">{{ENVIRONMENT_NAME}}</div>
        <div class="range">{{DATE_RANGE_LABEL}}</div>
      </div>
    </header>
    <div class="accent-line"></div>
    <div class="content">
      <div class="chart-card" style="flex: 1; min-height: 0;">
        <div class="chart-title">Browser Performance</div>
        <div class="browser-perf-grid" id="browser-perf-grid"></div>
      </div>
    </div>
    <footer class="ftr">
      <span>CONFIDENTIAL · FOR CUSTOMER USE ONLY</span>
      <span>Page 4 of 4 · Powered by <span class="brand-name">Dynatrace</span></span>
    </footer>
  </section>

<script>
const DATA = {{DATA_JSON}};

// ── shared palette / helpers ──────────────────────────────────────────────
const SERIES_COLOR = { sessions: "#7B61FF", userActions: "#00A98F", pageLoads: "#1D8AB7", lcp: "#F5A623", inp: "#1496ff", cls: "#73be28" };
const STATUS_COLOR = { good: "#2ECC85", warn: "#F5A623", poor: "#E8345A" };
const THRESHOLDS = { lcp: { good: 2500, poor: 4000 }, inp: { good: 200, poor: 500 }, cls: { good: 0.1, poor: 0.25 } };
function statusColor(metric, value) {
  const t = THRESHOLDS[metric];
  if (value == null) return "#4a5568";
  if (value <= t.good) return STATUS_COLOR.good;
  if (value <= t.poor) return STATUS_COLOR.warn;
  return STATUS_COLOR.poor;
}
Chart.defaults.color = "#b1b2d2";
Chart.defaults.borderColor = "rgba(255,255,255,0.08)";
Chart.defaults.font.family = "DynatraceFlow, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif";
Chart.defaults.animation = false;
Chart.defaults.plugins.legend.labels.boxWidth = 10;
Chart.defaults.plugins.legend.labels.font = { size: 10 };

function renderKpis(kpis) {
  const row = document.getElementById("kpi-row");
  if (!row || !kpis) return;
  row.innerHTML = kpis.map(k => {
    const positive = k.change != null && (k.lowerIsBetter ? k.change < 0 : k.change > 0);
    const neutral = k.change == null || k.change === 0;
    const cls = neutral ? "neutral" : positive ? "up" : "down";
    const arrow = k.change == null ? "" : (k.change >= 0 ? "▲" : "▼");
    const changeHtml = k.change == null ? "" :
      `<div class="kpi-change ${cls}">${arrow} ${Math.abs(k.change).toFixed(1)}% vs prior month</div>`;
    return `<div class="kpi-tile" style="--kpi-color:${k.color}">
      <div class="kpi-label">${k.label}</div>
      <div class="kpi-value">${k.value}</div>
      ${changeHtml}
    </div>`;
  }).join("");
}

// ── bar-in-cell table renderer ────────────────────────────────────────────
function compactFmt(n) {
  if (n == null || Number.isNaN(n)) return "—";
  if (Math.abs(n) >= 1e6) return (n / 1e6).toFixed(1) + "M";
  if (Math.abs(n) >= 1e3) return (n / 1e3).toFixed(1) + "k";
  return Math.round(n).toString();
}

function flexBarsHtml(rows, columns, compact) {
  const compactClass = compact ? " flex-bars--compact" : "";
  const maxByCol = {};
  columns.forEach(c => {
    maxByCol[c.key] = Math.max(0, ...rows.map(r => (typeof r.values[c.key] === "number" ? r.values[c.key] : 0)));
  });
  const header = `<div class="flex-bars-header">
    <div class="flex-bars-spacer"></div>
    ${columns.map(c => `<div class="flex-bars-col-hdr">${c.label}</div>`).join("")}
  </div>`;
  const body = rows.map((r, ri) => {
    const isCurrent = ri === rows.length - 1;
    const cells = columns.map(c => {
      if (c.key === "__device") {
        const pct = r.values.__device;
        if (pct == null) return `<div class="flex-bars-cell"><div class="flex-bars-track"><span class="flex-bars-value">—</span></div></div>`;
        return `<div class="flex-bars-cell"><div class="flex-bars-track"><div class="flex-bars-fill" style="width:${Math.max(pct * 0.72, 2)}%;background:#7B61FF"></div><span class="flex-bars-value">${Math.round(pct)}%</span></div></div>`;
      }
      const v = r.values[c.key];
      if (v == null) return `<div class="flex-bars-cell"><div class="flex-bars-track"><span class="flex-bars-value">—</span></div></div>`;
      const max = maxByCol[c.key];
      const pct = max > 0 ? Math.max(2, (v / max) * 72) : 0;
      const color = c.metric ? statusColor(c.metric, v) : c.color;
      const text = c.format ? c.format(v) : v;
      return `<div class="flex-bars-cell"><div class="flex-bars-track"><div class="flex-bars-fill" style="width:${pct}%;background:${color}"></div><span class="flex-bars-value">${text}</span></div></div>`;
    }).join("");
    return `<div class="flex-bars-row${isCurrent ? " flex-bars-row--current" : ""}"><div class="flex-bars-row-label">${r.label}</div>${cells}</div>`;
  }).join("");
  return `<div class="flex-bars${compactClass}">${header}<div class="flex-bars-body">${body}</div></div>`;
}
function fmtMsClient(ms) {
  if (ms == null || Number.isNaN(ms)) return "—";
  return ms >= 1000 ? (ms / 1000).toFixed(1) + "s" : Math.round(ms) + "ms";
}
function barTableHtml(rows, columns) {
  const maxByCol = {};
  columns.forEach((c) => {
    maxByCol[c.key] = Math.max(0, ...rows.map((r) => (typeof r.values[c.key] === "number" ? r.values[c.key] : 0)));
  });
  const head = `<tr><th></th>${columns.map((c) => `<th>${c.label}</th>`).join("")}</tr>`;
  const body = rows
    .map((r, ri) => {
      const cells = columns
        .map((c) => {
          const v = r.values[c.key];
          if (v == null) return `<td>—</td>`;
          const max = maxByCol[c.key];
          const pct = max > 0 ? Math.max(2, (v / max) * 100) : 0;
          const color = c.metric ? statusColor(c.metric, v) : c.color;
          const text = c.format ? c.format(v) : v;
          return `<td><div class="bar-cell"><div class="bar-track"><div class="bar-fill" style="width:${pct}%;background:${color}"></div></div><span class="bar-value">${text}</span></div></td>`;
        })
        .join("");
      const isCur = ri === rows.length - 1;
      return `<tr${isCur ? ` class="current-month"` : ""}><td class="row-label">${r.label}</td>${cells}</tr>`;
    })
    .join("");
  return `<table class="bar-table"><thead>${head}</thead><tbody>${body}</tbody></table>`;
}

function renderTrafficTable() {
  const d = DATA.trafficMonthly;
  const el = document.getElementById("table-trafficMonthly");
  if (!d || !el) return;
  const rows = d.labels.map((label, i) => ({
    label,
    values: {
      sessions: d.sessions[i],
      userActions: d.userActions[i],
      pageLoads: d.pageLoads[i],
      ...(d.pctDesktop ? { __device: d.pctDesktop[i] } : {}),
    },
  }));
  const columns = [
    { key: "sessions", label: "Sessions", color: SERIES_COLOR.sessions, format: compactFmt },
    { key: "userActions", label: "XHR Requests", color: SERIES_COLOR.userActions, format: compactFmt },
    { key: "pageLoads", label: "Navigations", color: SERIES_COLOR.pageLoads, format: compactFmt },
    ...(d.pctDesktop ? [{ key: "__device", label: "Device" }] : []),
  ];
  el.innerHTML = flexBarsHtml(rows, columns, false);
}

function renderCwvTable() {
  const d = DATA.cwvMonthly;
  const el = document.getElementById("table-cwvMonthly");
  if (!d || !el) return;
  const rows = d.labels.map((label, i) => ({ label, values: { lcp: d.lcp[i], inp: d.inp[i], cls: d.cls[i] } }));
  const columns = [
    { key: "lcp", label: "LCP p75", metric: "lcp", format: fmtMsClient },
    { key: "inp", label: "INP p75", metric: "inp", format: fmtMsClient },
    { key: "cls", label: "CLS p75", metric: "cls", format: (v) => v.toFixed(2) },
  ];
  el.innerHTML = flexBarsHtml(rows, columns, true);
}

function renderCwvWeekly() {
  const d = DATA.cwvWeekly;
  const el = document.getElementById("chart-cwvWeekly");
  if (!d || !el) return;
  new Chart(el, {
    type: "line",
    data: {
      labels: d.labels,
      datasets: [
        { label: "LCP (ms)", data: d.lcp, borderColor: SERIES_COLOR.lcp, backgroundColor: SERIES_COLOR.lcp, yAxisID: "ms", tension: 0.35, pointRadius: 0 },
        { label: "INP (ms)", data: d.inp, borderColor: SERIES_COLOR.inp, backgroundColor: SERIES_COLOR.inp, yAxisID: "ms", tension: 0.35, pointRadius: 0 },
        { label: "CLS", data: d.cls, borderColor: SERIES_COLOR.cls, backgroundColor: SERIES_COLOR.cls, yAxisID: "cls", tension: 0.35, pointRadius: 0 },
      ],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      scales: {
        ms: { type: "linear", position: "left", title: { display: true, text: "ms" } },
        cls: { type: "linear", position: "right", grid: { drawOnChartArea: false }, title: { display: true, text: "CLS" } },
      },
    },
  });
}

function renderBrowserPerfPanels() {
  const d = DATA.browserPerf;
  const el = document.getElementById("browser-perf-grid");
  if (!d || !el || !d.panels) return;
  const columns = [
    { key: "visits", label: "Visits", color: SERIES_COLOR.sessions, format: compactFmt },
    { key: "lcp", label: "LCP", metric: "lcp", format: fmtMsClient },
    { key: "inp", label: "INP", metric: "inp", format: fmtMsClient },
    { key: "cls", label: "CLS", metric: "cls", format: (v) => v.toFixed(2) },
  ];
  el.innerHTML = d.panels
    .map((p) => {
      if (p === null) return `<div class="browser-panel browser-panel--empty"></div>`;
      const rows = p.months.map((m) => ({ label: m.label, values: { visits: m.visits, lcp: m.lcp, inp: m.inp, cls: m.cls } }));
      return `<div class="browser-panel"><div class="browser-panel-title">${p.label}</div>${barTableHtml(rows, columns)}</div>`;
    })
    .join("");
}

function chip(label, value, color) {
  const valStyle = color ? ` style="color:${color}"` : "";
  return `<div class="exec-mini-chip"><div class="exec-mini-chip-label">${label}</div><div class="exec-mini-chip-value"${valStyle}>${value}</div></div>`;
}

function chipsRow(chips) {
  return `<div class="exec-mini-chips-row">${chips}</div>`;
}

function renderExecMiniStats() {
  const tm = DATA.trafficMonthly;
  const cwv = DATA.cwvMonthly;
  const bp = DATA.browserPerf;
  if (!tm || !tm.labels.length) return;
  const i = tm.labels.length - 1;
  const period = `<span class="exec-mini-period">${tm.labels[i]}</span>`;

  const trafficEl = document.getElementById("exec-mini-traffic");
  if (trafficEl) trafficEl.innerHTML = period + chipsRow(
    chip("Sessions", compactFmt(tm.sessions[i]), "#a99aff") +
    chip("XHR Requests", compactFmt(tm.userActions[i]), "#3dd9bc") +
    chip("Navigations", compactFmt(tm.pageLoads[i]), "#4db8e8")
  );

  const cwvEl = document.getElementById("exec-mini-cwv");
  if (cwvEl && cwv) {
    const lcp = cwv.lcp[i], inp = cwv.inp[i], cls = cwv.cls[i];
    cwvEl.innerHTML = period + chipsRow(
      chip("LCP p75", fmtMsClient(lcp), statusColor("lcp", lcp)) +
      chip("INP p75", fmtMsClient(inp), statusColor("inp", inp)) +
      chip("CLS p75", cls != null ? cls.toFixed(2) : "—", statusColor("cls", cls))
    );
  }

  const browserEl = document.getElementById("exec-mini-browser");
  if (browserEl && bp && bp.panels) {
    const latestLabel = tm.labels[i];
    const ranked = bp.panels
      .filter(p => p !== null)
      .map(p => ({
        label: p.label.replace(/\s*[·•]\s*(desktop|mobile)/i, "").trim(),
        visits: (p.months.find(m => m.label === latestLabel) || {}).visits || 0,
      }))
      .sort((a, b) => b.visits - a.visits)
      .slice(0, 3);
    browserEl.innerHTML = period + chipsRow(ranked.map(r =>
      `<div class="exec-mini-chip"><div class="exec-mini-chip-label" style="font-size:8px">${r.label}</div><div class="exec-mini-chip-value" style="font-size:13px">${r.visits > 0 ? compactFmt(r.visits) : "—"}</div></div>`
    ).join(""));
  }
}

