fetch user.sessions, from: (now()-1M)@M, to: now()@M
| filter in("{{.frontend}}", frontend.name)
| filter dt.rum.user_type == "real_user"
| filterOut isNull(device.type)
| summarize
    total_sessions = count(),
    js_error_sessions = countIf(error.exception_count > 0),
    req_error_sessions = countIf(error.http_5xx_count + error.http_4xx_count + error.csp_violation_count > 0),
  by: { day = bin(start_time, 1d), device.type }
| sort day asc
