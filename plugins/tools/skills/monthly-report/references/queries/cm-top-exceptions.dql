fetch user.events, from: (now()-1M)@M, to: now()@M
| filter frontend.name == "{{.frontend}}"
| filter dt.rum.user_type == "real_user"
| filter characteristics.has_exception == true
| filterOut isNull(exception.type)
| summarize count = sum(dt.system.sampling_ratio), by: {exception.type, exception.message, error.source}
| sort count desc
| limit 10
