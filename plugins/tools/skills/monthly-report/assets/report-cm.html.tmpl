<script>
const DATA = {{DATA_JSON}};

// ── shared helpers ──────────────────────────────────────────────────────
// Chart colours are never hard-coded: every one is resolved off the --ct-*
// tokens (see the <style> block's "Chart colours across the theme swap"
// comment for why those exist as screen/print PAIRS rather than one token
// the cascade flips). Two things had to be true for the PDF to carry the
// right colours, not the two-line probe fix alone:
//
//  1. Resolve colour-mix() down to rgb() before Canvas sees it (the probe).
//  2. Pick the palette explicitly — `beforeprint` fires before print media
//     actually applies (measured: matchMedia("print").matches is false
//     inside the handler), so asking getComputedStyle() "which theme am I
//     in" inside that handler returns the screen answer regardless of what
//     is about to be captured. ctVar's second argument is the fix: the
//     caller states which palette it wants instead of the cascade being
//     asked to know something it does not know yet.
const _cssVarProbe = document.createElement("span");
_cssVarProbe.style.display = "none";
document.body.appendChild(_cssVarProbe);
function ctVar(name, printing) {
  _cssVarProbe.style.color = `var(--ct-${name}${printing ? "-print" : ""})`;
  return getComputedStyle(_cssVarProbe).color;
}
function fmtMs(ms) { return ms == null ? "—" : ms >= 1000 ? (ms / 1000).toFixed(1) + "s" : Math.round(ms) + "ms"; }
function fmtCls(v) { return v == null ? "—" : v.toFixed(3); }
function esc(s) { return s == null ? "" : String(s).replace(/[&<>]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c])); }

const THRESHOLDS = { lcp: { good: 2500, poor: 4000 }, inp: { good: 200, poor: 500 }, cls: { good: 0.1, poor: 0.25 } };
const msRating = (v, t) => v == null ? "none" : v <= t.good ? "good" : v <= t.poor ? "needs-improvement" : "poor";

// Strato's status vocabulary is shape-first: an ideal state is a circle with a
// check, a warning is a triangle with an exclamation, a critical state is a
// diamond with an X. Reproduced as inline SVG (ported verbatim from
// full-page-analysis/assets/report.html.tmpl's RATING_SHAPES) because this
// report ships as one standalone file with no Strato runtime to import icons
// from — the shapes and the semantics are Strato's, the delivery is not.
const RATING_SHAPES = {
  good:
    `<svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">` +
    `<circle cx="6" cy="6" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/>` +
    `<path d="M3.5 6.2 5.2 7.9 8.6 4.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  "needs-improvement":
    `<svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">` +
    `<path d="M6 1.1 11.4 10.6H0.6Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>` +
    `<path d="M6 4.5v2.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>` +
    `<circle cx="6" cy="8.9" r=".85" fill="currentColor"/></svg>`,
  poor:
    `<svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">` +
    `<path d="M6 .9 11.1 6 6 11.1.9 6Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>` +
    `<path d="M4.3 4.3 7.7 7.7M7.7 4.3 4.3 7.7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  none:
    `<svg width="11" height="11" viewBox="0 0 12 12" aria-hidden="true">` +
    `<circle cx="6" cy="6" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5"/>` +
    `<path d="M3.2 8.8 8.8 3.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
};
const RATING_WORDS = { good: "Good", "needs-improvement": "Needs work", poor: "Poor", none: "Not measured" };

// Position a value on its metric's own threshold scale, as a percentage of the
// track: 0 -> 0%, good -> 40%, poor -> 70%, twice the poor boundary -> 100%.
// Ported verbatim (thresholdPos) from the same reference file.
function thresholdPos(value, t) {
  if (!(t.good > 0) || !(t.poor > t.good)) return null;
  const v = Math.max(0, value);
  if (v <= t.good) return 40 * (v / t.good);
  if (v <= t.poor) return 40 + 30 * ((v - t.good) / (t.poor - t.good));
  return Math.min(100, 70 + 30 * ((v - t.poor) / t.poor));
}

// Populate empty findings cards with a fallback message so an editable panel
// never renders as a blank, easy-to-miss box.
document.querySelectorAll(".notes-body").forEach(el => {
  if (!el.textContent.trim()) el.innerHTML = '<span class="empty-note">No notable changes.</span>';
});

function renderKpis(kpis) {
  const row = document.getElementById("kpi-row");
  if (!row || !kpis) return;
  row.innerHTML = kpis.map(k => {
    const positive = k.change != null && (k.lowerIsBetter ? k.change < 0 : k.change > 0);
    const neutral = k.change == null || k.change === 0;
    const cls = neutral ? "neutral" : positive ? "good" : "bad";
    const arrow = k.change == null ? "" : (k.change >= 0 ? "▲" : "▼");
    const changeHtml = k.change == null ? "" :
      `<div class="kpi-change ${cls}">${arrow} ${Math.abs(k.change).toFixed(1)}% vs prior month</div>`;
    return `<div class="kpi-tile">
      <div class="kpi-label">${esc(k.label)}</div>
      <div class="kpi-value">${esc(k.value)}</div>
      ${changeHtml}
    </div>`;
  }).join("");
}

// `c.num` right-aligns + shrinks a column to its content (deck-base's
// `.rp-table .num { width: 1% }`) — correct for a plain figure, but a
// bar-in-cell wants real width to show proportion between rows, so a bar
// column also carries `c.barCol`, which the report-specific `.bar-col` rule
// (see <style>) overrides back to `width: auto`. Without it every "num" bar
// column collapses to ~44px (the bar-track's own min-width) regardless of
// data, which is why a 40,200 vs. 31,200 split originally read as two nearly
// identical bars — the column was too narrow for the percentage difference
// to show as more than a couple of pixels.
function renderTable(elId, columns, rows) {
  const el = document.getElementById(elId);
  if (!el || !rows) return;
  const cellClass = c => [c.num && "num", c.barCol && "bar-col", c.cellClass].filter(Boolean).join(" ");
  const thead = "<thead><tr>" + columns.map(c => `<th class="${cellClass(c)}">${c.label}</th>`).join("") + "</tr></thead>";
  const tbody = "<tbody>" + rows.map(r => "<tr>" + columns.map(c => {
    const raw = r[c.key];
    const val = c.render ? c.render(raw, r) : esc(raw ?? "—");
    return `<td class="${cellClass(c)}">${val}</td>`;
  }).join("") + "</tr>").join("") + "</tbody>";
  el.innerHTML = thead + tbody;
}

// Same column-config shape as renderTable, built as `.flex-bars` markup
// instead of a <table> — for the one panel on a fixed-height page that owns
// the whole page (Top Pages, page 4), where a <tr> sized to its own content
// leaves the panel's spare height as dead space below the last row instead
// of the rows growing to fill it. The first column is always the row label.
function renderFlexBars(elId, columns, rows) {
  const el = document.getElementById(elId);
  if (!el || !rows) return;
  const [labelCol, ...cellCols] = columns;
  const header = `<div class="flex-bars-header"><div class="flex-bars-spacer"></div>` +
    cellCols.map(c => `<div class="flex-bars-col-hdr${c.num ? " num" : ""}">${esc(c.label)}</div>`).join("") +
    `</div>`;
  const body = `<div class="flex-bars-body">` + rows.map(r => {
    const labelRaw = r[labelCol.key];
    const labelVal = labelCol.render ? labelCol.render(labelRaw, r) : esc(labelRaw ?? "—");
    const cells = cellCols.map(c => {
      const raw = r[c.key];
      const val = c.render ? c.render(raw, r) : esc(raw ?? "—");
      return `<div class="flex-bars-cell${c.num ? " num" : ""}">${val}</div>`;
    }).join("");
    return `<div class="flex-bars-row"><div class="flex-bars-row-label">${labelVal}</div>${cells}</div>`;
  }).join("") + `</div>`;
  el.innerHTML = header + body;
}

// Bar-in-cell: the figure is always printed beside the bar, so the bar shows
// shape within a column while the number carries the value. `rating`, when
// given, sets --bar-accent from the status vocabulary instead of the neutral
// default ink. The outlined track (deck-base's thin 9px bar with a border,
// vs. the plain 18px solid fill) reads as a measurement next to a number
// rather than a heavy block of ink — the difference matters most in the
// light print theme, where a full-height solid fill at these column widths
// was the one thing on the page that looked like a UI screenshot rather
// than a printed table.
function barCell(value, max, fmtFn, rating) {
  const v = value ?? 0;
  const pct = max > 0 ? Math.max(2, Math.round((v / max) * 100)) : 0;
  const accent = rating ? ` --bar-accent:var(${rating === "good" ? "--good" : rating === "needs-improvement" ? "--warning" : "--critical"});` : "";
  return `<div class="bar-cell"><div class="bar-track outlined"><div class="bar-fill" style="width:${pct}%;${accent}"></div></div><span class="bar-value">${fmtFn(v)}</span></div>`;
}

// Plain-text threshold grade for a table cell — see the .grade[data-rating]
// comment in <style> for why this is a coloured figure rather than a chip.
function gradeCell(value, metric, fmtFn) {
  const rating = msRating(value, THRESHOLDS[metric]);
  return `<span class="grade" data-rating="${rating}">${value == null ? "—" : fmtFn(value)}</span>`;
}

function metricTile(label, name, key, dist, tier) {
  const t = THRESHOLDS[key];
  const fmtFn = key === "cls" ? fmtCls : fmtMs;
  const p75 = dist ? dist.p75 : null;
  const rating = msRating(p75, t);
  const pos = p75 == null ? null : thresholdPos(p75, t);
  const mark = pos == null ? "" :
    `<span class="mt-mark mt-mark-p75" style="left:${pos.toFixed(2)}%" title="${esc("p75 " + fmtFn(p75))}"></span>`;
  const tail = tier
    ? `<div class="mt-tail"><span>Good <b>${tier.good}%</b></span><span>NI <b>${tier.ni}%</b></span><span>Poor <b>${tier.poor}%</b></span></div>`
    : "";
  return `<article class="metric-tile" data-rating="${rating}">` +
    `<div class="mt-head"><span class="mt-abbr">${esc(label)}</span>` +
      `<span class="status" data-rating="${rating}">${RATING_SHAPES[rating]}${esc(RATING_WORDS[rating])}</span></div>` +
    `<div class="mt-name">${esc(name)}</div>` +
    `<div class="mt-value">${p75 == null ? "—" : fmtFn(p75)}<span class="mt-value-tag">p75</span></div>` +
    `<div class="mt-scale"><div class="mt-track">` +
      `<span class="mt-zone mt-zone-good"></span><span class="mt-zone mt-zone-ni"></span><span class="mt-zone mt-zone-poor"></span>` +
    `</div>${mark}</div>` +
    `<div class="mt-bounds"><span>good ≤ ${esc(fmtFn(t.good))}</span><span>poor &gt; ${esc(fmtFn(t.poor))}</span></div>` +
    tail +
    `</article>`;
}

function renderMetricGrid() {
  const el = document.getElementById("metric-grid");
  const dist = DATA.cmCwvDistribution, tier = DATA.cmCwvTier;
  if (!el || !dist) return;
  el.innerHTML = [
    metricTile("LCP", "Largest contentful paint", "lcp", dist.lcp, tier && tier.lcp),
    metricTile("INP", "Interaction to next paint", "inp", dist.inp, tier && tier.inp),
    metricTile("CLS", "Cumulative layout shift", "cls", dist.cls, tier && tier.cls),
  ].join("");
}

function renderDeviceCompareTable() {
  const rows = DATA.deviceCompareRows || [];
  const maxSessions = Math.max(1, ...rows.map(r => r.sessions || 0));
  const maxLoads = Math.max(1, ...rows.map(r => r.pageLoads || 0));
  renderTable("table-deviceCompare", [
    { key: "deviceType", label: "Device", render: v => `<span class="lead">${esc(v)}</span>` },
    { key: "sessions", label: "Sessions", num: true, barCol: true, render: v => barCell(v, maxSessions, x => x.toLocaleString()) },
    { key: "pageLoads", label: "Page Loads", num: true, barCol: true, render: v => barCell(v, maxLoads, x => x.toLocaleString()) },
    { key: "lcpP75", label: "LCP p75", num: true, render: v => gradeCell(v, "lcp", fmtMs) },
    { key: "inpP75", label: "INP p75", num: true, render: v => gradeCell(v, "inp", fmtMs) },
    { key: "clsP75", label: "CLS p75", num: true, render: v => gradeCell(v, "cls", fmtCls) },
  ], rows);
}

function renderTopPagesTable() {
  const rows = DATA.topPagesRows || [];
  const maxVisits = Math.max(1, ...rows.map(r => r.count || 0));
  const maxExceptions = Math.max(1, ...rows.map(r => r.exceptions || 0));
  const maxReqErrors = Math.max(1, ...rows.map(r => r.requestErrors || 0));
  renderFlexBars("table-topPages", [
    { key: "name", label: "Page", render: v => `<span class="path">${esc(v)}</span>` },
    { key: "count", label: "Visits", num: true, barCol: true, render: v => barCell(v, maxVisits, x => x.toLocaleString()) },
    { key: "lcp", label: "LCP", num: true, render: v => gradeCell(v, "lcp", fmtMs) },
    { key: "inp", label: "INP", num: true, render: v => gradeCell(v, "inp", fmtMs) },
    { key: "cls", label: "CLS", num: true, render: v => gradeCell(v, "cls", fmtCls) },
    { key: "exceptions", label: "Exceptions", num: true, barCol: true, render: v => barCell(v, maxExceptions, x => x.toLocaleString()) },
    { key: "requestErrors", label: "Req. Errors", num: true, barCol: true, render: v => barCell(v, maxReqErrors, x => x.toLocaleString()) },
  ], rows);
}

function renderTopExceptionsTable() {
  const rows = (DATA.topExceptionRows || []).slice(0, 5);
  const max = Math.max(1, ...rows.map(r => r.count || 0));
  renderTable("table-topExceptions", [
    { key: "count", label: "#", num: true, barCol: true, render: v => barCell(v, max, x => x.toLocaleString()) },
    { key: "type", label: "Type" },
    // Clipped to one line (see .rp-table td.msg) rather than sized for the
    // wrap case: an exception message is open-ended text with no natural
    // length limit, so a row height that "fits the longest message" has no
    // stable answer, and this and the Top Request Errors table sit side by
    // side and must land on the same row height.
    { key: "message", label: "Message", cellClass: "msg" },
    { key: "source", label: "Source", render: v => `<span class="path">${esc(v ?? "—")}</span>` },
  ], rows);
}

function renderTopRequestErrorsTable() {
  const rows = (DATA.topRequestErrorRows || []).slice(0, 5);
  const max = Math.max(1, ...rows.map(r => r.count || 0));
  const statusRating = code => code == null ? "none" : code >= 500 ? "poor" : code >= 400 ? "needs-improvement" : "good";
  renderTable("table-topRequestErrors", [
    { key: "count", label: "#", num: true, barCol: true, render: v => barCell(v, max, x => x.toLocaleString()) },
    { key: "method", label: "Method", render: v => `<span class="chip">${esc(v ?? "—")}</span>` },
    { key: "status", label: "Status", render: v => `<span class="grade" data-rating="${statusRating(v)}">${v ?? "—"}</span>` },
    { key: "path", label: "Path", render: (v, r) => `<span class="path">${esc((r.host || "") + (v || ""))}</span>` },
  ], rows);
}

// Fold an error-type series set to its top 5 by total volume + "Other", so the
// stacked bar never grows an unbounded legend. --rp-series-6 is reserved for
// "Other" regardless of how many real types survive the fold.
function foldErrorTypes(byType, labelCount) {
  const totals = Object.entries(byType || {}).map(([type, arr]) => [type, (arr || []).reduce((a, b) => a + (b || 0), 0)]);
  totals.sort((a, b) => b[1] - a[1]);
  const top = totals.slice(0, 5).map(([t]) => t);
  const rest = totals.slice(5).map(([t]) => t);
  const folded = {};
  top.forEach(t => { folded[t] = byType[t]; });
  if (rest.length) {
    folded["Other"] = Array.from({ length: labelCount }, (_, i) => rest.reduce((s, t) => s + (byType[t][i] || 0), 0));
  }
  return folded;
}

// ── chart builders ────────────────────────────────────────────────────────
// Every chart instance created this pass is tracked so buildEverything() can
// destroy and recreate them on `beforeprint`/`afterprint` — see the ctVar()
// comment above and the fuller rationale in <style>. PRINTING is the flag
// every renderer's ctVar() calls read; buildEverything() is the only place
// that sets it, right before rebuilding, so no renderer has to be called
// with a parameter it would just forward.
let charts = [];
let PRINTING = false;

// Chrome exports every <canvas> into the PDF as a vector transparency-group
// form XObject. Poppler (pdftoppm — every render check earlier in this
// file's history) composites that correctly; Apple's CoreGraphics (Preview,
// `sips`, Quick Look) does not — it leaves the group fully transparent
// (alpha 0) and paints transparent as white, and it places the hole by the
// group's bounding box rather than by what visually overlaps it, so it can
// land over a neighbouring masthead corner as easily as over the chart
// itself. Forcing an opaque backing store before Chart.js ever calls its own
// getContext("2d") removes the transparency group entirely — a canvas's
// rendering context is fixed for its lifetime, so Chart.js's later call
// just gets this same cached context back, for every chart, including ones
// destroyed and rebuilt later.
document.querySelectorAll("canvas").forEach(c => c.getContext("2d", { alpha: false }));

// An opaque context defaults to BLACK, not transparent, so something has to
// paint the panel colour under the data on every frame — a plugin's
// beforeDraw, not a one-off paint after the initial build, because Chart.js's
// own resize/redraw passes repaint the canvas and would paint back over a
// one-off fill. Plain source-over (the default): there is no transparent
// area left on an opaque backing for destination-over to land in, and it
// measured out to a fully black canvas when tried. The fill reads PRINTING
// the same way every other chart colour does — not getComputedStyle() at
// draw time, which would hit the exact beforeprint theme-timing trap ctVar()
// exists to avoid and paint a dark panel fill onto light print paper.
Chart.register({
  id: "opaqueBacking",
  beforeDraw(c) {
    const x = c.ctx;
    x.save();
    x.globalCompositeOperation = "source-over";
    x.fillStyle = ctVar("panel-bg", PRINTING);
    x.fillRect(0, 0, c.width, c.height);
    x.restore();
  },
});

function mkChart(el, config) {
  if (!el) return;
  const c = new Chart(el, config);
  charts.push(c);
  return c;
}

function applyChartDefaults() {
  Chart.defaults.color = ctVar("axis-text", PRINTING);
  Chart.defaults.borderColor = ctVar("grid", PRINTING);
  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;
  Chart.defaults.font.size = 10;
  // Must stay false: buildEverything() runs inside the beforeprint handler
  // and has to finish synchronously, before Chrome captures the page — an
  // animated chart would still be mid-transition (or not yet drawn at all)
  // at capture time.
  Chart.defaults.animation = false;
  Chart.defaults.plugins.legend.labels.boxWidth = 10;
  Chart.defaults.plugins.legend.labels.font = { size: 10 };
  Chart.defaults.plugins.legend.labels.color = ctVar("axis-text", PRINTING);
}

function renderCmDailyDevice() {
  const d = DATA.cmDailyDevice;
  const el = document.getElementById("chart-cmDailyDevice");
  if (!d || !el) return;
  mkChart(el, {
    type: "bar",
    data: {
      labels: d.labels,
      datasets: [
        { label: "Desktop", data: d.desktop, backgroundColor: ctVar("series-1", PRINTING), stack: "s", borderRadius: 2 },
        { label: "Mobile", data: d.mobile, backgroundColor: ctVar("series-2", PRINTING), stack: "s", borderRadius: 2 },
      ],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, beginAtZero: true, grid: { color: ctVar("grid", PRINTING) } } },
      plugins: { legend: { position: "bottom" } },
    },
  });
}

// p75 is shown as a value on the metric-tile (renderMetricGrid) rather than a
// rendered vertical reference line on the histogram — a real marker line needs
// the Chart.js annotation plugin (an added vendor dependency) for what the
// tile already shows for free.
//
// 11 buckets in a third-of-a-page-wide chart cannot all carry a label without
// either rotating (illegible at this scale) or shrinking past the deck's
// --rp-text-micro floor, so BUCKET_AXIS below fixes the font at that floor,
// forces the labels flat, and skips down to every-other tick — the dropped
// labels are still even/odd-spaced, so the reader can interpolate them,
// which a 45° rotation or a sub-10px font cannot offer at all.
const BUCKET_AXIS = { ticks: { font: { size: 10 }, maxRotation: 0, minRotation: 0, autoSkip: true, maxTicksLimit: 6 }, grid: { display: false } };
function renderDistribution() {
  const d = DATA.cmCwvDistribution;
  if (!d) return;
  const seriesVar = { lcp: "series-1", inp: "series-2", cls: "series-3" };
  ["lcp", "inp", "cls"].forEach(metric => {
    const m = d[metric];
    const el = document.getElementById("chart-dist-" + metric);
    if (!m || !el) return;
    mkChart(el, {
      type: "bar",
      data: { labels: m.buckets, datasets: [{ data: m.counts, backgroundColor: ctVar(seriesVar[metric], PRINTING), borderRadius: 2 }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: BUCKET_AXIS,
          y: { beginAtZero: true, grid: { color: ctVar("grid", PRINTING) } },
        },
      },
    });
  });
}

// 31 day-of-month labels in a third- or half-width chart hit the same
// crowding as BUCKET_AXIS above; same fix (floor font, flat, auto-skip).
const DAY_AXIS = { ticks: { font: { size: 10 }, maxRotation: 0, minRotation: 0, autoSkip: true, maxTicksLimit: 10 }, grid: { display: false } };
function renderDailyCwv() {
  const d = DATA.cmDailyCwv;
  if (!d) return;
  ["lcp", "inp", "cls"].forEach(metric => {
    const m = d[metric];
    const el = document.getElementById("chart-daily-" + metric);
    if (!m || !el) return;
    const t = THRESHOLDS[metric];
    const flat = v => d.labels.map(() => v);
    mkChart(el, {
      type: "line",
      data: {
        labels: d.labels,
        datasets: [
          { label: "Desktop", data: m.desktop, borderColor: ctVar("series-1", PRINTING), backgroundColor: ctVar("series-1", PRINTING), borderWidth: 2, tension: 0.25, pointRadius: 0 },
          { label: "Mobile", data: m.mobile, borderColor: ctVar("series-2", PRINTING), backgroundColor: ctVar("series-2", PRINTING), borderWidth: 2, tension: 0.25, pointRadius: 0 },
          { label: "Good threshold", data: flat(t.good), borderColor: ctVar("threshold-good", PRINTING), borderDash: [4, 4], borderWidth: 1, pointRadius: 0 },
          { label: "Poor threshold", data: flat(t.poor), borderColor: ctVar("threshold-poor", PRINTING), borderDash: [4, 4], borderWidth: 1, pointRadius: 0 },
        ],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: DAY_AXIS, y: { beginAtZero: true, grid: { color: ctVar("grid", PRINTING) } } },
      },
    });
  });
  // One shared legend for the three small-multiple trend charts instead of
  // three repeated ones — see the .chart-legend rule in deck-base.css. Its
  // swatch/dash colours are inline styles JS bakes in, same as a chart's
  // canvas pixels, so it is rebuilt every buildEverything() pass too.
  const legendEl = document.getElementById("legend-dailyCwv");
  if (legendEl) {
    legendEl.innerHTML = [
      `<span class="item"><span class="swatch" style="background:${ctVar("series-1", PRINTING)}"></span>Desktop</span>`,
      `<span class="item"><span class="swatch" style="background:${ctVar("series-2", PRINTING)}"></span>Mobile</span>`,
      `<span class="item"><span class="dash" style="color:${ctVar("threshold-good", PRINTING)}"></span>Good threshold</span>`,
      `<span class="item"><span class="dash" style="color:${ctVar("threshold-poor", PRINTING)}"></span>Poor threshold</span>`,
    ].join("");
  }
}

function renderErrorRates() {
  const d = DATA.cmErrorRates;
  if (!d) return;
  [["jsErrorRate", "chart-jsErrorRate", "series-1"], ["reqErrorRate", "chart-reqErrorRate", "critical"]].forEach(([key, id, colorName]) => {
    const el = document.getElementById(id);
    if (!el) return;
    const color = ctVar(colorName, PRINTING);
    mkChart(el, {
      type: "line",
      data: { labels: d.labels, datasets: [{ data: d[key], borderColor: color, backgroundColor: color, borderWidth: 2, tension: 0.25, pointRadius: 0 }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          x: DAY_AXIS,
          y: { beginAtZero: true, grid: { color: ctVar("grid", PRINTING) }, ticks: { callback: v => v + "%" } },
        },
      },
    });
  });
}

function renderErrorCounts() {
  const d = DATA.cmErrorCounts;
  const el = document.getElementById("chart-errorCounts");
  if (!d || !el) return;
  const folded = foldErrorTypes(d.byType, d.labels.length);
  const keys = Object.keys(folded);
  // series-6 is reserved for "Other" specifically, not "whichever type
  // sorted 6th" — the fold guarantees "Other" only ever appears once, last.
  const seriesFor = (key, i) => ctVar(key === "Other" ? "series-6" : `series-${i + 1}`, PRINTING);
  mkChart(el, {
    type: "bar",
    data: {
      labels: d.labels,
      datasets: keys.map((k, i) => ({ label: k, data: folded[k], backgroundColor: seriesFor(k, i), stack: "s", borderRadius: 2 })),
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, beginAtZero: true, grid: { color: ctVar("grid", PRINTING) } } },
      plugins: { legend: { position: "bottom" } },
    },
  });
}

function buildEverything(printing) {
  PRINTING = printing;
  charts.forEach(c => c.destroy());
  charts = [];
  applyChartDefaults();
  renderKpis(DATA.kpis);
  renderMetricGrid();
  renderDeviceCompareTable();
  renderTopPagesTable();
  renderTopExceptionsTable();
  renderTopRequestErrorsTable();
  renderCmDailyDevice();
  renderDistribution();
  renderDailyCwv();
  renderErrorRates();
  renderErrorCounts();
}

// Three passes, not one: DOMContentLoaded draws the on-screen (dark) review
// copy; beforeprint destroys and redraws everything with the print palette
// BEFORE Chrome's --print-to-pdf path captures the page (see the ctVar()
// comment above for why beforeprint cannot simply ask the cascade which
// theme is active); afterprint redraws with the screen palette again, so a
// reader who opens the system print dialog and cancels it is not left
// looking at a light-inked chart on the dark screen copy.
document.addEventListener("DOMContentLoaded", () => buildEverything(false));
window.addEventListener("beforeprint", () => buildEverything(true));
window.addEventListener("afterprint", () => buildEverything(false));
</script>
</body>
</html>
