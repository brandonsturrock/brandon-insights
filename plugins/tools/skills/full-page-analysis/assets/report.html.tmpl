<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Full Page Analysis — {{PAGE_TITLE}}</title>
<!-- DT Flow faces, base64-inlined by build-report.mjs. Empty when the font
     files are not present locally; --dt-font-sans then falls through to
     Roboto. See fontFaceCss() for why they are not committed. -->
<style>{{FONT_FACES}}</style>
<style>{{STRATO_TOKENS}}</style>
<style>
  body { background: var(--dt-bg-base); color: var(--dt-text-primary);
         font-family: var(--dt-font-sans); margin: 0; padding: var(--dt-space-32); }
  .panel { background: var(--dt-bg-container); border: 1px solid var(--dt-border-default);
           border-radius: var(--dt-radius); padding: var(--dt-space-16);
           margin-bottom: var(--dt-space-32); }
  /* Masthead: logo, a hairline divider, the team lockup, and the build date on
     the far side. Deliberately quiet — a deliverable looks official because the
     mark is placed with confidence and the rule under it is crisp, not because
     the branding is large. The logo is sized in one place, by width, and the
     viewBox carries the aspect ratio. */
  .report-header { display: flex; align-items: center; justify-content: space-between;
    gap: var(--dt-space-16); flex-wrap: wrap;
    padding-bottom: 14px; margin-bottom: 34px;
    border-bottom: 1px solid var(--dt-border-default); }
  .brand { display: flex; align-items: center; gap: 14px; color: var(--dt-text-primary); }
  .dt-logo { width: 150px; height: auto; display: block; flex: none; }
  .brand-rule { width: 1px; align-self: stretch; min-height: 20px;
    background: var(--dt-border-default); }
  /* An all-caps lockup, not UI copy — the one place the report shouts, and it
     shouts quietly: tracked out, small, and in the secondary ink so it sits
     beside the mark rather than competing with it. */
  .brand-team { font-size: var(--wf-text-small); font-weight: 700;
    letter-spacing: .16em; text-transform: uppercase; color: var(--dt-text-secondary);
    white-space: nowrap; }
  .brand-meta { font-size: var(--wf-text-small); color: var(--text-subdued); }

  h1, h2 { font-weight: 600; margin: 0 0 var(--dt-space-16); }
  /* The title block sits between two hard edges — the masthead rule above and
     the first panel below — so it gets room to be the thing you land on. */
  .doc-title { margin: 0 0 var(--dt-space-32); }
  .doc-kind { margin: 0 0 5px; font-size: var(--wf-text-small); color: var(--text-subdued); }
  /* Application › page, both at display size. The report is about one page of
     one application and neither half is subordinate, so the two carry equal
     weight and are separated by hue and face rather than by size: the
     application recedes to the subdued ink, the page holds the full-strength
     ink and is set in mono because it is a literal path. Sizing the page down
     to a caption — the first attempt — made the subject of the report the
     smallest text in its own title. */
  h1 { font-size: 27px; line-height: 1.25; letter-spacing: -.01em; margin: 0;
    display: flex; align-items: baseline; flex-wrap: wrap; gap: 0 2px; }
  .h-app { color: var(--text-subdued); font-weight: 600; }
  .h-sep { color: var(--text-subdued); font-weight: 400; margin: 0 10px; }
  /* Mono runs optically larger than the sans at the same nominal size, so the
     page steps down 3px to sit level with the application beside it. */
  .h-page { font-family: var(--dt-font-mono); font-size: 24px; font-weight: 700;
    color: var(--dt-text-primary); overflow-wrap: anywhere; }

  /* Report context: what was measured, and which single load the waterfall
     came from. A definition grid rather than a sentence, because these are
     seven independent facts a reader looks up one at a time — the same reason
     the resource tables are tables. auto-fit means it reflows to however many
     columns the width allows instead of a fixed break. */
  .report-context { display: grid; gap: 14px var(--dt-space-32);
    grid-template-columns: repeat(auto-fit, minmax(150px, max-content));
    margin: 0 0 var(--dt-space-32); padding: 0; }
  .report-context dt { font-size: var(--wf-text-micro); font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--text-subdued);
    margin: 0 0 3px; }
  .report-context dd { margin: 0; font-size: var(--wf-text-body);
    color: var(--text-default); }
  /* IDs are opaque tokens — a line break inside one turns a copyable value
     into two fragments, so they never wrap and take a column as wide as they
     need. */
  /* Inside the waterfall card the grid is panel furniture rather than document
     furniture: it sits under the URL with a rule above it and tighter columns,
     so it reads as this panel's caption and not as a second page header. */
  .wf-context { margin: 14px 0 var(--dt-space-16); padding-top: 14px;
    border-top: 1px solid var(--border-subdued);
    grid-template-columns: repeat(auto-fit, minmax(130px, max-content)); }
  .report-context .id { font-family: var(--dt-font-mono); font-size: var(--wf-text-small);
    color: var(--text-subdued); white-space: nowrap; }
  /* The id keeps its mono treatment inside the link; the accent and the
     external-link glyph are what mark it as somewhere to go. */
  .ctx-link { display: inline-flex; align-items: center; gap: 5px;
    text-decoration: none; color: var(--dt-primary); }
  .ctx-link .id { color: inherit; }
  .ctx-link:hover .id, .ctx-link:focus-visible .id { text-decoration: underline; }
  .ctx-link:focus-visible { outline: 1px dashed var(--dt-primary); outline-offset: 3px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; }
  h2 { font-size: var(--wf-text-title); }
  .example-note { color: var(--dt-warning); font-size: var(--wf-text-body); }
</style>
<style>
  /* v1 custom properties, remapped onto the Strato tokens above.
     Redefined here rather than edited rule-by-rule, so the ported waterfall
     rules are unchanged from v1's assets/template.html (deleted in Task 9).
     Both v1 and v2 are dark themes and Strato's dark roles are loaded, so the
     surface ramp runs dark base → lighter container, and every foreground mix
     over --dt-bg-base lightens instead of darkening. Derived shades use
     color-mix over the tokens — no new hex. Every percentage below was
     re-measured against the dark canvas and lands at or above the ratio it
     held on the light build, so they carry over unchanged. */
  :root {
    --bg-page:                   var(--dt-bg-base);
    --bg-surface:                var(--dt-bg-container-subtle);
    --bg-container:              var(--dt-bg-container);
    --bg-container-subdued:      var(--dt-bg-container-subtle);
    --bg-container-emphasized:   color-mix(in srgb, var(--dt-border-default) 45%, var(--dt-bg-container));
    --bg-container-primary:      color-mix(in srgb, var(--dt-primary) 8%, var(--dt-bg-base));
    --border-default:            var(--dt-border-default);
    --border-subdued:            color-mix(in srgb, var(--dt-border-default) 55%, var(--dt-bg-base));
    --text-default:              var(--dt-text-primary);
    --text-subdued:              var(--dt-text-secondary);
    --text-disabled:             color-mix(in srgb, var(--dt-text-secondary) 55%, var(--dt-bg-base));
    --good:                      var(--dt-success);
    --warning:                   var(--dt-warning);
    --critical:                  var(--dt-critical);

    /* One type ramp replaces the ad-hoc 9/10/11/12/13/15/18/20px sizes. */
    --wf-text-micro: 10px;   /* type column, tick labels, tooltip keys */
    --wf-text-small: 12px;   /* secondary / dense labels */
    --wf-text-body:  13px;   /* body */
    --wf-text-lead:  16px;   /* emphasised numbers */
    --wf-text-title: 20px;   /* section headings (h2) */
    --wf-text-display: 24px; /* report heading (h1) */
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-default);
    font-family: var(--dt-font-sans);
    font-size: var(--wf-text-body);
    padding: var(--dt-space-32);
  }
  .page-wrap { max-width: 1400px; margin: 0 auto; }
  h1 { font-size: var(--wf-text-display); margin: 0 0 4px; }
  .subtitle { color: var(--text-subdued); font-size: var(--wf-text-small); margin-bottom: var(--dt-space-32); }
  .small { font-size: var(--wf-text-small); }
  .subdued { color: var(--text-subdued); }

  /* ── Metrics panel ─────────────────────────────────────────── */
  .metrics-row { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .metric-tile {
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    padding: var(--dt-space-16);
    flex: 1;
    min-width: 100px;
  }
  .metric-tile .label { color: var(--text-subdued); font-size: var(--wf-text-small); display: block; margin-bottom: 4px; }
  .metric-tile .value { font-size: var(--wf-text-lead); font-weight: 600; margin: 0; font-variant-numeric: tabular-nums; }
  .metric-tile .sub { color: var(--text-subdued); font-size: var(--wf-text-small); display: block; margin-top: 2px; }

  .context-box {
    margin-top: var(--dt-space-16);
    margin-bottom: var(--dt-space-16);
    padding: var(--dt-space-8) var(--dt-space-16);
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .context-item { display: flex; gap: 6px; }

  /* ── Controls ──────────────────────────────────────────────── */
  .controls-row { display: flex; gap: var(--dt-space-16); margin-bottom: var(--dt-space-8); flex-wrap: wrap; align-items: flex-start; }
  .control-group { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .control-buttons { display: flex; gap: 6px; }
  .control-sep { width: 1px; align-self: stretch; background: var(--border-default); }
  .btn {
    appearance: none;
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    color: var(--text-default);
    border-radius: 4px;
    padding: 5px 10px;
    font-size: var(--wf-text-small);
    cursor: pointer;
    line-height: 1.2;
  }
  .btn:hover:not(:disabled) { background: var(--bg-container-emphasized); }
  .btn.active { background: color-mix(in srgb, var(--dt-primary) 12%, var(--dt-bg-base)); border-color: var(--dt-primary); color: var(--dt-primary); font-weight: 600; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ── Waterfall ─────────────────────────────────────────────── */
  .waterfall { position: relative; width: 100%; border: 1px solid var(--border-default); border-radius: var(--dt-radius); overflow: hidden; }
  .wf-header {
    display: flex;
    height: 64px;
    border-bottom: 2px solid var(--border-default);
    background: var(--bg-surface);
    position: relative;
  }
  .col-label { width: 300px; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: flex-end; padding-left: 8px; padding-bottom: 6px; }
  .col-type  { width: 40px; flex-shrink: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 6px; }
  .col-dur   { width: 80px; flex-shrink: 0; box-sizing: border-box; text-align: right; padding-right: 16px; padding-bottom: 6px; align-self: flex-end; }
  .col-timeline-hd { flex: 1; position: relative; align-self: stretch; z-index: 10; }

  /* The pill is now only a positioner: each marker inside it carries its own
     chip. A merged group holds two or three milestones that landed within 2.5%
     of each other, and one background colour cannot speak for all of them —
     so they sit as separate chips rather than as coloured words sharing a box. */
  .pill {
    position: absolute;
    transform: translateX(-50%);
    display: flex;
    gap: 3px;
    white-space: nowrap;
    cursor: crosshair;
    user-select: none;
  }
  .pm-chip {
    border-radius: 3px;
    padding: 1px 5px;
    font-size: var(--wf-text-micro);
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 14px;
    color: var(--dt-bg-base);
  }
  .sticky-pills {
    position: fixed;
    top: 4px;
    left: 0;
    right: 0;
    height: 0;
    z-index: 100;
    pointer-events: none;
    display: none;
  }
  .sticky-pills .pill { pointer-events: auto; position: absolute; }

  .tick-label { position: absolute; bottom: 6px; padding-left: 3px; font-size: var(--wf-text-micro); color: var(--text-subdued); white-space: nowrap; }

  .wf-body { position: static; }
  .wf-overlay { position: absolute; top: 0; bottom: 0; right: 0; }
  .origin-line, .tick-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--border-subdued); pointer-events: none; }
  .phase-line-hit { position: absolute; top: 0; bottom: 0; width: 8px; cursor: crosshair; pointer-events: auto; }
  .phase-line-hit .phase-line { position: absolute; left: 3px; top: 0; bottom: 0; width: 1px; background: color-mix(in srgb, var(--dt-text-secondary) 60%, transparent); pointer-events: none; }
  .longtask-block { position: absolute; top: 0; bottom: 0; background: color-mix(in srgb, var(--critical) 10%, transparent); pointer-events: none; }
  .ex-marker { position: absolute; top: 0; bottom: 0; cursor: crosshair; }
  .ex-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--critical); pointer-events: none; }

  .wf-section-header {
    display: flex; align-items: center; height: 26px;
    background: var(--bg-container);
    border-bottom: 1px solid var(--border-default);
  }
  .wf-section-header .lbl {
    width: 420px; flex-shrink: 0; padding-left: 8px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--wf-text-micro);
  }
  .wf-section-header .rule { flex: 1; height: 1px; background: var(--border-subdued); }

  .wf-row { display: flex; align-items: center; height: 26px; border-bottom: 1px solid var(--border-subdued); }
  /* Zebra flattened: the per-row hairline already carries the scan line.
     Classes retained — renderWaterfall still emits them. */
  .wf-row.even, .wf-row.odd { background: var(--bg-page); }
  .wf-row.lcp  { box-shadow: inset 3px 0 0 var(--warning); }
  .wf-row.pending { background-image: repeating-linear-gradient(45deg, color-mix(in srgb, var(--warning) 18%, transparent) 0px, color-mix(in srgb, var(--warning) 18%, transparent) 4px, transparent 4px, transparent 10px); }
  .wf-row:hover { background: var(--bg-container-primary) !important; background-image: none !important; }

  .cell-label {
    width: 300px; flex-shrink: 0; box-sizing: border-box;
    padding-left: 8px; padding-right: 4px; overflow: hidden;
    line-height: 26px; display: flex; align-items: center; gap: 4px;
    white-space: nowrap; text-overflow: ellipsis;
  }
  .cell-label .url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-subdued); }
  .wf-row:hover .cell-label .url:not(.err) { color: var(--text-default); }
  .cell-label .url.err { color: var(--critical) !important; }
  .cell-type { width: 40px; flex-shrink: 0; text-align: center; font-size: var(--wf-text-micro); text-transform: uppercase; line-height: 26px; }
  .cell-dur  { width: 80px; flex-shrink: 0; box-sizing: border-box; text-align: right; padding-right: 16px; line-height: 26px; color: var(--text-subdued); overflow: hidden; white-space: nowrap; }
  .cell-dur.err { color: var(--critical); }
  .wf-row:hover .cell-dur:not(.err) { color: var(--text-default); }

  .cell-timeline { flex: 1; position: relative; height: 100%; overflow: hidden; }
  .bar { position: absolute; top: 4px; bottom: 4px; min-width: 2px; cursor: crosshair; }

  .stall-tick { position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: #8B96A5; pointer-events: none; }
  .stall-dash { position: absolute; left: 2px; right: 0; top: 50%; height: 0; border-top: 1px solid #8B96A5; pointer-events: none; }

  .legend { display: flex; flex-wrap: wrap; gap: var(--dt-space-16); padding-top: var(--dt-space-16); align-items: center; }
  .legend-item { display: flex; align-items: center; gap: 4px; }
  .legend-swatch { width: 10px; height: 10px; border-radius: 2px; }
  .legend-sep { width: 1px; height: 16px; background: var(--border-default); margin: 0 4px; }
  .legend-line { width: 2px; height: 10px; }

  .lcp-status { margin-top: var(--dt-space-16); display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .lcp-bar { display: flex; height: 20px; border-radius: 3px; overflow: hidden; margin: 4px 0 8px; }
  .lcp-bar span { display: block; min-width: 2px; }
  .lcp-key { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: var(--wf-text-small); color: var(--text-subdued); margin-bottom: var(--dt-space-16); }
  .lcp-key i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
  .lcp-key b { color: var(--text-default); font-weight: 600; }
  .lcp-sub { font-size: var(--wf-text-micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--text-subdued); margin: var(--dt-space-16) 0 8px; }
  .xpath { font-family: var(--dt-font-mono); font-size: var(--wf-text-small); word-break: break-all; }
  .print-only { display: none; }
  .agg-table .path.lcp-el { display: inline-block; min-width: 240px; white-space: normal; word-break: break-all; }
  /* The example action's resource URL is too long for a grid cell; give it the row. */
  #lcp-sample-slot .report-context > div:nth-child(3) { grid-column: 1 / -1; }
  .lcp-url { font-family: var(--dt-font-mono); word-break: break-all; color: var(--text-subdued); }

  .warn-banner {
    margin-bottom: 10px; padding: 7px 12px;
    background: color-mix(in srgb, var(--warning) 10%, transparent); border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
    border-radius: var(--dt-radius); text-align: center; color: var(--warning); font-weight: 700; font-size: var(--wf-text-small);
  }

  /* ── Tooltips ──────────────────────────────────────────────── */
  .tooltip {
    position: fixed;
    left: -9999px;
    top: -9999px;
    z-index: 9999;
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    padding: var(--dt-space-8) var(--dt-space-16);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--dt-text-primary) 18%, transparent);
    pointer-events: none;
    display: none;
  }
  #tooltip { min-width: 260px; max-width: 360px; }
  #line-tooltip { min-width: 140px; }
  #ex-tooltip { max-width: 360px; border-color: color-mix(in srgb, var(--critical) 45%, var(--border-default)); }
  .tt-header { margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border-subdued); }
  .tt-badge-row { display: flex; align-items: center; gap: 6px; margin-bottom: 2px; }
  .tt-badge { font-size: var(--wf-text-micro); font-weight: 700; border-radius: 2px; padding: 0 4px; line-height: 14px; flex-shrink: 0; }
  .tt-title { font-size: var(--wf-text-small); font-weight: 600; color: var(--text-default); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tt-meta-table { border-collapse: collapse; width: 100%; margin-top: 6px; }
  .tt-meta-table td { font-size: var(--wf-text-micro); padding-right: 8px; white-space: nowrap; }
  .tt-meta-table td.v { color: var(--text-default); white-space: normal; word-break: break-all; }
  .tt-meta-table td.k { color: var(--text-subdued); }
  .tt-csp-badge { font-size: var(--wf-text-micro); font-weight: 700; color: var(--warning); background: color-mix(in srgb, var(--warning) 12%, transparent); border: 1px solid color-mix(in srgb, var(--warning) 40%, transparent); border-radius: 2px; padding: 1px 5px; display: inline-block; margin-top: 4px; }
  .tt-table { border-collapse: collapse; width: 100%; }
  .tt-sec-hd td { padding-top: 6px; padding-bottom: 3px; font-size: var(--wf-text-micro); font-weight: 700; color: var(--text-subdued); letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid var(--border-subdued); }
  .tt-row td { font-size: var(--wf-text-small); padding-bottom: 2px; }
  .tt-row td.k { color: var(--text-subdued); padding-right: 8px; white-space: nowrap; }
  .tt-row td.v { color: var(--text-default); text-align: right; }
  .tt-swatch-cell { width: 10px; padding-right: 4px; vertical-align: middle; }
  .tt-swatch { width: 8px; height: 8px; border-radius: 1px; }
  .tt-marker-row { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; }
  .tt-marker-line { width: 3px; height: 14px; border-radius: 1px; flex-shrink: 0; }
  .tt-marker-label { font-size: var(--wf-text-small); font-weight: 700; min-width: 36px; }
  .tt-marker-value { font-size: var(--wf-text-small); color: var(--text-default); }
  /* Sampled-load title inside the waterfall panel. v1 rendered this as the page
     <h1>; here the panel <h2> owns the heading, so this is a lead-sized label. */
  .wf-instance-title { font-size: var(--wf-text-lead); font-weight: 600; margin-bottom: 2px; }

  /* ── Aggregate sections ────────────────────────────────────────
     One table idiom for all five aggregate tables. Deliberately the same
     row language as the waterfall: 26px-ish rows, a hairline per row rather
     than zebra, the same hover wash, tabular numerals on every figure. */
  .panel-note { color: var(--text-subdued); font-size: var(--wf-text-small); margin: -8px 0 var(--dt-space-16); }
  .panel-note strong { color: var(--text-default); font-variant-numeric: tabular-nums; }
  .table-scroll { overflow-x: auto; }
  .agg-table { width: 100%; border-collapse: collapse; font-size: var(--wf-text-small); }
  .agg-table th {
    text-align: left; padding: 0 8px 6px; white-space: nowrap;
    font-size: var(--wf-text-micro); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-subdued); border-bottom: 1px solid var(--border-default);
  }
  .agg-table td { padding: 5px 8px; border-bottom: 1px solid var(--border-subdued); vertical-align: middle; }
  .agg-table tbody tr:last-child td { border-bottom: none; }
  .agg-table tbody tr:hover { background: var(--bg-container-primary); }
  /* width: 1% shrinks numeric columns to their content, so the slack lands in
     the label column and the figures stay a single scannable block on the
     right instead of drifting apart as the viewport widens. */
  .agg-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; width: 1%; }
  .agg-table .lead { font-size: var(--wf-text-body); font-weight: 600; }
  .agg-table .path { font-family: var(--dt-font-mono); color: var(--text-default); white-space: nowrap; }

  /* ── Page experience metric tiles ────────────────────────────────────
     These replace a percentile table. The table's own objection to charting
     these five metrics still stands and is worth restating, because it is
     what shapes the tile: LCP, FCP, INP and TTFB are milliseconds, CLS is an
     unitless shift score, and no numeric axis can hold both. So the tiles do
     not give them one. Each tile normalises its metric against its *own*
     good/poor boundaries, which pins every threshold to the same x in every
     tile — good ends at 40%, poor begins at 70%. The axis is semantic rather
     than numeric: "how far into unacceptable is this, and how wide is the
     spread" reads straight across all five, while every printed figure stays
     in its own unit. That is the one thing the table could not show, since a
     table cell can carry a value and a verdict but not a distribution.

     Colour is never the only carrier of the verdict: each tile pairs its
     colour with a shaped icon and the rating spelled out, following Strato's
     status vocabulary (circle+check ideal, triangle+exclamation warning,
     diamond+X critical). Strip the colour and the tile still reads. */
  .metric-grid { display: grid; gap: var(--dt-space-16);
    grid-template-columns: repeat(auto-fit, minmax(208px, 1fr)); }
  .metric-tile { background: var(--dt-bg-container-subtle);
    border: 1px solid var(--dt-border-default); border-radius: var(--dt-radius);
    padding: var(--dt-space-16); }
  /* One accent per tile, set from the rating and consumed by the value, the
     status chip and the p75 marker, so the three can never disagree. */
  .metric-tile[data-rating="good"]              { --mt-accent: var(--good); }
  .metric-tile[data-rating="needs-improvement"] { --mt-accent: var(--warning); }
  .metric-tile[data-rating="poor"]              { --mt-accent: var(--critical); }
  .metric-tile[data-rating="none"]              { --mt-accent: var(--text-subdued); }

  .mt-head { display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--dt-space-8); }
  .mt-abbr { font-weight: 700; font-size: var(--wf-text-title); letter-spacing: .02em; }
  .mt-name { color: var(--text-subdued); font-size: var(--wf-text-small); margin-top: 2px; }
  .mt-status { display: inline-flex; align-items: center; gap: 5px; flex: none;
    font-size: var(--wf-text-micro); font-weight: 700; padding: 2px 8px; border-radius: 999px;
    color: var(--mt-accent); background: color-mix(in srgb, var(--mt-accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--mt-accent) 45%, transparent); }
  .mt-status svg { flex: none; display: block; }

  .mt-value { margin-top: var(--dt-space-16); font-weight: 700; font-size: 30px; line-height: 1;
    color: var(--mt-accent); font-variant-numeric: tabular-nums; }
  .mt-value-tag { font-size: var(--wf-text-small); font-weight: 600; color: var(--text-subdued);
    margin-left: 7px; letter-spacing: .04em; }

  /* The scale. The track carries the three threshold zones; markers sit in the
     same positioning context but outside the track's `overflow: hidden`, so a
     marker at 0% or 100% is not clipped in half. */
  .mt-scale { position: relative; margin-top: 14px; height: 22px; }
  .mt-track { display: flex; height: 8px; border-radius: 4px; overflow: hidden; }
  /* A 2px gap of the tile surface separates adjacent fills, so the boundary
     between two zones is a real edge rather than two mixed colours meeting.
     border-box keeps the percentage widths honest once the border is added —
     without it each zone would grow by its border and the three would overflow
     the track, pushing the poor zone off the end. */
  .mt-zone { height: 100%; box-sizing: border-box; }
  .mt-zone + .mt-zone { border-left: 2px solid var(--dt-bg-container-subtle); }
  /* Zone fills stay quieter than the markers — they are a reference backdrop,
     not data — but each is mixed only part-way toward the page base so the
     three remain tellable apart at 8px tall, which a lighter mix did not. */
  .mt-zone-good { width: 40%; background: color-mix(in srgb, var(--good) 45%, var(--dt-bg-base)); }
  .mt-zone-ni   { width: 30%; background: color-mix(in srgb, var(--warning) 45%, var(--dt-bg-base)); }
  .mt-zone-poor { width: 30%; background: color-mix(in srgb, var(--critical) 45%, var(--dt-bg-base)); }
  /* 2px surface ring, so a marker landing on a zone boundary or overlapping a
     neighbouring marker stays legible as its own mark. */
  .mt-mark { position: absolute; top: 0; width: 2px; height: 8px; border-radius: 1px;
    background: var(--text-subdued); transform: translateX(-1px);
    box-shadow: 0 0 0 2px var(--dt-bg-container-subtle); }
  .mt-mark-p75 { width: 4px; height: 16px; top: -4px; transform: translateX(-2px);
    background: var(--mt-accent); }
  .mt-bounds { display: flex; justify-content: space-between; gap: var(--dt-space-8);
    margin-top: 2px; font-size: var(--wf-text-micro); color: var(--text-subdued); }
  .mt-tail { display: flex; justify-content: space-between; gap: var(--dt-space-8);
    margin-top: 10px; padding-top: 9px; border-top: 1px solid var(--dt-border-default);
    font-size: var(--wf-text-small); color: var(--text-subdued);
    font-variant-numeric: tabular-nums; }
  .mt-tail b { color: var(--text-default); font-weight: 600; }

  /* The em dash is the mandated null mark, so it is the one glyph that must
     stay legible: --text-disabled is 2.25:1 on the panel, --text-subdued is
     5.90:1. The dash is already distinct from a figure by shape; it does not
     need to be dimmer than every other label as well. */
  .agg-table .nil { color: var(--text-subdued); }

  /* Coverage meter — the report's one signature device, and the reason v2
     exists: it turns "loads" from a numeric column you skim past into a bar
     you scan down. Neutral ink, not a status hue: prevalence is not good or
     bad, it is how much of the population a row speaks for. The figure is
     always printed beside the bar, so the bar never carries the value alone. */
  .cov { display: flex; align-items: center; gap: 8px; width: 100%; min-width: 190px; }
  .cov-track {
    /* Flexible again, but the figure+chip slot beside it is fixed, so every
       track in a column still resolves to the same length while filling
       whatever width the column has. */
    position: relative; flex: 1 1 auto; min-width: 56px; height: 9px;
    border-radius: 5px; background: var(--dt-bg-base);
    /* 40%, not 30%: the track outline is the only thing that shows an empty
       bar exists, and 30% sat at 2.78:1 against the page. 40% clears 3:1. */
    border: 1px solid color-mix(in srgb, var(--dt-text-secondary) 40%, var(--dt-border-default));
    overflow: hidden;
  }
  .cov-fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--text-subdued); }
  .cov-text { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--text-default); }
  /* Figure + chip share one fixed-width slot so the chips line up too. */
  .cov-label { display: flex; align-items: center; gap: 6px; flex: 0 0 190px; }
  .cov-text .of { color: var(--text-subdued); }
  .chip {
    display: inline-block; border: 1px solid var(--border-default); border-radius: 3px;
    padding: 0 4px; font-size: var(--wf-text-micro); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-subdued);
    background: var(--bg-surface); white-space: nowrap;
  }
  .chip.rare { border-color: color-mix(in srgb, var(--dt-text-secondary) 45%, var(--dt-border-default)); }

  .rating { font-weight: 600; }
  .rating .word { font-size: var(--wf-text-micro); text-transform: uppercase; letter-spacing: 0.06em; margin-left: 6px; }


  .empty-note { color: var(--text-subdued); font-size: var(--wf-text-small); font-style: italic; }
  .skipped-banner {
    padding: var(--dt-space-8) var(--dt-space-16); margin-bottom: var(--dt-space-16);
    border-radius: var(--dt-radius); font-size: var(--wf-text-small);
    color: var(--warning); background: color-mix(in srgb, var(--warning) 8%, var(--dt-bg-base));
    border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
  }
  .skipped-banner code { font-family: var(--dt-font-mono); }

  /* Findings panel. One row per rule result: a severity chip (reuses .chip,
     coloured inline per finding since severity is data, not a fixed class),
     the title, and the evidence sentence — no new hue set, just the three
     tokens the brief names, already vetted at these same weights by the CWV
     rating pairs and the skipped-file banner elsewhere in this template.

     A two-column grid, not a flex row. The severity chip sits in a fixed-width
     left column spanning both text lines, which puts every title on the same x:
     the reader scans titles down one edge and drops into the evidence only for
     the ones that matter. Title and evidence are on separate lines because a
     600-weight title running inline with a subdued sentence stops being
     scannable — the eye has to work out where the title ended before it can
     skip the rest, which is the opposite of what a findings list is for. */
  .finding-row { display: grid; grid-template-columns: 74px minmax(0, 1fr);
    gap: 3px var(--dt-space-16); padding: 13px 0;
    border-bottom: 1px solid var(--border-subdued); }
  .finding-row:last-child { border-bottom: none; padding-bottom: 2px; }
  .finding-chip { grid-row: span 2; align-self: start; justify-self: start; margin-top: 1px; }
  .finding-title { font-weight: 600; color: var(--text-default); }
  /* The half-width column sets the measure; the cap here is only a guard for
     very wide screens. `anywhere` lets the long resource URLs some rules name
     wrap inside the column instead of forcing it open. */
  .finding-evidence { color: var(--text-subdued); font-size: var(--wf-text-small);
    line-height: 1.5; max-width: 88ch; overflow-wrap: anywhere; }
  /* The findings / analyst-notes pair. The two cards stretch to a common
     height (grid's default `align-items: stretch`) because they read as one
     row: two cards of different heights sitting side by side look like a
     layout accident rather than a pairing. The panels keep their own
     margin-bottom, so the pair only needs to suppress the double gap. */
  .panel-pair { display: grid; gap: var(--dt-space-16);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); }
  .panel-pair .panel { margin-bottom: 0; }
  .panel-pair { margin-bottom: var(--dt-space-32); }

  /* Analyst notes: plain prose written by a later agent, edited in place.
     No character cap here — the grid column above already sets the measure, and
     a cap on top of it is what produced a narrow ribbon of text with dead space
     beside it. The one guard left is for very wide screens, where half of a
     2560px viewport would otherwise run to ~160 characters. */
  .exec-body { font-size: var(--wf-text-body); line-height: 1.6; color: var(--text-default);
    min-height: 3em; max-width: 88ch; }
  .exec-body ul { margin: 0; padding-left: 18px; }
  .exec-body li { margin-bottom: var(--dt-space-8); }
  .exec-body li:last-child { margin-bottom: 0; }
  .exec-body p { margin: 0 0 10px; }
  /* --border-default (#dadbe4 on #f2f2f5) is 1.23:1 — nowhere near the 3:1 a
     UI-component outline needs. --dt-primary is 5.9:1 on the same panel and
     is already the link/emphasis role, so an editable region borrowing it
     reads as "this is interactive," which is the point of the outline. */
  .exec-body[contenteditable="true"]:focus { outline: 1px dashed var(--dt-primary); outline-offset: 4px; }

  /* ── Print ─────────────────────────────────────────────────────────
     The PDF carries everything the HTML shows, in the same dark theme, so
     the HTML structure is untouched and print only reformats:
     - backgrounds are forced on (print-color-adjust), and page margins are 0
       with the spacing on body instead, cloned onto every page, because
       Chrome paints @page margins white whatever the root background;
     - the full waterfall moves to the end of the document (body becomes a
       flex column so `order` can move it without touching the DOM);
     - text the screen shortens with "…" prints in full from the title
       attribute that already holds it;
     - hover-only controls and tooltips are dropped.
     `build-report.mjs --print-theme light` sets data-print-theme="light" on
     <html>, which swaps the Strato roles to their light values below. */
  @media print {
    @page { margin: 0; }
    html, body { -webkit-print-color-adjust: exact; print-color-adjust: exact; background: var(--bg-page); }
    body { padding: 8mm; box-decoration-break: clone; -webkit-box-decoration-break: clone;
           display: flex; flex-direction: column; }
    body > * { flex-shrink: 0; }
    :root[data-print-theme="light"] {
      --dt-bg-base:             #f9f9fa; /* Colors.Background.Base.Default (light) */
      --dt-bg-container:        #f2f2f5; /* Colors.Background.Container.Neutral.Default (light) */
      --dt-bg-container-subtle: #f9f9fa; /* Colors.Background.Container.Neutral.Subdued (light) */
      --dt-text-primary:        #2f2f4f; /* Colors.Text.Neutral.Default (light) */
      --dt-text-secondary:      #595a7d; /* Colors.Text.Neutral.Subdued (light) */
      --dt-border-default:      #dadbe4; /* Colors.Border.Neutral.Default (light) */
      --dt-critical:            #bb0731; /* Colors.Text.Critical.Default (light) */
      --dt-warning:             #855400; /* Colors.Text.Warning.Default (light) */
      --dt-success:             #2d6761; /* Colors.Text.Success.Default (light) */
      --dt-primary:             #464cce; /* Colors.Text.Primary.Default (light) */
    }
    /* ── Condensed PDF ──
       The PDF is a summary a stakeholder reads in a few pages, with the full
       waterfall as an appendix. Print keeps every section but trims each:
       fewer table rows and columns, truncated paths and findings evidence
       clamped to two lines, so each section fits whole on a page. The HTML
       stays the full report. */
    .print-only { display: inline; }
    .scr-only { display: none; }
    .report-header { padding-bottom: 8px; margin-bottom: 12px; }
    .doc-title { margin-bottom: 12px; }
    /* No section splits across pages; the waterfall appendix is the only exception. */
    .panel { padding: 12px 14px; margin-bottom: 10px; break-inside: avoid; page-break-inside: avoid; }
    #waterfall-panel { break-inside: auto; page-break-inside: auto; }
    .panel h2 { font-size: 16px; margin-bottom: 8px; break-after: avoid; page-break-after: avoid; }
    .panel-note { margin: -4px 0 8px; }
    /* Headings, notes and sub-labels travel with what follows them. */
    .panel > h2, .panel-note, .lcp-sub { break-inside: avoid; break-after: avoid; page-break-after: avoid; }
    .agg-table thead { break-after: avoid; }
    .panel-pair { margin-bottom: 10px; }
    .panel-pair .panel { margin-bottom: 0; }
    .agg-table tr, .metric-tile, .finding-row, .exec-body li { break-inside: avoid; page-break-inside: avoid; }
    .table-scroll { overflow-x: visible; }
    .finding-evidence, .exec-body { max-width: none; }

    /* Experience metrics: all five tiles in one row. */
    .metric-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
    .metric-grid .metric-tile { padding: 10px; }
    .metric-grid .mt-value { font-size: 22px; white-space: nowrap; }
    .metric-grid .mt-bounds, .metric-grid .mt-tail { font-size: 9px; white-space: nowrap; gap: 4px; }

    /* LCP: the example action's URL on one line, no element path, top 5 resources. */
    #lcp-sample-slot > .xpath { display: none; }
    #lcp-sample-slot .report-context { margin-bottom: 8px; }
    #lcp-sample-slot .report-context dd .xpath { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* The most-common-resources table stays in the HTML; the PDF keeps the
       LCP section to page one. */
    #lcp-elements-slot { display: none; }
    /* One row of facts: LCP, element, size, updates, then the URL. */
    #lcp-sample-slot .report-context { grid-template-columns: repeat(4, max-content) minmax(0, 1fr); gap: 4px 24px; }
    #lcp-sample-slot .report-context > div:nth-child(3) { grid-column: 5; grid-row: 1; min-width: 0; }
    #lcp-panel .metrics-row .metric-tile { padding: 8px 10px; }

    /* Findings: title plus two lines of evidence; the HTML has the rest. */
    .finding-evidence { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .finding-row { padding-top: 6px; padding-bottom: 6px; }
    /* Page layout. Each page's sections are stretched to the page height
       (Letter, 279.4mm, less 8mm body padding top and bottom, with 3mm
       slack so rounding never spills onto a blank page) and their rows are
       spread evenly, so pages end flush instead of trailing off. min-height,
       not height: a longer report grows rather than clips. */
    #notes-panel .exec-body { font-size: 12px; line-height: 1.45; }

    /* Page 2: findings and analyst notes. The grid stretches both rows to fill. */
    .panel-pair { break-before: page; min-height: calc(260mm - 10px); }
    #findings-panel, #notes-panel { display: flex; flex-direction: column; }
    #computed-findings { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; }
    #notes-panel .exec-body { flex: 1; display: flex; flex-direction: column; }
    #notes-panel .exec-body ul { flex: 1; display: flex; flex-direction: column; justify-content: space-evenly; margin: 0; }
    #notes-panel .exec-body li { margin: 0; }

    /* Page 3: slowest and heaviest resources, half a page each; the tables
       share out the extra height across their rows. */
    #slowest-panel { break-before: page; }
    #slowest-panel, #heaviest-panel { min-height: calc((260mm - 20px) / 2); display: flex; flex-direction: column; }
    #slowest-slot, #heaviest-slot { flex: 1; display: flex; flex-direction: column; }
    #slowest-slot .agg-table, #heaviest-slot .agg-table { flex: 1; }

    /* Page 4: third parties, long tasks and errors, browsers. */
    #thirdparty-panel { break-before: page; }

    /* Supporting tables: 8 rows, one-line truncated paths, fewer columns. */
    .agg-table td { padding: 3px 5px; }
    .agg-table th { padding: 0 5px 4px; }
    .agg-table th, .agg-table th.num { white-space: normal; }
    .agg-table .path { display: inline-block; max-width: 230px; white-space: nowrap; overflow: hidden;
                       text-overflow: ellipsis; vertical-align: bottom; }
    .agg-table .chip { white-space: nowrap; }
    .cov { min-width: 0; gap: 6px; }
    .cov-track { min-width: 48px; }
    .cov-label { flex: 0 1 auto; }
    #slowest-slot tbody tr:nth-child(n+9), #heaviest-slot tbody tr:nth-child(n+9),
    #browserdevice-slot tbody tr:nth-child(n+7) { display: none; }
    /* p50 and p95: the p75 column carries the verdict. */
    #slowest-slot :is(th, td):is(:nth-child(5), :nth-child(7)),
    #heaviest-slot :is(th, td):is(:nth-child(5), :nth-child(7)) { display: none; }
    /* Third parties: drop the rare rows, keep 8, drop the raw request count. */
    #thirdparty-slot tbody tr:has(.chip.rare) { display: none; }
    #thirdparty-slot tbody tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr:not(:has(.chip.rare)) ~ tr { display: none; }
    #thirdparty-slot :is(th, td):nth-child(3) { display: none; }
    /* Errors: the rates, not the raw totals; the top 5 exceptions. */
    #errors-slot > .metrics-row > :nth-child(n+7) { display: none; }
    #errors-slot tbody tr:nth-child(n+4) { display: none; }
    .metrics-row { gap: 6px; margin-bottom: 6px; }
    #mainthread-panel .metric-tile { padding: 6px 10px; }
    #mainthread-panel .metric-tile .value { font-size: 15px; }

    /* Hover-only: controls, tooltips and the sticky phase-pill overlay. */
    #controls-slot, #tooltip, #line-tooltip, #ex-tooltip, .sticky-pills { display: none !important; }

    /* The full waterfall, every row, as the appendix on its own pages. */
    #waterfall-panel { order: 1; break-before: page; }
    .wf-row, .wf-section-header { break-inside: avoid; page-break-inside: avoid; }
    /* Long-task labels can centre past the timeline's end, where the page
       edge cuts them; the pink bands carry the same information. */
    #longtask-labels-slot { display: none; }
    /* Marker lines and long-task bands are positioned over the whole
       waterfall. Across pages Chrome sizes them without the per-page body
       padding, so they stop short; overshoot, and .waterfall's
       overflow:hidden trims them at its real bottom. */
    .waterfall .wf-overlay { bottom: -60mm; }
  }
</style>
</head>
<body>
<!-- Masthead. The wordmark's own group is fill="currentColor", so the header
     sets `color` and the type picks up the light ink; the logo mark keeps its
     fixed brand colours, which are the one place in this report where a hue is
     not a design token and must not be. -->
<header class="report-header">
  <div class="brand">
    <svg class="dt-logo" viewBox="0 0 800 142" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Dynatrace"><g fill="currentColor"><path d="m578.6 37.2h-18.4c-5.2 0-8.8 1-11 3.2-2.2 2.1-3.3 5.8-3.3 10.8v63.6h-11v-64.4c.1-4.9.9-10.2 3.5-14.2 4.7-7.5 13.7-8.9 20.4-8.9h19.9v9.9z"/><path d="m507.6 104.8c-5.2 0-8.8-1-11-3.2-2.2-2.1-3.3-5.6-3.3-10.6v-53.8h23.1v-9.9h-23.1v-26.3h-11v90.6c.1 4.9.9 10.2 3.5 14.2 4.7 7.5 13.7 8.9 20.4 8.9h19.9v-9.9z"/><path d="m219.3 1v26.2h-23.1c-14 0-22.5 4.2-27.8 9.3-8.1 7.9-8.1 19.2-8.1 20.4v28.2c0 1.2 0 12.5 8.1 20.4 5.2 5.1 13.7 9.3 27.8 9.3h10.3c6.7 0 15.7-1.5 20.4-8.9 2.5-4 3.4-9.3 3.5-14.2v-90.7zm-3.3 100.7c-2.2 2.1-5.8 3.2-11 3.2h-10c-9.1 0-14.8-2.6-18.2-6-4.1-4-5.5-9.3-5.5-13.4v-28.9c0-4.1 1.4-9.4 5.5-13.4 3.5-3.4 9.1-6 18.2-6h24.2v53.9c.1 4.9-1 8.4-3.2 10.6z"/><path d="m678.2 43.2c3.5-3.4 9.1-6 18.2-6h26.5v-9.9h-25.4c-14 0-22.5 4.2-27.8 9.3-8.1 7.9-8.1 19.2-8.1 20.4v28.2c0 1.2 0 12.5 8.1 20.4 5.2 5.1 13.7 9.3 27.8 9.3h25.4v-9.9h-26.5c-9.1 0-14.8-2.6-18.2-6-4.1-4-5.5-9.3-5.5-13.4v-29c0-4.1 1.4-9.5 5.5-13.4z"/><path d="m470.9 56.9c0-1.2 0-12.5-8.1-20.4-5.2-5.1-13.7-9.3-27.8-9.3h-24.5v9.9h25.6c9.1 0 14.8 2.6 18.2 6 4.1 4 5.5 9.3 5.5 13.4v8.5h-35.1c-6.7 0-15.7 1.5-20.4 8.9-2.5 4-3.4 9.3-3.5 14.2v3.5c.1 4.9.9 10.2 3.5 14.2 4.7 7.5 13.7 8.9 20.4 8.9h22.3c6.7 0 15.7-1.5 20.4-8.9 2.5-4 3.4-9.3 3.5-14.2 0 0 0-29 0-34.7zm-14.3 44.8c-2.2 2.1-5.8 3.2-11 3.2h-19.4c-5.2 0-8.8-1-11-3.2s-3.2-5.7-3.2-10.6v-2.4c0-5 1.1-8.5 3.3-10.6s5.8-3.2 11-3.2h33.6v16.2c0 4.9-1.1 8.4-3.3 10.6z"/><path d="m652.9 56.9c0-1.2 0-12.5-8.1-20.4-5.2-5.1-13.7-9.3-27.8-9.3h-24.5v9.9h25.6c9.1 0 14.8 2.6 18.2 6 4.1 4 5.5 9.3 5.5 13.4v8.5h-35.1c-6.7 0-15.7 1.5-20.4 8.9-2.5 4-3.4 9.3-3.5 14.2v3.5c.1 4.9.9 10.2 3.5 14.2 4.7 7.5 13.7 8.9 20.4 8.9h22.3c6.7 0 15.7-1.5 20.4-8.9 2.5-4 3.4-9.3 3.5-14.2 0 0 0-29 0-34.7zm-14.3 44.8c-2.2 2.1-5.8 3.2-11 3.2h-19.4c-5.2 0-8.8-1-11-3.2s-3.2-5.7-3.2-10.6v-2.4c0-5 1.1-8.5 3.3-10.6s5.8-3.2 11-3.2h33.6v16.2c0 4.9-1.1 8.4-3.3 10.6z"/><path d="m317.8 27.2h-11.5l-27.9 72.6-27.9-72.6h-11.4l33.6 87.5-10.1 26.3h11.5z"/><path d="m392.2 56.9c0-1.2 0-12.5-8-20.4-5.1-5-13.2-9.1-26.4-9.3h-1.2c-13.2.2-21.3 4.3-26.4 9.3-8 7.9-8 19.2-8 20.4v57.9h11v-58.2c0-4.1 1.3-9.4 5.4-13.4 3.4-3.3 9.9-5.9 18.6-6 8.7.1 15.2 2.7 18.6 6 4 4 5.4 9.3 5.4 13.4v58.2h11c0-4.5 0-56.5 0-57.9z"/><path d="m791 36.5c-5.1-5-13.2-9.1-26.4-9.3h-1.2c-13.2.2-21.3 4.3-26.4 9.3-8 7.9-8 19.2-8 20.4v28.2c0 1.2 0 12.5 8 20.4 5.1 5 13.2 9.1 26.4 9.3h26v-10h-25.4c-8.7-.1-15.2-2.7-18.6-6-4-4-5.4-9.3-5.4-13.4v-10.3h59v-18.2c.1-1.2.1-12.5-8-20.4zm-50.9 28.7v-8.6c0-4.1 1.3-9.4 5.4-13.4 3.4-3.3 9.9-5.9 18.6-6 8.7.1 15.2 2.7 18.6 6 4 4 5.4 9.3 5.4 13.4v8.6z"/></g><g><path d="m47.7 12.7c-1.8 9.5-4 23.6-5.2 37.9-2.1 25.2-.8 42.1-.8 42.1l-35.5 33.7s-2.7-18.9-4.1-40.2c-.8-13.2-1.1-24.8-1.1-31.8 0-.4.2-.8.2-1.2 0-.5.6-5.2 5.2-9.6 5-4.8 41.9-33.7 41.3-30.9z" fill="#1496ff"/><path d="m47.7 12.7c-1.8 9.5-4 23.6-5.2 37.9 0 0-39.3-4.7-41.5 4.8 0-.5.7-6.3 5.3-10.7 5-4.8 42-34.8 41.4-32z" fill="#1284ea"/><path d="m1 53.1v2.2c.4-1.7 1.1-2.9 2.5-4.8 2.9-3.7 7.6-4.7 9.5-4.9 9.6-1.3 23.8-2.8 38.1-3.2 25.3-.8 42 1.3 42 1.3l35.5-33.7s-18.6-3.5-39.8-6c-13.9-1.7-26.1-2.6-33-3-.5 0-5.4-.6-10 3.8-5 4.8-30.4 28.9-40.6 38.6-4.6 4.4-4.2 9.3-4.2 9.7z" fill="#b4dc00"/><path d="m127.3 96.2c-9.6 1.3-23.8 2.9-38.1 3.4-25.3.8-42.1-1.3-42.1-1.3l-35.5 33.8s18.8 3.7 40 6.1c13 1.5 24.5 2.3 31.5 2.7.5 0 1.3-.4 1.8-.4s5.4-.9 10-5.3c5-4.8 35.2-39.3 32.4-39z" fill="#6f2da8"/><path d="m127.3 96.2c-9.6 1.3-23.8 2.9-38.1 3.4 0 0 2.7 39.5-6.8 41.2.5 0 7-.3 11.6-4.7 5-4.8 36.1-40.2 33.3-39.9z" fill="#591f91"/><path d="m84.5 141c-.7 0-1.4-.1-2.2-.1 1.8-.3 3-.9 4.9-2.3 3.8-2.7 5-7.4 5.4-9.3 1.7-9.5 4-23.6 5.1-37.9 2-25.2.8-42 .8-42l35.5-33.8s2.6 18.8 4.1 40.1c.9 13.9 1.2 26.2 1.3 33 0 .5.4 5.4-4.2 9.8-5 4.8-30.4 29-40.5 38.7-4.8 4.4-9.7 3.8-10.2 3.8z" fill="#73be28"/></g></svg>
