<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Full Page Analysis — {{PAGE_TITLE}}</title>
<style>{{STRATO_TOKENS}}</style>
<style>
  body { background: var(--dt-bg-base); color: var(--dt-text-primary);
         font-family: var(--dt-font-sans); margin: 0; padding: var(--dt-space-32); }
  .panel { background: var(--dt-bg-container); border: 1px solid var(--dt-border-default);
           border-radius: var(--dt-radius); padding: var(--dt-space-16);
           margin-bottom: var(--dt-space-32); }
  h1, h2 { font-weight: 600; margin: 0 0 var(--dt-space-16); }
  h2 { font-size: var(--wf-text-title); }
  .example-note { color: var(--dt-warning); font-size: var(--wf-text-body); }
</style>
<style>
  /* v1 custom properties, remapped onto the Strato tokens above.
     Redefined here rather than edited rule-by-rule, so the ported waterfall
     rules are unchanged from assets/template.html.
     v1 was a dark theme; Strato's are the light-theme roles, so the surface
     ramp inverts. Derived shades use color-mix over the tokens — no new hex. */
  :root {
    --bg-page:                   var(--dt-bg-base);
    --bg-surface:                var(--dt-bg-container-subtle);
    --bg-container:              var(--dt-bg-container);
    --bg-container-subdued:      var(--dt-bg-container-subtle);
    --bg-container-emphasized:   color-mix(in srgb, var(--dt-border-default) 45%, var(--dt-bg-container));
    --bg-container-primary:      color-mix(in srgb, var(--dt-primary) 8%, var(--dt-bg-base));
    --border-default:            var(--dt-border-default);
    --border-subdued:            color-mix(in srgb, var(--dt-border-default) 55%, var(--dt-bg-base));
    --text-default:              var(--dt-text-primary);
    --text-subdued:              var(--dt-text-secondary);
    --text-disabled:             color-mix(in srgb, var(--dt-text-secondary) 55%, var(--dt-bg-base));
    --good:                      var(--dt-success);
    --warning:                   var(--dt-warning);
    --critical:                  var(--dt-critical);

    /* One type ramp replaces the ad-hoc 9/10/11/12/13/15/18/20px sizes. */
    --wf-text-micro: 10px;   /* type column, tick labels, tooltip keys */
    --wf-text-small: 12px;   /* secondary / dense labels */
    --wf-text-body:  13px;   /* body */
    --wf-text-lead:  16px;   /* emphasised numbers */
    --wf-text-title: 20px;   /* section headings (h2) */
    --wf-text-display: 24px; /* report heading (h1) */
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg-page);
    color: var(--text-default);
    font-family: var(--dt-font-sans);
    font-size: var(--wf-text-body);
    padding: var(--dt-space-32);
  }
  .page-wrap { max-width: 1400px; margin: 0 auto; }
  h1 { font-size: var(--wf-text-display); margin: 0 0 4px; }
  .subtitle { color: var(--text-subdued); font-size: var(--wf-text-small); margin-bottom: var(--dt-space-32); }
  .small { font-size: var(--wf-text-small); }
  .subdued { color: var(--text-subdued); }

  /* ── Metrics panel ─────────────────────────────────────────── */
  .metrics-row { display: flex; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .metric-tile {
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    padding: var(--dt-space-16);
    flex: 1;
    min-width: 100px;
  }
  .metric-tile .label { color: var(--text-subdued); font-size: var(--wf-text-small); display: block; margin-bottom: 4px; }
  .metric-tile .value { font-size: var(--wf-text-lead); font-weight: 600; margin: 0; font-variant-numeric: tabular-nums; }
  .metric-tile .sub { color: var(--text-subdued); font-size: var(--wf-text-small); display: block; margin-top: 2px; }

  .ttfb-breakdown { margin-top: 8px; margin-bottom: 16px; }
  .ttfb-bar { display: flex; height: 16px; border-radius: 3px; overflow: hidden; gap: 1px; }
  .ttfb-legend { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .ttfb-legend-item { display: flex; align-items: center; gap: 4px; }
  .swatch { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }

  .context-box {
    margin-top: var(--dt-space-16);
    margin-bottom: var(--dt-space-16);
    padding: var(--dt-space-8) var(--dt-space-16);
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
  .context-item { display: flex; gap: 6px; }

  .findings-title { color: var(--text-subdued); font-size: var(--wf-text-small); margin-bottom: 8px; display: block; }
  .findings-row { display: flex; flex-wrap: wrap; gap: var(--dt-space-8); margin-bottom: var(--dt-space-16); }
  .finding-tile {
    display: flex; align-items: center; gap: 8px;
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    padding: 8px 12px;
    flex: 1 1 180px;
    min-width: 160px;
  }
  .finding-tile .fv { font-size: var(--wf-text-lead); font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .finding-tile .fv.warn { color: var(--warning); }

  /* ── Controls ──────────────────────────────────────────────── */
  .controls-row { display: flex; gap: var(--dt-space-16); margin-bottom: var(--dt-space-8); flex-wrap: wrap; align-items: flex-start; }
  .control-group { display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .control-buttons { display: flex; gap: 6px; }
  .control-sep { width: 1px; align-self: stretch; background: var(--border-default); }
  .btn {
    appearance: none;
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    color: var(--text-default);
    border-radius: 4px;
    padding: 5px 10px;
    font-size: var(--wf-text-small);
    cursor: pointer;
    line-height: 1.2;
  }
  .btn:hover:not(:disabled) { background: var(--bg-container-emphasized); }
  .btn.active { background: color-mix(in srgb, var(--dt-primary) 12%, var(--dt-bg-base)); border-color: var(--dt-primary); color: var(--dt-primary); font-weight: 600; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ── Waterfall ─────────────────────────────────────────────── */
  .waterfall { position: relative; width: 100%; border: 1px solid var(--border-default); border-radius: var(--dt-radius); overflow: hidden; }
  .wf-header {
    display: flex;
    height: 64px;
    border-bottom: 2px solid var(--border-default);
    background: var(--bg-surface);
    position: relative;
  }
  .col-label { width: 300px; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: flex-end; padding-left: 8px; padding-bottom: 6px; }
  .col-type  { width: 40px; flex-shrink: 0; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 6px; }
  .col-dur   { width: 80px; flex-shrink: 0; box-sizing: border-box; text-align: right; padding-right: 16px; padding-bottom: 6px; align-self: flex-end; }
  .col-timeline-hd { flex: 1; position: relative; align-self: stretch; z-index: 10; }

  .pill {
    position: absolute;
    transform: translateX(-50%);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 3px;
    padding: 1px 5px;
    font-size: var(--wf-text-micro);
    letter-spacing: 0.07em;
    white-space: nowrap;
    line-height: 14px;
    cursor: crosshair;
    user-select: none;
  }
  .sticky-pills {
    position: fixed;
    top: 4px;
    left: 0;
    right: 0;
    height: 0;
    z-index: 100;
    pointer-events: none;
    display: none;
  }
  .sticky-pills .pill { pointer-events: auto; position: absolute; }

  .tick-label { position: absolute; bottom: 6px; padding-left: 3px; font-size: var(--wf-text-micro); color: var(--text-subdued); white-space: nowrap; }

  .wf-body { position: static; }
  .wf-overlay { position: absolute; top: 0; bottom: 0; right: 0; }
  .origin-line, .tick-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--border-subdued); pointer-events: none; }
  .phase-line-hit { position: absolute; top: 0; bottom: 0; width: 8px; cursor: crosshair; pointer-events: auto; }
  .phase-line-hit .phase-line { position: absolute; left: 3px; top: 0; bottom: 0; width: 1px; background: color-mix(in srgb, var(--dt-text-secondary) 60%, transparent); pointer-events: none; }
  .longtask-block { position: absolute; top: 0; bottom: 0; background: color-mix(in srgb, var(--critical) 10%, transparent); pointer-events: none; }
  .ex-marker { position: absolute; top: 0; bottom: 0; cursor: crosshair; }
  .ex-line { position: absolute; top: 0; bottom: 0; width: 1px; background: var(--critical); pointer-events: none; }

  .wf-section-header {
    display: flex; align-items: center; height: 26px;
    background: var(--bg-container);
    border-bottom: 1px solid var(--border-default);
  }
  .wf-section-header .lbl {
    width: 420px; flex-shrink: 0; padding-left: 8px;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--wf-text-micro);
  }
  .wf-section-header .rule { flex: 1; height: 1px; background: var(--border-subdued); }

  .wf-row { display: flex; align-items: center; height: 26px; border-bottom: 1px solid var(--border-subdued); }
  /* Zebra flattened: the per-row hairline already carries the scan line.
     Classes retained — renderWaterfall still emits them. */
  .wf-row.even, .wf-row.odd { background: var(--bg-page); }
  .wf-row.lcp  { box-shadow: inset 3px 0 0 var(--warning); }
  .wf-row.pending { background-image: repeating-linear-gradient(45deg, color-mix(in srgb, var(--warning) 18%, transparent) 0px, color-mix(in srgb, var(--warning) 18%, transparent) 4px, transparent 4px, transparent 10px); }
  .wf-row:hover { background: var(--bg-container-primary) !important; background-image: none !important; }

  .cell-label {
    width: 300px; flex-shrink: 0; box-sizing: border-box;
    padding-left: 8px; padding-right: 4px; overflow: hidden;
    line-height: 26px; display: flex; align-items: center; gap: 4px;
    white-space: nowrap; text-overflow: ellipsis;
  }
  .cell-label .url { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-subdued); }
  .wf-row:hover .cell-label .url:not(.err) { color: var(--text-default); }
  .cell-label .url.err { color: var(--critical) !important; }
  .cell-type { width: 40px; flex-shrink: 0; text-align: center; font-size: var(--wf-text-micro); text-transform: uppercase; line-height: 26px; }
  .cell-dur  { width: 80px; flex-shrink: 0; box-sizing: border-box; text-align: right; padding-right: 16px; line-height: 26px; color: var(--text-subdued); overflow: hidden; white-space: nowrap; }
  .cell-dur.err { color: var(--critical); }
  .wf-row:hover .cell-dur:not(.err) { color: var(--text-default); }

  .cell-timeline { flex: 1; position: relative; height: 100%; overflow: hidden; }
  .bar { position: absolute; top: 4px; bottom: 4px; min-width: 2px; cursor: crosshair; }

  /* The action bar is the envelope the resource rows sit inside, not a
     request — lighter fill + outline in the brand accent (unused elsewhere
     in the waterfall body) keeps it from outweighing the rows beneath it. */
  .wf-action-row { background: var(--bg-surface); border-bottom: 2px solid var(--border-default); font-weight: 600; }
  .wf-action-row .cell-label .url { color: var(--text-default); }
  .action-bar {
    top: 7px; bottom: 7px; border-radius: 3px;
    background: color-mix(in srgb, var(--dt-primary) 20%, transparent);
    border: 1px solid var(--dt-primary);
    box-sizing: border-box;
  }
  .stall-tick { position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: #8B96A5; pointer-events: none; }
  .stall-dash { position: absolute; left: 2px; right: 0; top: 50%; height: 0; border-top: 1px solid #8B96A5; pointer-events: none; }

  .legend { display: flex; flex-wrap: wrap; gap: var(--dt-space-16); padding-top: var(--dt-space-16); align-items: center; }
  .legend-item { display: flex; align-items: center; gap: 4px; }
  .legend-swatch { width: 10px; height: 10px; border-radius: 2px; }
  .legend-sep { width: 1px; height: 16px; background: var(--border-default); margin: 0 4px; }
  .legend-line { width: 2px; height: 10px; }

  .lcp-status { margin-top: var(--dt-space-16); display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .lcp-url { font-family: var(--dt-font-mono); word-break: break-all; color: var(--text-subdued); }

  .warn-banner {
    margin-bottom: 10px; padding: 7px 12px;
    background: color-mix(in srgb, var(--warning) 10%, transparent); border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
    border-radius: var(--dt-radius); text-align: center; color: var(--warning); font-weight: 700; font-size: var(--wf-text-small);
  }

  /* ── Tooltips ──────────────────────────────────────────────── */
  .tooltip {
    position: fixed;
    left: -9999px;
    top: -9999px;
    z-index: 9999;
    background: var(--bg-container);
    border: 1px solid var(--border-default);
    border-radius: var(--dt-radius);
    padding: var(--dt-space-8) var(--dt-space-16);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--dt-text-primary) 18%, transparent);
    pointer-events: none;
    display: none;
  }
  #tooltip { min-width: 260px; max-width: 360px; }
  #line-tooltip { min-width: 140px; }
  #ex-tooltip { max-width: 360px; border-color: color-mix(in srgb, var(--critical) 45%, var(--border-default)); }
  .tt-header { margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border-subdued); }
  .tt-badge-row { display: flex; align-items: center; gap: 6px; margin-bottom: 2px; }
  .tt-badge { font-size: var(--wf-text-micro); font-weight: 700; border-radius: 2px; padding: 0 4px; line-height: 14px; flex-shrink: 0; }
  .tt-title { font-size: var(--wf-text-small); font-weight: 600; color: var(--text-default); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tt-meta-table { border-collapse: collapse; width: 100%; margin-top: 6px; }
  .tt-meta-table td { font-size: var(--wf-text-micro); padding-right: 8px; white-space: nowrap; }
  .tt-meta-table td.v { color: var(--text-default); white-space: normal; word-break: break-all; }
  .tt-meta-table td.k { color: var(--text-subdued); }
  .tt-csp-badge { font-size: var(--wf-text-micro); font-weight: 700; color: var(--warning); background: color-mix(in srgb, var(--warning) 12%, transparent); border: 1px solid color-mix(in srgb, var(--warning) 40%, transparent); border-radius: 2px; padding: 1px 5px; display: inline-block; margin-top: 4px; }
  .tt-table { border-collapse: collapse; width: 100%; }
  .tt-sec-hd td { padding-top: 6px; padding-bottom: 3px; font-size: var(--wf-text-micro); font-weight: 700; color: var(--text-subdued); letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid var(--border-subdued); }
  .tt-row td { font-size: var(--wf-text-small); padding-bottom: 2px; }
  .tt-row td.k { color: var(--text-subdued); padding-right: 8px; white-space: nowrap; }
  .tt-row td.v { color: var(--text-default); text-align: right; }
  .tt-swatch-cell { width: 10px; padding-right: 4px; vertical-align: middle; }
  .tt-swatch { width: 8px; height: 8px; border-radius: 1px; }
  .tt-marker-row { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; }
  .tt-marker-line { width: 3px; height: 14px; border-radius: 1px; flex-shrink: 0; }
  .tt-marker-label { font-size: var(--wf-text-small); font-weight: 700; min-width: 36px; }
  .tt-marker-value { font-size: var(--wf-text-small); color: var(--text-default); }
  /* Sampled-load title inside the waterfall panel. v1 rendered this as the page
     <h1>; here the panel <h2> owns the heading, so this is a lead-sized label. */
  .wf-instance-title { font-size: var(--wf-text-lead); font-weight: 600; margin-bottom: 2px; }

  /* ── Aggregate sections ────────────────────────────────────────
     One table idiom for all five aggregate tables. Deliberately the same
     row language as the waterfall: 26px-ish rows, a hairline per row rather
     than zebra, the same hover wash, tabular numerals on every figure. */
  .panel-note { color: var(--text-subdued); font-size: var(--wf-text-small); margin: -8px 0 var(--dt-space-16); }
  .panel-note strong { color: var(--text-default); font-variant-numeric: tabular-nums; }
  .table-scroll { overflow-x: auto; }
  .agg-table { width: 100%; border-collapse: collapse; font-size: var(--wf-text-small); }
  .agg-table th {
    text-align: left; padding: 0 8px 6px; white-space: nowrap;
    font-size: var(--wf-text-micro); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--text-subdued); border-bottom: 1px solid var(--border-default);
  }
  .agg-table td { padding: 5px 8px; border-bottom: 1px solid var(--border-subdued); vertical-align: middle; }
  .agg-table tbody tr:last-child td { border-bottom: none; }
  .agg-table tbody tr:hover { background: var(--bg-container-primary); }
  /* width: 1% shrinks numeric columns to their content, so the slack lands in
     the label column and the figures stay a single scannable block on the
     right instead of drifting apart as the viewport widens. */
  .agg-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; width: 1%; }
  .agg-table .lead { font-size: var(--wf-text-body); font-weight: 600; }
  .agg-table .path { font-family: var(--dt-font-mono); color: var(--text-default); white-space: nowrap; }
  .agg-table .nil { color: var(--text-disabled); }

  /* Coverage meter — the report's one signature device, and the reason v2
     exists: it turns "loads" from a numeric column you skim past into a bar
     you scan down. Neutral ink, not a status hue: prevalence is not good or
     bad, it is how much of the population a row speaks for. The figure is
     always printed beside the bar, so the bar never carries the value alone. */
  .cov { display: flex; align-items: center; gap: 8px; min-width: 190px; }
  .cov-track {
    position: relative; flex: 1 1 70px; min-width: 56px; height: 9px;
    border-radius: 5px; background: var(--dt-bg-base);
    border: 1px solid color-mix(in srgb, var(--dt-text-secondary) 30%, var(--dt-border-default));
    overflow: hidden;
  }
  .cov-fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--text-subdued); }
  .cov-text { font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--text-default); }
  .cov-text .of { color: var(--text-subdued); }
  .chip {
    display: inline-block; border: 1px solid var(--border-default); border-radius: 3px;
    padding: 0 4px; font-size: var(--wf-text-micro); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-subdued);
    background: var(--bg-surface); white-space: nowrap;
  }
  .chip.rare { border-color: color-mix(in srgb, var(--dt-text-secondary) 45%, var(--dt-border-default)); }

  .rating { font-weight: 600; }
  .rating .word { font-size: var(--wf-text-micro); text-transform: uppercase; letter-spacing: 0.06em; margin-left: 6px; }

  /* TTFB phase bar. Five ordered stages of one duration, so a single-hue
     sequential ramp keyed to time order, not five categorical hues — there is
     no five-hue token set here, and stage order is real information. Adjacent
     steps sit ~1.3:1 apart, so separation comes from the 2px surface gap and
     the direct-labelled legend, never from hue alone. Every step clears 3:1
     against the panel surface, so the thinnest segment is still visible. */
  .ttfb-bar { gap: 2px; height: 20px; border-radius: 4px; background: var(--bg-surface); }
  .ttfb-legend { gap: 4px 20px; margin-top: 10px; font-size: var(--wf-text-small); }
  .ttfb-legend-item .k { color: var(--text-subdued); }
  .ttfb-legend-item .v { font-variant-numeric: tabular-nums; font-weight: 600; }

  .empty-note { color: var(--text-subdued); font-size: var(--wf-text-small); font-style: italic; }
  .skipped-banner {
    padding: var(--dt-space-8) var(--dt-space-16); margin-bottom: var(--dt-space-16);
    border-radius: var(--dt-radius); font-size: var(--wf-text-small);
    color: var(--warning); background: color-mix(in srgb, var(--warning) 8%, var(--dt-bg-base));
    border: 1px solid color-mix(in srgb, var(--warning) 45%, transparent);
  }
  .skipped-banner code { font-family: var(--dt-font-mono); }
</style>
</head>
<body>
<h1>Full Page Analysis — {{PAGE_TITLE}}</h1>
<p>Generated {{GENERATED_AT}}</p>

<div id="skipped-slot"></div>

<!-- Aggregate sections. Every figure below is cross-session; the waterfall at
     the foot of the page is the only single-load view in the report. Each
     renderer writes into its own slot id, matching the waterfall's contract. -->
<section class="panel" id="cwv-panel">
  <h2>Core Web Vitals</h2>
  <p class="panel-note" id="cwv-note"></p>
  <div class="table-scroll" id="cwv-slot"></div>
</section>

<section class="panel" id="ttfb-panel">
  <h2>Time to first byte phases</h2>
  <p class="panel-note" id="ttfb-note"></p>
  <div id="ttfb-slot"></div>
</section>

<section class="panel" id="slowest-panel">
  <h2>Slowest resources</h2>
  <p class="panel-note" id="slowest-note"></p>
  <div class="table-scroll" id="slowest-slot"></div>
</section>

<section class="panel" id="heaviest-panel">
  <h2>Heaviest resources</h2>
  <p class="panel-note" id="heaviest-note"></p>
  <div class="table-scroll" id="heaviest-slot"></div>
</section>

<section class="panel" id="thirdparty-panel">
  <h2>Third-party domains</h2>
  <p class="panel-note" id="thirdparty-note"></p>
  <div class="table-scroll" id="thirdparty-slot"></div>
</section>

<section class="panel" id="mainthread-panel">
  <h2>Long tasks and errors</h2>
  <p class="panel-note" id="mainthread-note"></p>
  <div id="longtasks-slot"></div>
  <div id="errors-slot"></div>
</section>

<section class="panel" id="browserdevice-panel">
  <h2>Browser and device</h2>
  <p class="panel-note" id="browserdevice-note"></p>
  <div class="table-scroll" id="browserdevice-slot"></div>
</section>

<section class="panel" id="waterfall-panel">
  <h2>Resource waterfall</h2>
  <p class="example-note">Single example load — not a page-wide measurement.</p>
  <!-- Slot ids are a hard contract with the ported renderers: renderControls
       writes to #controls-slot, renderWaterfall to #waterfall-slot,
       #longtask-labels-slot, #legend-slot and #lcp-slot, and the hover handlers
       to #tooltip, #line-tooltip and #ex-tooltip. Renaming any of them breaks
       the port silently. #metrics-slot and #findings-slot are deliberately
       absent — Phase 2 and Phase 3 replace those two panels.
       #page-title / #page-subtitle are also part of the contract: the ported
       static-header block at template.html:507-510 writes into them by id and
       throws on null, which would abort every renderer below it. They carry the
       sampled load's own title and its browser/device/timestamp context, which
       is panel-scoped information, so they live inside the panel. -->
  <div id="page-title" class="wf-instance-title"></div>
  <div id="page-subtitle" class="subtitle"></div>
  <div id="warn-banner-slot"></div>
  <div id="controls-slot"></div>
  <div id="waterfall-slot"></div>
  <div id="longtask-labels-slot"></div>
  <div id="legend-slot"></div>
  <div id="lcp-slot"></div>
</section>
<div id="tooltip" class="tooltip"></div>
<div id="line-tooltip" class="tooltip"></div>
<div id="ex-tooltip" class="tooltip"></div>

<script src="chart.umd.min.js"></script>
<script>
const DATA = {{DATA_JSON}};
const { summary, requests, exceptions, action } = DATA.instance;

// ─── Formatting helpers ──────────────────────────────────────────────
const formatMs = (ms) => {
  if (ms >= 1000) return (ms / 1000).toFixed(2) + " s";
  if (ms < 1) return "< 1ms";
  return parseFloat(ms.toFixed(1)) + " ms";
};
const formatBytes = (b) => {
  if (b >= 1_000_000) return (b / 1_000_000).toFixed(2) + " MB";
  if (b >= 1_000) return (b / 1_000).toFixed(1) + " KB";
  return b + " B";
};
const escHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

// ─── Resource type / color resolution ────────────────────────────────
const STALL_COLOR = "#8B96A5";
const RESOURCE_COLORS = {
  document:       { light: "#93C5FD", dark: "#1F6FD1" },
  navigation:     { light: "#93C5FD", dark: "#1F6FD1" },
  stylesheet:     { light: "#B07BFF", dark: "#7D4CC7" },
  script:         { light: "#FFE15A", dark: "#C9A300" },
  font:           { light: "#42D9E8", dark: "#1399A5" },
  image:          { light: "#7BE06A", dark: "#43A83A" },
  fetch:          { light: "#FFB15A", dark: "#D97800" },
  xmlhttprequest: { light: "#FFB15A", dark: "#D97800" },
  xhr:            { light: "#FFB15A", dark: "#D97800" },
  beacon:         { light: "#FF75C8", dark: "#C44291" },
  media:          { light: "#B8BDC6", dark: "#7A818C" },
  other:          { light: "#B8BDC6", dark: "#7A818C" },
};
const EXT_TYPE_MAP = {
  js: "script", mjs: "script", cjs: "script",
  css: "stylesheet",
  html: "document", htm: "document",
  png: "image", jpg: "image", jpeg: "image", gif: "image",
  webp: "image", avif: "image", svg: "image", ico: "image",
  woff: "font", woff2: "font", ttf: "font", otf: "font",
  mp4: "media", webm: "media", mp3: "media",
  json: "fetch", xml: "fetch",
};
const typeFromExtension = (path) => {
  if (!path) return null;
  const clean = path.split("?")[0];
  const segs = clean.split(".");
  for (let i = segs.length - 1; i >= 1 && i >= segs.length - 3; i--) {
    const mapped = EXT_TYPE_MAP[segs[i].toLowerCase()];
    if (mapped) return mapped;
  }
  const tail = (clean.split("/").pop() || "").match(/([a-z0-9]+)$/i);
  if (tail) return EXT_TYPE_MAP[tail[1].toLowerCase()] || null;
  return null;
};
const resolveType = (req) => {
  const fromExt = typeFromExtension(req.urlPath) || typeFromExtension(req.urlFull || "");
  if (fromExt) return fromExt;
  const raw = req.performanceInitiatorType;
  return raw ? raw.toLowerCase() : "other";
};
// The palette's `light` values are bright-on-dark tints from the v1 dark canvas;
// on the light canvas they drop to ~1.3:1 and the phase reads as a gap. Derive the
// light phase from the same categorical hue instead. RESOURCE_COLORS is unmodified
// and `dark` — the hue that identifies the type — is passed through untouched.
const resourceColors = (req) => {
  const pair = RESOURCE_COLORS[resolveType(req)] || RESOURCE_COLORS.other;
  return { dark: pair.dark, light: `color-mix(in srgb, ${pair.dark} 35%, var(--dt-bg-base))` };
};
const RESOURCE_LABELS = {
  document: "Doc", navigation: "Nav", script: "JS", stylesheet: "CSS",
  image: "Img", fetch: "XHR", xmlhttprequest: "XHR", xhr: "XHR",
  font: "Font", media: "Media", beacon: "Beacon",
};
const resourceLabel = (req) => {
  const t = resolveType(req);
  return RESOURCE_LABELS[t] || (t.slice(0, 4) || "Other");
};
const isCacheLike = (r) => r.incompleteReason === "local_cache" ||
  (r.transferSize !== null && r.transferSize === 0) ||
  (r.deliveryType != null && r.deliveryType.toLowerCase().includes("cache"));

// ─── Phase markers ────────────────────────────────────────────────────
const ttfbPositionMs = summary.ttfbMs ?? null;
const buildPhaseMarkers = () => ([
  { key: "ttfb", label: "TTFB", color: "#1D4ED8", valueMs: ttfbPositionMs },
  { key: "fp",   label: "FP",   color: "#0E7490", valueMs: summary.fpMs },
  { key: "fcp",  label: "FCP",  color: "#047857", valueMs: summary.fcpMs },
  { key: "lcp",  label: "LCP",  color: "#B45309", valueMs: summary.lcpMs },
]).filter((m) => m.valueMs !== null && m.valueMs > 0);

const MERGE_THRESHOLD_PCT = 0.025;
const groupPhaseMarkers = (markers, maxMs) => {
  const sorted = [...markers].sort((a, b) => a.valueMs - b.valueMs);
  const threshold = maxMs * MERGE_THRESHOLD_PCT;
  const groups = [];
  for (const m of sorted) {
    const last = groups[groups.length - 1];
    if (last && m.valueMs - last.valueMs < threshold) {
      last.markers.push(m);
    } else {
      groups.push({ valueMs: m.valueMs, color: m.color, markers: [m] });
    }
  }
  return groups;
};

const buildTicks = (maxMs) => {
  const targets = [100, 200, 250, 500, 750, 1000, 1250, 1500, 2000, 2500, 3000, 5000, 7500, 10000, 15000, 20000, 30000];
  const step = targets.find((t) => maxMs / t <= 10) ?? Math.ceil(maxMs / 8 / 500) * 500;
  const ticks = [];
  for (let t = step; t < maxMs; t += step) ticks.push(t);
  return ticks;
};

const lcpMatchesRequest = (lcpUrl, req) => {
  if (!lcpUrl) return false;
  if (req.urlFull && req.urlFull === lcpUrl) return true;
  if (req.urlPath && req.urlPath.length > 3 && lcpUrl.includes(req.urlPath)) return true;
  return false;
};

const buildWaterfallItems = (reqs, mode) => {
  if (mode === "chronological") {
    return reqs.map((req, i) => ({ kind: "row", req, origIdx: i, visualRowIdx: i }));
  }
  const sections = [
    { label: "Documents",   entries: [] },
    { label: "XHR / Fetch", entries: [] },
    { label: "Resources",   entries: [] },
  ];
  reqs.forEach((req, origIdx) => {
    const t = resolveType(req);
    if (t === "navigation" || t === "document") sections[0].entries.push({ req, origIdx });
    else if (t === "fetch" || t === "xmlhttprequest" || t === "xhr") sections[1].entries.push({ req, origIdx });
    else sections[2].entries.push({ req, origIdx });
  });
  const items = [];
  let visualRowIdx = 0;
  for (const { label, entries } of sections) {
    if (entries.length === 0) continue;
    items.push({ kind: "header", label });
    for (const { req, origIdx } of entries) items.push({ kind: "row", req, origIdx, visualRowIdx: visualRowIdx++ });
  }
  return items;
};

// ─── Layout constants ──────────────────────────────────────────────────
const LABEL_WIDTH = 300, TYPE_WIDTH = 40, DUR_WIDTH = 80, ROW_H = 26, BAR_INSET = 4;
const LABEL_ROW_0 = 4, PILL_HEIGHT = 16, TICK_BOTTOM = 6;
const LEFT_OFFSET = LABEL_WIDTH + TYPE_WIDTH + DUR_WIDTH;

const el = (tag, cls, html) => {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (html !== undefined) e.innerHTML = html;
  return e;
};

// ─── Static page header ────────────────────────────────────────────────
document.getElementById("page-title").textContent = summary.pageTitle || summary.pageUrl || "Page Waterfall";
document.getElementById("page-subtitle").textContent =
  `${summary.pageUrl || ""}  ·  ${summary.browserName} ${summary.browserVersion}  ·  ${summary.deviceType}  ·  ${new Date(summary.clientStartTimeMs).toLocaleString()}`;

const navRequest = requests.find((r) => r.performanceInitiatorType === "navigation" || resolveType(r) === "navigation" || resolveType(r) === "document");
if (navRequest && navRequest.incompleteReason && !isCacheLike(navRequest)) {
  document.getElementById("warn-banner-slot").appendChild(el("div", "warn-banner", "Invalid Timings"));
}

// ─── Metrics panel (static) ─────────────────────────────────────────────
const clsRating = (score) => score <= 0.1 ? "good" : score <= 0.25 ? "needs-improvement" : "poor";
const msRating = (ms, [good, ni]) => ms <= good ? "good" : ms <= ni ? "needs-improvement" : "poor";
const RATING_COLORS = { good: "var(--good)", "needs-improvement": "var(--warning)", poor: "var(--critical)", none: "var(--text-default)" };


// ─── Tooltip helpers ──────────────────────────────────────────────────
const ttEl = document.getElementById("tooltip");
const lineTtEl = document.getElementById("line-tooltip");
const exTtEl = document.getElementById("ex-tooltip");

function positionTooltip(node, x, y) {
  node.style.display = "block";
  // Measure off-screen-safe first
  const vw = window.innerWidth, vh = window.innerHeight;
  const rect = node.getBoundingClientRect();
  const width = rect.width, height = rect.height;
  node.style.left = (x >= vw / 2 ? x - width - 12 : x + 12) + "px";
  node.style.top  = (y >= vh / 2 ? y - height - 8 : y + 8) + "px";
}
function hideTooltip(node) { node.style.display = "none"; node.style.left = "-9999px"; node.style.top = "-9999px"; }

function buildResourceTooltipHtml(req, relativeStartMs) {
  const { light: lightColor, dark: color } = resourceColors(req);
  const isNavDoc = resolveType(req) === "navigation" || resolveType(req) === "document";
  const fetchStart = req.fetchStartNs ?? 0;

  const stallEndNs = (() => {
    if (req.domainLookupStartNs != null && req.domainLookupStartNs > fetchStart) return req.domainLookupStartNs;
    if (req.connectStartNs != null && req.connectStartNs > fetchStart) return req.connectStartNs;
    return req.requestStartNs ?? fetchStart;
  })();
  const trueStallMs = (stallEndNs - fetchStart) > 500 ? (stallEndNs - fetchStart) / 1e6 : null;

  const workerMs = req.workerStartNs != null && req.workerStartNs > 0 && req.fetchStartNs != null
    ? (req.fetchStartNs - req.workerStartNs) / 1e6 : null;
  const redirectMs = req.redirectStartNs != null && req.redirectEndNs != null && req.redirectEndNs > req.redirectStartNs
    ? (req.redirectEndNs - req.redirectStartNs) / 1e6 : null;
  const dnsMs = req.domainLookupStartNs != null && req.domainLookupEndNs != null
    ? (req.domainLookupEndNs - req.domainLookupStartNs) / 1e6 : null;
  const hasSsl = req.secureConnectionStartNs != null && req.secureConnectionStartNs > 0;
  const tcpMs = req.connectStartNs != null && req.connectEndNs != null
    ? (hasSsl && req.secureConnectionStartNs != null ? (req.secureConnectionStartNs - req.connectStartNs) : (req.connectEndNs - req.connectStartNs)) / 1e6
    : null;
  const sslMs = hasSsl && req.connectEndNs != null && req.secureConnectionStartNs != null
    ? (req.connectEndNs - req.secureConnectionStartNs) / 1e6 : null;
  const requestMs = req.requestStartNs != null && req.responseStartNs != null
    ? (req.responseStartNs - req.requestStartNs) / 1e6 : null;
  const responseMs = req.responseStartNs != null && req.responseEndNs != null
    ? (req.responseEndNs - req.responseStartNs) / 1e6 : null;

  const navBlockingMs = isNavDoc && req.connectEndNs != null && req.requestStartNs != null
    ? Math.max(0, (req.requestStartNs - req.connectEndNs) / 1e6) : null;
  const navAppCacheMs = isNavDoc && req.domainLookupStartNs != null && req.fetchStartNs != null
    ? Math.max(0, (req.domainLookupStartNs - req.fetchStartNs) / 1e6) : null;
  const navProcessMs = isNavDoc && req.domCompleteNs != null && req.responseEndNs != null
    ? Math.max(0, (req.domCompleteNs - req.responseEndNs) / 1e6) : null;
  const navOnDclMs = isNavDoc && req.domContentLoadedEventEndNs != null && req.domContentLoadedEventStartNs != null
    ? Math.max(0, (req.domContentLoadedEventEndNs - req.domContentLoadedEventStartNs) / 1e6) : null;
  const navOnLoadMs = isNavDoc && req.loadEventEndNs != null && req.loadEventStartNs != null
    ? Math.max(0, (req.loadEventEndNs - req.loadEventStartNs) / 1e6) : null;

  const isCompressed = req.encodedBodySize != null && req.decodedBodySize != null && req.decodedBodySize > req.encodedBodySize + 100;
  const cached = isCacheLike(req);

  const sectionHd = (label) => `<tr class="tt-sec-hd"><td colspan="3">${escHtml(label)}</td></tr>`;
  const row = (label, value, swatch) => {
    if (value == null) return "";
    return `<tr class="tt-row"><td class="tt-swatch-cell">${swatch ? `<div class="tt-swatch" style="background:${swatch}"></div>` : ""}</td><td class="k">${escHtml(label)}</td><td class="v">${escHtml(value)}</td></tr>`;
  };

  let html = `<div class="tt-header">
    <div class="tt-badge-row">
      <span class="tt-badge" style="color:${color};background:${color}22;border:1px solid ${color}66">${escHtml(resourceLabel(req))}</span>
      <span class="tt-title">${escHtml(req.urlPath || "/")}</span>
    </div>
    <table class="tt-meta-table"><tbody>`;
  if (req.urlDomain) html += `<tr><td class="k">Domain</td><td class="v">${escHtml(req.urlDomain)}</td></tr>`;
  if (req.httpMethod) html += `<tr><td class="k">Method</td><td class="v">${escHtml(req.httpMethod)}</td></tr>`;
  if (req.protocol) html += `<tr><td class="k">Protocol</td><td class="v">${escHtml(req.protocol)}</td></tr>`;
  if (req.httpStatusCode != null) html += `<tr><td class="k">Status</td><td class="v" style="color:${req.hasFailed ? "var(--critical)" : ""}">${req.httpStatusCode}</td></tr>`;
  if (req.urlProvider) html += `<tr><td class="k">Provider</td><td class="v">${escHtml(req.urlProvider)}</td></tr>`;
  html += `</tbody></table>`;
  if (req.hasCspViolation) html += `<div class="tt-csp-badge">CSP VIOLATION</div>`;
  html += `</div>`;

  html += `<table class="tt-table"><tbody>`;
  html += sectionHd("Timing");
  html += row("Load time", formatMs(req.durationMs));
  html += row("Started at", formatMs(relativeStartMs));
  if (req.renderBlockingStatus === "blocking") html += row("Render blocking", "yes");

  if (isNavDoc && req.hasW3cTimings && req.requestStartNs !== null) {
    html += `<tr><td colspan="3" style="padding-top:2px"></td></tr>`;
    html += sectionHd("Phases");
    if (navBlockingMs != null) html += row("Blocking", formatMs(navBlockingMs), STALL_COLOR);
    if (navAppCacheMs != null) html += row("Application cache", formatMs(navAppCacheMs), "#9CA3AF");
    if (dnsMs != null) html += row("DNS lookup", formatMs(dnsMs), "#06B6D4");
    if (tcpMs != null) html += row("TCP connect", formatMs(tcpMs), "#F59E0B");
    if (sslMs != null) html += row("TLS", formatMs(sslMs), "#8B5CF6");
    if (requestMs != null) html += row("Request", formatMs(requestMs), lightColor);
    if (responseMs != null) html += row("Response", formatMs(responseMs), color);
    if (navProcessMs != null) html += row("Processing", formatMs(navProcessMs), "#7C3AED");
    if (navOnDclMs != null) html += row("onDCL", formatMs(navOnDclMs), "#7C3AED");
    if (navOnLoadMs != null) html += row("onLoad", formatMs(navOnLoadMs), "#34D399");
  }

  if (!isNavDoc && req.hasW3cTimings && req.requestStartNs !== null) {
    html += `<tr><td colspan="3" style="padding-top:2px"></td></tr>`;
    html += sectionHd("Phases");
    if (workerMs != null && workerMs > 0) html += row("Service worker", formatMs(workerMs), "#7C3AED");
    if (redirectMs != null && redirectMs > 0) html += row("Redirect", formatMs(redirectMs), "#9CA3AF");
    if (trueStallMs != null && trueStallMs > 0) html += row("Stalled", formatMs(trueStallMs), STALL_COLOR);
    if (dnsMs != null && dnsMs > 0) html += row("DNS", formatMs(dnsMs), "#06B6D4");
    if (tcpMs != null && tcpMs > 0) html += row("TCP", formatMs(tcpMs), "#F59E0B");
    if (sslMs != null && sslMs > 0) html += row("TLS", formatMs(sslMs), "#8B5CF6");
    if (requestMs != null && requestMs > 0) html += row("Request", formatMs(requestMs), lightColor);
    if (responseMs != null && responseMs > 0) html += row("Response", formatMs(responseMs), color);
  }

  if (isNavDoc && (!req.hasW3cTimings || req.requestStartNs === null) && summary.ttfbMs != null) {
    html += `<tr><td colspan="3" style="padding-top:2px"></td></tr>`;
    html += sectionHd("Phases");
    if (summary.ttfbDnsMs != null && summary.ttfbDnsMs > 0) html += row("DNS", formatMs(summary.ttfbDnsMs), "#06B6D4");
    if (summary.ttfbConnectionMs != null && summary.ttfbConnectionMs > 0) html += row("TCP/TLS", formatMs(summary.ttfbConnectionMs), "#F59E0B");
    if (summary.ttfbCacheMs != null && summary.ttfbCacheMs > 0) html += row("Cache", formatMs(summary.ttfbCacheMs), "#9CA3AF");
    if (summary.ttfbRequestMs != null && summary.ttfbRequestMs > 0) html += row("Request", formatMs(summary.ttfbRequestMs), lightColor);
    if (summary.ttfbWaitingMs != null && summary.ttfbWaitingMs > 0) html += row("Waiting", formatMs(summary.ttfbWaitingMs), lightColor);
    const downloadMs = req.durationMs - summary.ttfbMs;
    if (downloadMs > 0) html += row("Response", formatMs(downloadMs), color);
  }

  html += `<tr><td colspan="3" style="padding-top:2px"></td></tr>`;
  html += sectionHd("Transfer");
  html += `<tr class="tt-row"><td class="tt-swatch-cell"></td><td class="k">Cached</td><td class="v" style="color:${cached ? "var(--good)" : "var(--critical)"}">${cached ? (req.incompleteReason === "local_cache" ? "local cache" : "yes") : "no"}</td></tr>`;
  if (isCompressed && req.encodedBodySize != null && req.decodedBodySize != null) {
    html += row("Compression", `${Math.round((1 - req.encodedBodySize / req.decodedBodySize) * 100)}%`);
  }
  if (req.transferSize != null) html += row("Transfer", formatBytes(req.transferSize));
  if (req.encodedBodySize != null) html += row("Encoded", formatBytes(req.encodedBodySize));
  if (req.decodedBodySize != null) html += row("Decoded", formatBytes(req.decodedBodySize));
  html += `</tbody></table>`;
  return html;
}

function attachBarHover(barNode, req, relativeStartMs) {
  barNode.addEventListener("mouseenter", (e) => {
    hideTooltip(lineTtEl); hideTooltip(exTtEl);
    ttEl.innerHTML = buildResourceTooltipHtml(req, relativeStartMs);
    positionTooltip(ttEl, e.clientX, e.clientY);
  });
  barNode.addEventListener("mousemove", (e) => positionTooltip(ttEl, e.clientX, e.clientY));
  barNode.addEventListener("mouseleave", () => hideTooltip(ttEl));
}

function attachLineHover(node, group) {
  node.addEventListener("mouseenter", (e) => {
    e.stopPropagation();
    hideTooltip(ttEl);
    lineTtEl.innerHTML = group.markers.map((m) =>
      `<div class="tt-marker-row"><div class="tt-marker-line" style="background:${m.color}"></div><span class="tt-marker-label" style="color:${m.color}">${escHtml(m.label)}</span><span class="tt-marker-value">${formatMs(m.valueMs)}</span></div>`
    ).join("");
    positionTooltip(lineTtEl, e.clientX, e.clientY);
  });
  node.addEventListener("mousemove", (e) => { e.stopPropagation(); positionTooltip(lineTtEl, e.clientX, e.clientY); });
  node.addEventListener("mouseleave", () => hideTooltip(lineTtEl));
}

function attachExceptionHover(node, displayName) {
  node.addEventListener("mouseenter", (e) => {
    hideTooltip(lineTtEl); hideTooltip(ttEl);
    exTtEl.innerHTML = `<div style="display:flex;align-items:center;gap:6px;margin-bottom:4px">
      <svg width="12" height="12" viewBox="0 0 12 12" style="flex-shrink:0">
        <circle cx="6" cy="6" r="5.5" style="fill:color-mix(in srgb, var(--dt-critical) 80%, black);stroke:var(--dt-critical)" stroke-width="1"/>
        <line x1="3.5" y1="3.5" x2="8.5" y2="8.5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        <line x1="8.5" y1="3.5" x2="3.5" y2="8.5" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span style="color:var(--critical);font-weight:700;font-size:var(--wf-text-small)">Exception</span>
    </div>
    <div style="color:var(--text-default);word-break:break-word;font-size:11px">${escHtml(displayName)}</div>`;
    positionTooltip(exTtEl, e.clientX, e.clientY);
  });
  node.addEventListener("mousemove", (e) => positionTooltip(exTtEl, e.clientX, e.clientY));
  node.addEventListener("mouseleave", () => hideTooltip(exTtEl));
}

document.addEventListener("mouseleave", () => { hideTooltip(ttEl); hideTooltip(lineTtEl); hideTooltip(exTtEl); });

// ─── Interactive state ──────────────────────────────────────────────────
const state = {
  groupBy: "chronological",   // "chronological" | "type"
  showLongTasks: true,
  showExceptions: true,
  hiddenMetrics: new Set(),
};

let stickyPillsData = null; // { phaseGroups, maxMs, timelineLeft, timelineWidth }

function renderControls() {
  const slot = document.getElementById("controls-slot");
  slot.innerHTML = "";
  const row = el("div", "controls-row");

  // Order
  const orderGroup = el("div", "control-group");
  orderGroup.appendChild(el("span", "subdued small", "Order"));
  const orderBtns = el("div", "control-buttons");
  const chronoBtn = el("button", "btn" + (state.groupBy === "chronological" ? " active" : ""), "Chronological");
  chronoBtn.onclick = () => { state.groupBy = "chronological"; renderAll(); };
  const typeBtn = el("button", "btn" + (state.groupBy === "type" ? " active" : ""), "Group by Type");
  typeBtn.onclick = () => { state.groupBy = "type"; renderAll(); };
  orderBtns.appendChild(chronoBtn); orderBtns.appendChild(typeBtn);
  orderGroup.appendChild(orderBtns);
  row.appendChild(orderGroup);

  const allMarkers = buildPhaseMarkers();
  if (allMarkers.length > 0 || (summary.longTaskOccurrences || []).length > 0 || exceptions.length > 0) {
    row.appendChild(el("div", "control-sep"));
    const overlayGroup = el("div", "control-group");
    overlayGroup.appendChild(el("span", "subdued small", "Overlays"));
    const overlayBtns = el("div", "control-buttons");
    if ((summary.longTaskOccurrences || []).length > 0) {
      const ltBtn = el("button", "btn" + (state.showLongTasks ? " active" : ""), "Long Tasks");
      ltBtn.onclick = () => { state.showLongTasks = !state.showLongTasks; renderAll(); };
      overlayBtns.appendChild(ltBtn);
    }
    if (exceptions.length > 0) {
      const exBtn = el("button", "btn" + (state.showExceptions ? " active" : ""), "JS Errors");
      exBtn.onclick = () => { state.showExceptions = !state.showExceptions; renderAll(); };
      overlayBtns.appendChild(exBtn);
    }
    for (const m of allMarkers) {
      const active = !state.hiddenMetrics.has(m.key);
      const mBtn = el("button", "btn" + (active ? " active" : ""), m.label);
      mBtn.onclick = () => {
        if (state.hiddenMetrics.has(m.key)) state.hiddenMetrics.delete(m.key); else state.hiddenMetrics.add(m.key);
        renderAll();
      };
      overlayBtns.appendChild(mBtn);
    }
    overlayGroup.appendChild(overlayBtns);
    row.appendChild(overlayGroup);
  }

  slot.appendChild(row);
}

function renderWaterfall() {
  const slot = document.getElementById("waterfall-slot");
  slot.innerHTML = "";
  const ltLabelSlot = document.getElementById("longtask-labels-slot");
  ltLabelSlot.innerHTML = "";
  const legendSlot = document.getElementById("legend-slot");
  legendSlot.innerHTML = "";
  const lcpSlot = document.getElementById("lcp-slot");
  lcpSlot.innerHTML = "";

  const resourceOriginMs = navRequest?.startAbsoluteMs ?? summary.performanceTimeOriginMs;

  // Action end goes into the same maxMs the resource bars scale against —
  // this is what guarantees the action bar's right edge lands at or beyond
  // the last resource bar's, rather than a coincidence of the data.
  const hasAction = action && action.durationMs != null && action.startAbsoluteMs != null;
  const actionEndRelMs = hasAction
    ? (action.endAbsoluteMs ?? action.startAbsoluteMs + action.durationMs) - resourceOriginMs
    : 0;

  const maxMs = Math.max(
    ...requests.map((r) => r.endAbsoluteMs - resourceOriginMs),
    ttfbPositionMs ?? 0,
    actionEndRelMs,
    500
  ) * 1.02;

  const toPct = (ms) => (ms / maxMs) * 100;

  const allMarkers = buildPhaseMarkers().filter((m) => m.valueMs <= maxMs);
  const visibleMarkers = allMarkers.filter((m) => !state.hiddenMetrics.has(m.key));
  const phaseGroups = groupPhaseMarkers(visibleMarkers, maxMs);
  const ticks = buildTicks(maxMs);

  const visibleExceptions = exceptions
    .map((e) => ({ ...e, relativeMs: e.startAbsoluteMs - resourceOriginMs }))
    .filter((e) => e.relativeMs >= 0 && e.relativeMs <= maxMs);

  const lcpUrl = summary.lcpElementUrl ?? null;
  const waterfallItems = buildWaterfallItems(requests, state.groupBy);

  const wf = el("div", "waterfall");

  // Header
  const header = el("div", "wf-header");
  header.appendChild(el("div", "col-label", `<span class="subdued small">Resource</span>`));
  header.appendChild(el("div", "col-type", `<span class="subdued small">Type</span>`));
  header.appendChild(el("div", "col-dur", `<span class="subdued small">Duration</span>`));
  const colTimeline = el("div", "col-timeline-hd");
  for (const group of phaseGroups) {
    const pill = el("div", "pill");
    pill.style.left = toPct(group.valueMs) + "%";
    pill.style.top = LABEL_ROW_0 + "px";
    pill.innerHTML = group.markers.map((m, i) =>
      (i > 0 ? `<span class="subdued">·</span> ` : "") + `<span style="color:${m.color}">${escHtml(m.label)}</span>`
    ).join(" ");
    attachLineHover(pill, group);
    colTimeline.appendChild(pill);
  }
  const zeroLabel = el("div", "tick-label", "0 ms");
  zeroLabel.style.left = "1px";
  colTimeline.appendChild(zeroLabel);
  for (const t of ticks) {
    const lbl = el("div", "tick-label", formatMs(t));
    lbl.style.left = toPct(t) + "%";
    colTimeline.appendChild(lbl);
  }
  header.appendChild(colTimeline);
  wf.appendChild(header);

  const body = el("div", "wf-body");

  const gridOverlay = el("div", "wf-overlay");
  gridOverlay.style.left = LEFT_OFFSET + "px";
  gridOverlay.style.top = "0";
  gridOverlay.style.pointerEvents = "none";
  const origin = el("div", "origin-line"); origin.style.left = "0";
  gridOverlay.appendChild(origin);
  for (const t of ticks) {
    const line = el("div", "tick-line");
    line.style.left = toPct(t) + "%";
    gridOverlay.appendChild(line);
  }
  body.appendChild(gridOverlay);

  if (hasAction) {
    const relStartMs = action.startAbsoluteMs - resourceOriginMs;
    const startPct = (relStartMs / maxMs) * 100;
    const widthPct = Math.max((actionEndRelMs - relStartMs) / maxMs * 100, 0.15);

    const actionRow = el("div", "wf-row wf-action-row");
    const labelCell = el("div", "cell-label");
    labelCell.title = action.name || "";
    labelCell.appendChild(el("span", "url", escHtml(action.name || "User action")));
    actionRow.appendChild(labelCell);
    actionRow.appendChild(el("div", "cell-type"));
    actionRow.appendChild(el("div", "cell-dur", formatMs(action.durationMs)));
    const timelineCell = el("div", "cell-timeline");
    const actionBar = el("div", "bar action-bar");
    actionBar.style.left = startPct + "%";
    actionBar.style.width = widthPct + "%";
    timelineCell.appendChild(actionBar);
    actionRow.appendChild(timelineCell);
    body.appendChild(actionRow);
  }

  const longTasks = (summary.longTaskOccurrences || []).filter((lt) => lt.startMs < maxMs && lt.startMs + lt.durationMs > 0);
  if (state.showLongTasks && longTasks.length > 0) {
    const ltOverlay = el("div", "wf-overlay");
    ltOverlay.style.left = LEFT_OFFSET + "px";
    ltOverlay.style.top = "64px";
    ltOverlay.style.pointerEvents = "none";
    for (const lt of longTasks) {
      const leftPct = (lt.startMs / maxMs) * 100;
      const widthPct = Math.min((lt.startMs + lt.durationMs) / maxMs * 100, 100) - leftPct;
      const block = el("div", "longtask-block");
      block.style.left = leftPct + "%";
      block.style.width = widthPct + "%";
      ltOverlay.appendChild(block);
    }
    body.appendChild(ltOverlay);
  }

  const lineOverlay = el("div", "wf-overlay");
  lineOverlay.style.left = LEFT_OFFSET + "px";
  lineOverlay.style.top = "0";
  lineOverlay.style.zIndex = "9";
  lineOverlay.style.pointerEvents = "none";
  for (const group of phaseGroups) {
    const hit = el("div", "phase-line-hit");
    hit.style.left = `calc(${toPct(group.valueMs)}% - 4px)`;
    hit.style.top = (LABEL_ROW_0 + PILL_HEIGHT) + "px";
    hit.style.pointerEvents = "auto";
    hit.appendChild(el("div", "phase-line"));
    attachLineHover(hit, group);
    lineOverlay.appendChild(hit);
  }
  body.appendChild(lineOverlay);

  if (state.showExceptions && visibleExceptions.length > 0) {
    const exOverlay = el("div", "wf-overlay");
    exOverlay.style.left = LEFT_OFFSET + "px";
    exOverlay.style.top = "0";
    exOverlay.style.zIndex = "8";
    exOverlay.style.pointerEvents = "none";
    for (const ex of visibleExceptions) {
      const leftPct = (ex.relativeMs / maxMs) * 100;
      const MARKER_R = 7;
      const wrap = el("div", "ex-marker");
      wrap.style.left = leftPct + "%";
      wrap.style.transform = "translateX(-50%)";
      wrap.style.width = (MARKER_R * 2) + "px";
      wrap.style.pointerEvents = "auto";
      const line = el("div", "ex-line");
      line.style.left = MARKER_R + "px";
      line.style.top = (LABEL_ROW_0 + MARKER_R * 2) + "px";
      wrap.appendChild(line);
      const svgNs = "http://www.w3.org/2000/svg";
      const svg = document.createElementNS(svgNs, "svg");
      svg.setAttribute("width", MARKER_R * 2);
      svg.setAttribute("height", MARKER_R * 2);
      svg.setAttribute("viewBox", `0 0 ${MARKER_R * 2} ${MARKER_R * 2}`);
      svg.style.position = "absolute";
      svg.style.top = LABEL_ROW_0 + "px";
      svg.style.left = "0";
      const circle = document.createElementNS(svgNs, "circle");
      circle.setAttribute("cx", MARKER_R); circle.setAttribute("cy", MARKER_R); circle.setAttribute("r", MARKER_R - 0.5);
      circle.style.fill = "color-mix(in srgb, var(--dt-critical) 80%, black)"; circle.style.stroke = "var(--dt-critical)"; circle.setAttribute("stroke-width", "1");
      svg.appendChild(circle);
      for (const [x1, y1, x2, y2] of [[4,4,MARKER_R*2-4,MARKER_R*2-4],[MARKER_R*2-4,4,4,MARKER_R*2-4]]) {
        const l2 = document.createElementNS(svgNs, "line");
        l2.setAttribute("x1", x1); l2.setAttribute("y1", y1); l2.setAttribute("x2", x2); l2.setAttribute("y2", y2);
        l2.setAttribute("stroke", "white"); l2.setAttribute("stroke-width", "1.5"); l2.setAttribute("stroke-linecap", "round");
        svg.appendChild(l2);
      }
      wrap.appendChild(svg);
      attachExceptionHover(wrap, ex.displayName);
      exOverlay.appendChild(wrap);
    }
    body.appendChild(exOverlay);
  }

  for (const item of waterfallItems) {
    if (item.kind === "header") {
      const secHeader = el("div", "wf-section-header");
      secHeader.appendChild(el("div", "lbl", escHtml(item.label)));
      secHeader.appendChild(el("div", "rule"));
      body.appendChild(secHeader);
      continue;
    }

    const { req, origIdx } = item;
    const relativeStartMs = req.startAbsoluteMs - resourceOriginMs;
    const relativeEndMs = req.endAbsoluteMs - resourceOriginMs;
    const startPct = (relativeStartMs / maxMs) * 100;
    const widthPct = Math.max((relativeEndMs - relativeStartMs) / maxMs * 100, 0.15);
    const { light: barLight, dark: color } = resourceColors(req);
    const isEven = item.visualRowIdx % 2 === 0;
    const url = req.urlPath || "/";
    const isLcp = lcpUrl !== null && lcpMatchesRequest(lcpUrl, req);
    const isErrored = req.hasFailed || req.hasCspViolation;
    const failedBarColor = "var(--critical)";
    const barColor = isErrored ? failedBarColor : color;
    const barLightColor = isErrored ? failedBarColor : barLight;
    const barLightRing = `inset 0 0 0 1px ${isErrored ? failedBarColor : color}`;
    const type = resolveType(req);

    const row = el("div", `wf-row ${isEven ? "even" : "odd"}${isLcp ? " lcp" : ""}${req.hasPending ? " pending" : ""}`);

    const labelCell = el("div", "cell-label");
    labelCell.title = `${req.urlDomain}${url}`;
    if (req.incompleteReason && !isCacheLike(req)) {
      const warnIcon = el("span", "small", "⚠");
      warnIcon.style.color = "var(--warning)";
      warnIcon.title = "Invalid timings";
      labelCell.appendChild(warnIcon);
    }
    labelCell.appendChild(el("span", "url" + (isErrored ? " err" : ""), escHtml(url)));
    row.appendChild(labelCell);

    const typeCell = el("div", "cell-type", escHtml(resourceLabel(req)));
    // Raw hues run 2.3-3.7:1 as 10px text on this canvas. 55% is the
    // least-diluted mix toward the ink token at which every type clears 4.5:1.
    typeCell.style.color = isErrored ? failedBarColor : `color-mix(in srgb, ${color} 55%, var(--dt-text-primary))`;
    row.appendChild(typeCell);

    const durCell = el("div", `cell-dur${isErrored ? " err" : ""}`, formatMs(req.durationMs));
    row.appendChild(durCell);

    const timelineCell = el("div", "cell-timeline");

    if (!isErrored && (type === "navigation" || type === "document") && req.responseEndNs != null) {
      const respEndMs = relativeStartMs + req.responseEndNs / 1e6;
      const loadStartMs = req.loadEventStartNs != null ? relativeStartMs + req.loadEventStartNs / 1e6 : null;
      const loadEndMs2 = req.loadEventEndNs != null ? relativeStartMs + req.loadEventEndNs / 1e6 : null;
      const processingEnd = loadStartMs ?? loadEndMs2;
      const navPhaseColor1 = "#7C3AED", navPhaseColor2 = "#34D399";
      if (processingEnd != null && processingEnd - respEndMs >= 1) {
        const bar = el("div", "bar");
        bar.style.left = (respEndMs / maxMs * 100) + "%";
        bar.style.width = ((processingEnd - respEndMs) / maxMs * 100) + "%";
        bar.style.background = navPhaseColor1;
        attachBarHover(bar, req, relativeStartMs);
        timelineCell.appendChild(bar);
      }
      if (loadStartMs != null && loadEndMs2 != null && loadEndMs2 - loadStartMs >= 1) {
        const bar = el("div", "bar");
        bar.style.left = (loadStartMs / maxMs * 100) + "%";
        bar.style.width = ((loadEndMs2 - loadStartMs) / maxMs * 100) + "%";
        bar.style.background = navPhaseColor2;
        attachBarHover(bar, req, relativeStartMs);
        timelineCell.appendChild(bar);
      }
    }

    if (isErrored) {
      const bar = el("div", "bar");
      bar.style.left = startPct + "%"; bar.style.width = widthPct + "%"; bar.style.background = barColor;
      attachBarHover(bar, req, relativeStartMs);
      timelineCell.appendChild(bar);
    } else if (!req.hasW3cTimings || req.requestStartNs === null) {
      const isNav = type === "navigation" || type === "document";
      if (isNav && summary.ttfbMs != null && summary.ttfbMs > 0 && summary.ttfbMs < req.durationMs) {
        const ttfbPct = (summary.ttfbMs / maxMs) * 100;
        const respWPct = ((req.durationMs - summary.ttfbMs) / maxMs) * 100;
        const bar1 = el("div", "bar");
        bar1.style.left = startPct + "%"; bar1.style.width = ttfbPct + "%"; bar1.style.background = barLightColor; bar1.style.boxShadow = barLightRing;
        attachBarHover(bar1, req, relativeStartMs);
        timelineCell.appendChild(bar1);
        const bar2 = el("div", "bar");
        bar2.style.left = (startPct + ttfbPct) + "%"; bar2.style.width = respWPct + "%"; bar2.style.background = barColor;
        attachBarHover(bar2, req, relativeStartMs);
        timelineCell.appendChild(bar2);
      } else {
        const bar = el("div", "bar");
        bar.style.left = startPct + "%"; bar.style.width = widthPct + "%"; bar.style.background = barColor;
        attachBarHover(bar, req, relativeStartMs);
        timelineCell.appendChild(bar);
      }
    } else {
      const fetchMs = (req.fetchStartNs ?? 0) / 1e6;
      const reqMs = req.requestStartNs / 1e6;
      const respMs = (req.responseStartNs ?? req.requestStartNs) / 1e6;
      const endMs = req.responseEndNs != null && req.responseEndNs / 1e6 > 0.05 ? req.responseEndNs / 1e6 : req.durationMs;
      const stallMs = Math.max(0, reqMs - fetchMs);
      const pct = (ms) => ((relativeStartMs + ms) / maxMs) * 100;
      const wpct = (ms) => (ms / maxMs) * 100;

      if (stallMs >= 1) {
        const stallBar = el("div", "bar");
        stallBar.style.left = pct(fetchMs) + "%"; stallBar.style.width = wpct(stallMs) + "%";
        stallBar.appendChild(el("div", "stall-tick"));
        stallBar.appendChild(el("div", "stall-dash"));
        attachBarHover(stallBar, req, relativeStartMs);
        timelineCell.appendChild(stallBar);
      }
      if (respMs - reqMs >= 1) {
        const bar = el("div", "bar");
        bar.style.left = pct(reqMs) + "%"; bar.style.width = wpct(respMs - reqMs) + "%"; bar.style.background = barLightColor; bar.style.boxShadow = barLightRing;
        attachBarHover(bar, req, relativeStartMs);
        timelineCell.appendChild(bar);
      }
      if (endMs - respMs >= 1) {
        const bar = el("div", "bar");
        bar.style.left = pct(respMs) + "%"; bar.style.width = wpct(endMs - respMs) + "%"; bar.style.background = barColor;
        attachBarHover(bar, req, relativeStartMs);
        timelineCell.appendChild(bar);
      }
      if (endMs < 0.05) {
        const bar = el("div", "bar");
        bar.style.left = startPct + "%"; bar.style.width = "2px"; bar.style.background = barColor;
        attachBarHover(bar, req, relativeStartMs);
        timelineCell.appendChild(bar);
      }
    }

    row.appendChild(timelineCell);
    body.appendChild(row);
  }

  wf.appendChild(body);
  document.getElementById("waterfall-slot").appendChild(wf);

  // Long task duration labels
  if (longTasks.length > 0) {
    const ltLabelWrap = el("div");
    ltLabelWrap.style.position = "relative";
    ltLabelWrap.style.height = "20px";
    ltLabelWrap.style.marginTop = "4px";
    if (state.showLongTasks) {
      const inner = el("div");
      inner.style.position = "absolute"; inner.style.left = LEFT_OFFSET + "px"; inner.style.right = "0"; inner.style.top = "0"; inner.style.bottom = "0";
      let lastCenterPct = -100;
      for (const lt of longTasks) {
        const centerPct = Math.min((lt.startMs + lt.durationMs / 2) / maxMs * 100, 100);
        if (Math.abs(centerPct - lastCenterPct) < 4) continue;
        const lbl = el("div", "small", formatMs(lt.durationMs));
        lbl.style.position = "absolute"; lbl.style.left = centerPct + "%"; lbl.style.transform = "translateX(-50%)";
        lbl.style.color = "color-mix(in srgb, var(--critical) 60%, transparent)"; lbl.style.whiteSpace = "nowrap"; lbl.style.lineHeight = "20px";
        inner.appendChild(lbl);
        lastCenterPct = centerPct;
      }
      ltLabelWrap.appendChild(inner);
    }
    ltLabelSlot.appendChild(ltLabelWrap);
  }

  // Legend
  const legend = el("div", "legend");
  const legendLabels = { document: "Document", script: "Script", stylesheet: "Stylesheet", font: "Font", image: "Image", fetch: "XHR / Fetch", beacon: "Beacon", media: "Media", other: "Other" };
  for (const [type2, pair] of Object.entries(RESOURCE_COLORS)) {
    if (["xmlhttprequest", "navigation", "xhr"].includes(type2)) continue;
    const item = el("div", "legend-item");
    const sw = el("div", "legend-swatch"); sw.style.background = pair.dark;
    item.appendChild(sw);
    item.appendChild(el("span", "subdued small", legendLabels[type2] ?? type2));
    legend.appendChild(item);
  }
  legend.appendChild(el("div", "legend-sep"));
  for (const m of allMarkers) {
    const item = el("div", "legend-item");
    const line = el("div", "legend-line"); line.style.background = m.color;
    item.appendChild(line);
    item.appendChild(el("span", "subdued small", `${m.label} ${formatMs(m.valueMs)}`));
    legend.appendChild(item);
  }
  legendSlot.appendChild(legend);

  // LCP resource status
  const lcpMatched = lcpUrl !== null && requests.some((r) => lcpMatchesRequest(lcpUrl, r));
  const lcpStatus = el("div", "lcp-status");
  const bar = el("div"); bar.style.width = "3px"; bar.style.height = "14px"; bar.style.background = "var(--warning)"; bar.style.borderRadius = "1px"; bar.style.flexShrink = "0";
  lcpStatus.appendChild(bar);
  lcpStatus.appendChild(el("span", "subdued small", "LCP resource:"));
  if (lcpUrl) {
    const statusSpan = el("span", "small", lcpMatched ? "matched" : "not found in waterfall");
    statusSpan.style.color = lcpMatched ? "var(--warning)" : "var(--text-disabled)";
    statusSpan.style.fontWeight = "600";
    lcpStatus.appendChild(statusSpan);
    lcpStatus.appendChild(el("span", "lcp-url small", lcpUrl));
  } else {
    const msg = summary.lcpMs != null
      ? (summary.lcpElementType ? `no URL — element type is "${summary.lcpElementType}" (likely a text node)` : "lcp.element.url not populated in page summary")
      : "no LCP recorded for this page instance";
    const s = el("span", "small", msg);
    s.style.color = "var(--text-disabled)";
    lcpStatus.appendChild(s);
  }
  lcpSlot.appendChild(lcpStatus);

  // Sticky pills setup
  stickyPillsData = { phaseGroups, maxMs, wfEl: wf };
  updateStickyPills();
}

function updateStickyPills() {
  const sticky = document.getElementById("sticky-pills");
  if (!stickyPillsData || !sticky) return;
  const { phaseGroups, maxMs, wfEl } = stickyPillsData;
  const rect = wfEl.getBoundingClientRect();
  const timelineLeft = rect.left + LEFT_OFFSET;
  const timelineWidth = rect.width - LEFT_OFFSET;
  const shouldShow = rect.top < 0 && rect.bottom > 0;
  if (!shouldShow) { sticky.style.display = "none"; return; }
  sticky.style.display = "block";
  sticky.innerHTML = "";
  for (const group of phaseGroups) {
    const left = timelineLeft + (group.valueMs / maxMs) * timelineWidth;
    const pill = el("div", "pill");
    pill.style.left = left + "px";
    pill.style.top = "0";
    pill.innerHTML = group.markers.map((m, i) =>
      (i > 0 ? `<span class="subdued">·</span> ` : "") + `<span style="color:${m.color}">${escHtml(m.label)}</span>`
    ).join(" ");
    attachLineHover(pill, group);
    sticky.appendChild(pill);
  }
}

// ═══ Aggregate sections ═══════════════════════════════════════════════
// Everything below is cross-session. The waterfall above is one sampled load;
// these panels are the page. Formatting goes through the waterfall's own
// formatMs / formatBytes / escHtml and its msRating / RATING_COLORS pair, so
// the two halves of the report speak the same language.

const T = DATA.thresholds;
// A null here means "the tenant did not report this metric", which is not the
// same statement as zero. Every value in every aggregate section goes through
// this, so the two can never be confused.
const NIL = '<span class="nil">—</span>';
const fmt = (v, f) => (v == null ? NIL : f(v));
const fmtInt = (v) => fmt(v, (n) => Math.round(n).toLocaleString());
// Both tails carry the signal and both round away under Math.round: a 0.4%
// error rate is not 0%, and 76,783 of 76,962 loads is not "100%" — the 179
// loads without a long task are the difference between "always" and "nearly
// always". So the ends keep a decimal place and only the middle rounds whole.
const fmtPct = (v) => {
  if (v == null) return NIL;
  const pct = v * 100;
  if (pct > 0 && pct < 0.1) return "&lt; 0.1%";
  if (pct < 10 || (pct > 90 && pct < 100)) return parseFloat(pct.toFixed(1)) + "%";
  return Math.round(pct) + "%";
};
const truncate = (s, n) => (s.length > n ? s.slice(0, n - 1) + "…" : s);

function ratingCell(value, thresholdKey, format) {
  if (value == null) return NIL;
  const t = T[thresholdKey];
  const rating = msRating(value, [t.good, t.poor]);
  const word = { good: "Good", "needs-improvement": "Needs work", poor: "Poor" }[rating];
  // Never colour alone: the rating word rides alongside the coloured figure.
  return `<span class="rating" style="color:${RATING_COLORS[rating]}">${escHtml(format(value))}` +
         `<span class="word">${word}</span></span>`;
}

// The signature device. `loads` against the page's total load count is the one
// number that separates a page-wide problem from one unlucky load, so it gets a
// bar in the second column rather than a digit in a narrow numeric one.
// `markRare` is on for resources and third parties, where the question the
// column answers is "does this finding describe the page". It is off for the
// browser/device split, where the same low share means a small but perfectly
// real audience segment, not an unreliable measurement.
function coverageCell(loads, total, markRare) {
  if (loads == null || !total) return NIL;
  const share = loads / total;
  const rare = markRare && share < T.prevalence.rare;
  return `<div class="cov">` +
    `<div class="cov-track"><div class="cov-fill" style="width:${(Math.min(share, 1) * 100).toFixed(1)}%"></div></div>` +
    `<span class="cov-text"><strong>${fmtPct(share)}</strong> ` +
    `<span class="of">${Math.round(loads).toLocaleString()} of ${Math.round(total).toLocaleString()}</span></span>` +
    (rare ? `<span class="chip rare" title="Below ${Math.round(T.prevalence.rare * 100)}% of loads — too few to generalise from">rare</span>` : "") +
    `</div>`;
}

function aggTable(cols, rows) {
  const head = cols.map((c) => `<th class="${c.num ? "num" : ""}">${escHtml(c.label)}</th>`).join("");
  const body = rows.map((r) =>
    `<tr>${cols.map((c) => `<td class="${c.num ? "num " : ""}${c.cls || ""}">${c.cell(r)}</td>`).join("")}</tr>`
  ).join("");
  return `<table class="agg-table"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table>`;
}

const setSlot = (id, html) => { document.getElementById(id).innerHTML = html; };
const emptyNote = (why) => `<p class="empty-note">${escHtml(why)}</p>`;

function renderSkipped() {
  const files = DATA.skipped || [];
  if (!files.length) return;
  setSlot("skipped-slot",
    `<div class="skipped-banner">Partial report — ${files.length} data file${files.length > 1 ? "s were" : " was"} ` +
    `missing or empty and the matching section${files.length > 1 ? "s are" : " is"} incomplete: ` +
    files.map((f) => `<code>${escHtml(f)}</code>`).join(", ") + `</div>`);
}

// ─── 1. Core Web Vitals ───────────────────────────────────────────────
// A table, not a chart: five metrics on five incompatible scales (ms and an
// unitless shift score) have no shared axis, and the reader's question is
// "what is the number and is it acceptable", which is a lookup.
const CWV_ROWS = [
  { label: "LCP", name: "Largest contentful paint", key: "lcp", th: "lcp", fmt: formatMs },
  { label: "FCP", name: "First contentful paint", key: "fcp", th: "fcp", fmt: formatMs },
  { label: "INP", name: "Interaction to next paint", key: "inp", th: "inp", fmt: formatMs },
  // Routed through msRating, not the ported clsRating: clsRating hardcodes the
  // same 0.1 / 0.25 boundaries THRESHOLDS now owns, and it is the identical
  // two-boundary comparator, so driving CLS through msRating keeps one source
  // of truth instead of two copies that can drift apart. Not a replacement
  // helper — msRating is the ported one.
  // toFixed(3) alone prints this tenant's real 0.0001 as "0.000", which is a
  // measured non-zero shown as no shift at all. Anything below the last
  // displayed digit is labelled as such instead.
  { label: "CLS", name: "Cumulative layout shift", key: "cls", th: "cls",
    fmt: (v) => (v > 0 && v < 0.001 ? "< 0.001" : v.toFixed(3)) },
  { label: "TTFB", name: "Time to first byte", key: "ttfb", th: "ttfb", fmt: formatMs },
];
function renderCwv() {
  const c = DATA.cwv;
  document.getElementById("cwv-note").innerHTML = c.loads == null
    ? "No page summaries returned for this page."
    : `Percentiles across <strong>${Math.round(c.loads).toLocaleString()}</strong> page loads. ` +
      `p75 is the figure Core Web Vitals is assessed on.`;
  setSlot("cwv-slot", aggTable([
    { label: "Metric", cell: (r) => `<span class="lead">${escHtml(r.label)}</span> <span class="subdued">${escHtml(r.name)}</span>` },
    { label: "p50", num: true, cell: (r) => fmt(c[r.key + "P50"], r.fmt) },
    { label: "p75", num: true, cell: (r) => ratingCell(c[r.key + "P75"], r.th, r.fmt) },
    { label: "p95", num: true, cell: (r) => ratingCell(c[r.key + "P95"], r.th, r.fmt) },
  ], CWV_ROWS));
}

// ─── 2. TTFB phases ───────────────────────────────────────────────────
const TTFB_PHASES = [
  { key: "dnsP75", label: "DNS" },
  { key: "connectionP75", label: "Connection" },
  { key: "requestP75", label: "Request" },
  { key: "waitingP75", label: "Waiting" },
  { key: "cacheP75", label: "Cache" },
];
// Single-hue sequential ramp keyed to stage order. Each step clears 3:1 against
// the panel surface so the thinnest segment stays visible; separation between
// neighbours comes from the 2px surface gap, not from hue.
const TTFB_RAMP = [
  "color-mix(in srgb, var(--dt-primary) 70%, var(--dt-bg-base))",
  "color-mix(in srgb, var(--dt-primary) 85%, var(--dt-bg-base))",
  "var(--dt-primary)",
  "color-mix(in srgb, var(--dt-text-primary) 40%, var(--dt-primary))",
  "color-mix(in srgb, var(--dt-text-primary) 75%, var(--dt-primary))",
];
function renderTtfb() {
  const p = DATA.ttfbPhases;
  const present = TTFB_PHASES.map((ph, i) => ({ ...ph, value: p[ph.key], color: TTFB_RAMP[i] }))
    .filter((ph) => ph.value != null);
  const note = document.getElementById("ttfb-note");
  if (!present.length) {
    note.textContent = "";
    setSlot("ttfb-slot", emptyNote("No connection-phase timings were reported for this page."));
    return;
  }
  const sum = present.reduce((a, ph) => a + ph.value, 0);
  const ttfbP75 = DATA.cwv.ttfbP75;
  // Honesty over tidiness: independent p75s do not add up to the p75 of their
  // sum, so the bar total is labelled as a sum of phase p75s and the measured
  // TTFB p75 is printed next to it rather than being implied by the bar.
  note.innerHTML =
    `Phase p75s across <strong>${p.loads == null ? "—" : Math.round(p.loads).toLocaleString()}</strong> loads. ` +
    `Percentiles are computed per phase and do not sum, so the bar totals ` +
    `<strong>${formatMs(sum)}</strong> against a measured TTFB p75 of ` +
    `<strong>${ttfbP75 == null ? "—" : formatMs(ttfbP75)}</strong>. Read the segments, not the total.`;
  const total = sum || 1;
  setSlot("ttfb-slot",
    `<div class="ttfb-breakdown">` +
      `<div class="ttfb-bar" role="img" aria-label="${escHtml(present.map((ph) => `${ph.label} ${formatMs(ph.value)}`).join(", "))}">` +
      // Zero-length phases are real on fast origins (this tenant reports DNS,
      // connection and cache all at 0 ms p75). They stay in the legend, where
      // a sub-millisecond phase is a finding, but they get no segment — a 0 ms
      // as a 2px sliver would read as a small non-zero one.
      present.filter((ph) => ph.value > 0).map((ph) =>
        `<div style="width:${(ph.value / total * 100).toFixed(2)}%;background:${ph.color}" title="${escHtml(ph.label)} ${escHtml(formatMs(ph.value))}"></div>`
      ).join("") +
      `</div>` +
      `<div class="ttfb-legend">` +
      present.map((ph) =>
        `<span class="ttfb-legend-item"><span class="swatch" style="background:${ph.color}"></span>` +
        `<span class="k">${escHtml(ph.label)}</span> <span class="v">${escHtml(formatMs(ph.value))}</span></span>`
      ).join("") +
      `</div></div>`);
}

// ─── 3 & 4. Slowest and heaviest resources ────────────────────────────
const RESOURCE_COLS = [
  { label: "Resource", cell: (r) => {
      const path = r.path || "/";
      return `<span class="path" title="${escHtml(path)}">${escHtml(truncate(path, 60))}</span>` +
        (r.failures > 0 ? ` <span class="chip" style="color:var(--critical);border-color:color-mix(in srgb, var(--critical) 45%, transparent)">${r.failures.toLocaleString()} failed</span>` : "") +
        (r.blocking > 0 ? ` <span class="chip">render blocking</span>` : "");
    } },
  { label: "Present in", cell: (r) => coverageCell(r.loads, DATA.loadCount, true) },
  { label: "Domain", cell: (r) => escHtml(r.domain || "—") },
  { label: "Type", cell: (r) => escHtml(r.initiatorType || "—") },
  { label: "p50", num: true, cell: (r) => fmt(r.durationP50, formatMs) },
  { label: "p75", num: true, cls: "lead", cell: (r) => fmt(r.durationP75, formatMs) },
  { label: "p95", num: true, cell: (r) => fmt(r.durationP95, formatMs) },
  { label: "Transfer p75", num: true, cell: (r) => fmt(r.transferP75, formatBytes) },
];
// Nulls sort last in both directions — an unreported figure is not a small one.
const byDesc = (field) => (a, b) =>
  (b[field] == null ? -Infinity : b[field]) - (a[field] == null ? -Infinity : a[field]);

function renderResourceTable(slotId, noteId, field, blurb) {
  const rows = [...DATA.resources].sort(byDesc(field)).slice(0, 20);
  const note = document.getElementById(noteId);
  if (!rows.length) {
    note.textContent = "";
    setSlot(slotId, emptyNote("No resource timings were returned for this page."));
    return;
  }
  note.innerHTML = `${blurb} <strong>Present in</strong> is the share of the page's ` +
    `${DATA.loadCount == null ? "—" : Math.round(DATA.loadCount).toLocaleString()} loads that requested this resource: ` +
    `a slow figure over a full bar is a page problem, the same figure over a sliver is a handful of unlucky loads.`;
  setSlot(slotId, aggTable(RESOURCE_COLS, rows));
}

// ─── 5. Third parties ─────────────────────────────────────────────────
function renderThirdParty() {
  let origin = null;
  try { origin = new URL(summary.pageUrl).hostname; } catch { /* pageUrl may be a path */ }
  const rows = DATA.thirdParty.filter((r) => r.domain && r.domain !== origin).sort(byDesc("transferP75"));
  const note = document.getElementById("thirdparty-note");
  if (!rows.length) {
    note.textContent = "";
    setSlot("thirdparty-slot", emptyNote(origin
      ? `No requests to domains other than ${origin} were recorded for this page.`
      : "No third-party requests were recorded for this page."));
    return;
  }
  note.innerHTML = `${rows.length} domain${rows.length > 1 ? "s" : ""} other than ` +
    `<strong>${escHtml(origin || "the page origin")}</strong>, by transfer size.`;
  setSlot("thirdparty-slot", aggTable([
    { label: "Domain", cell: (r) => `<span class="path">${escHtml(r.domain)}</span>` },
    { label: "Present in", cell: (r) => coverageCell(r.loads, DATA.loadCount, true) },
    { label: "Requests", num: true, cell: (r) => fmtInt(r.requests) },
    { label: "Per load", num: true, cell: (r) => (r.loads ? (r.requests / r.loads).toFixed(1) : NIL) },
    { label: "Duration p75", num: true, cls: "lead", cell: (r) => fmt(r.durationP75, formatMs) },
    { label: "Transfer p75", num: true, cell: (r) => fmt(r.transferP75, formatBytes) },
  ], rows));
}

// ─── 6. Long tasks and errors ─────────────────────────────────────────
// Stat tiles rather than a chart: each of these is one number with a
// denominator, which is the definition of a stat tile, not of a plot.
const tile = (label, value, sub) =>
  `<div class="metric-tile"><span class="label">${escHtml(label)}</span>` +
  `<p class="value">${value}</p><span class="sub">${sub}</span></div>`;
const rateTile = (label, count, denom, denomLabel) =>
  tile(label, count == null || !denom ? NIL : fmtPct(count / denom),
    count == null ? "not reported" : `${Math.round(count).toLocaleString()} of ${denom == null ? "—" : Math.round(denom).toLocaleString()} ${denomLabel}`);

function renderMainThread() {
  const lt = DATA.longTasks, er = DATA.errors;
  document.getElementById("mainthread-note").innerHTML =
    `Rates are over each measure's own denominator — long tasks over ` +
    `<strong>${lt.loads == null ? "—" : Math.round(lt.loads).toLocaleString()}</strong> loads, ` +
    `errors over <strong>${er.loads == null ? "—" : Math.round(er.loads).toLocaleString()}</strong>.`;
  setSlot("longtasks-slot", `<div class="metrics-row">` +
    rateTile("Loads with long tasks", lt.loadsWithLongTasks, lt.loads, "loads") +
    tile("Long tasks per load", fmtInt(lt.countP75), "p75") +
    tile("Average long task", fmt(lt.avgDurationP75, formatMs), "p75 of per-load average") +
    `</div>`);
  setSlot("errors-slot", `<div class="metrics-row">` +
    rateTile("Loads with any error", er.loadsWithAnyError, er.loads, "loads") +
    rateTile("Loads with a JS exception", er.loadsWithException, er.loads, "loads") +
    rateTile("Loads with a 4xx", er.loadsWith4xx, er.loads, "loads") +
    rateTile("Loads with a 5xx", er.loadsWith5xx, er.loads, "loads") +
    tile("Exceptions", fmtInt(er.exceptionTotal), "total across all loads") +
    tile("4xx responses", fmtInt(er.http4xxTotal), "total across all loads") +
    tile("5xx responses", fmtInt(er.http5xxTotal), "total across all loads") +
    `</div>`);
}

// ─── 7. Browser and device ────────────────────────────────────────────
function renderBrowserDevice() {
  const rows = [...DATA.browserDevice].sort(byDesc("loads"));
  const note = document.getElementById("browserdevice-note");
  if (!rows.length) {
    note.textContent = "";
    setSlot("browserdevice-slot", emptyNote("No browser or device breakdown was returned for this page."));
    return;
  }
  // Share is against the rows' own total, not DATA.loadCount: this query counts
  // page summaries, which is a different population from hard-navigation loads.
  const total = rows.reduce((a, r) => a + (r.loads || 0), 0);
  note.innerHTML = `<strong>${total.toLocaleString()}</strong> loads split by browser and device. ` +
    `A segment with a materially worse LCP p75 than the bulk of traffic is a targeting problem, not a page-wide one.`;
  setSlot("browserdevice-slot", aggTable([
    { label: "Browser", cell: (r) => `<span class="lead">${escHtml(r.browser || "—")}</span>` },
    { label: "Device", cell: (r) => escHtml(r.device || "—") },
    { label: "Share of loads", cell: (r) => coverageCell(r.loads, total, false) },
    { label: "LCP p75", num: true, cell: (r) => ratingCell(r.lcpP75, "lcp", formatMs) },
  ], rows));
}

function renderAggregates() {
  renderSkipped();
  renderCwv();
  renderTtfb();
  renderResourceTable("slowest-slot", "slowest-note", "durationP75", "Top 20 by p75 duration.");
  renderResourceTable("heaviest-slot", "heaviest-note", "transferP75", "Top 20 by p75 transfer size.");
  renderThirdParty();
  renderMainThread();
  renderBrowserDevice();
}

function renderAll() {
  renderAggregates();
  renderControls();
  renderWaterfall();
}

// Sticky pills container (fixed overlay, lives outside normal flow)
const stickyContainer = el("div", "sticky-pills");
stickyContainer.id = "sticky-pills";
document.body.appendChild(stickyContainer);
window.addEventListener("scroll", updateStickyPills, { passive: true });
window.addEventListener("resize", updateStickyPills);

renderAll();</script>
</body>
</html>
