fetch user.events, from: {{.timeframe}}
| filter frontend.name == "{{.frontend}}"
| filter page.detected_name == "{{.page}}"
| filter characteristics.has_user_action == true
| filter user_action.type == "hard_navigation"
| filter browser.name == "{{.browser}}"
| filter dt.rum.user_type == "real_user"
| filterOut user_action.complete_reason == "timeout"
| filter lcp.status == "reported"
| fieldsAdd lcp_ms = toDouble(coalesce(lcp.render_time, lcp.start_time))
| filter lcp_ms >= {{.low_bound}} AND lcp_ms <= {{.high_bound}}
| fieldsAdd lcp_kind = if(isNotNull(lcp.url), "image", else: "text"),
            lcp_key = coalesce(lcp.url, toString(lcp.ui_element.xpath), "unknown")
| fields user_action.instance_id, view.instance_id, dt.rum.session.id, lcp_ms, lcp_kind, lcp_key
// How common this load's LCP kind (image/text) and LCP element are across the
// page (all browsers), so the pick shows the typical LCP, not just a typical time.
| join [
    fetch user.events, from: {{.timeframe}}
    | filter frontend.name == "{{.frontend}}"
    | filter page.detected_name == "{{.page}}"
    | filter characteristics.has_user_action == true
    | filter user_action.type == "hard_navigation"
    | filter dt.rum.user_type == "real_user"
    | filter lcp.status == "reported"
    | fieldsAdd lcp_kind = if(isNotNull(lcp.url), "image", else: "text")
    | summarize loads = count(), by: {lcp_kind}
  ], on: {lcp_kind}, prefix: "kind."
| join [
    fetch user.events, from: {{.timeframe}}
    | filter frontend.name == "{{.frontend}}"
    | filter page.detected_name == "{{.page}}"
    | filter characteristics.has_user_action == true
    | filter user_action.type == "hard_navigation"
    | filter dt.rum.user_type == "real_user"
    | filter lcp.status == "reported"
    | fieldsAdd lcp_key = coalesce(lcp.url, toString(lcp.ui_element.xpath), "unknown")
    | summarize loads = count(), by: {lcp_key}
  ], on: {lcp_key}, prefix: "element."
| join [
    fetch user.events, from: {{.timeframe}}
    | filter frontend.name == "{{.frontend}}"
    | filter characteristics.has_page_summary == true
    | summarize count(), by: {view.instance_id, dt.rum.session.id}
  ], on: {view.instance_id, dt.rum.session.id}, prefix: "page_summary."
| join [
    fetch user.events, from: {{.timeframe}}
    | filter frontend.name == "{{.frontend}}"
    | filter characteristics.has_request == true
    | summarize requests = count(),
                navs = countIf(performance.initiator_type == "navigation"),
                bad_navs = countIf(performance.initiator_type == "navigation"
                                   AND (characteristics.has_failed_request == true
                                        OR toLong(http.response.status_code) >= 400)),
                by: {user_action.instance_id, dt.rum.session.id}
    | filter navs > 0 AND bad_navs == 0
  ], on: {user_action.instance_id, dt.rum.session.id}, prefix: "requests."
| fieldsAdd p75_distance = abs(lcp_ms - {{.p75}})
// Most common LCP kind first, then most common element, then closest to p75 —
// every candidate is already within the p75 window.
| sort kind.loads desc, element.loads desc, p75_distance asc
| limit 1
