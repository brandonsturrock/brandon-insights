fetch user.events, from: {{.timeframe}}
| filter frontend.name == "{{.frontend}}"
| filter dt.rum.user_type == "real_user"
| filter page.detected_name == "{{.page}}"
| filter characteristics.has_page_summary == true
      or (characteristics.has_user_action == true and user_action.type == "hard_navigation")
| fieldsAdd is_ua = coalesce(characteristics.has_user_action, false)
| fieldsAdd
    lcp_ms = if(is_ua and lcp.status == "reported", toDouble(coalesce(lcp.render_time, lcp.start_time))),
    fcp_ms = if(is_ua and fcp.status == "reported", toDouble(fcp.value)),
    cls_val = if(is_ua and cls.status == "reported", toDouble(cls.value)),
    ttfb_ms = if(is_ua and ttfb.status == "reported", toDouble(ttfb.value)),
    inp_ms = if(not is_ua and in(inp.status, "reported", "below_threshold"),
                toLong(web_vitals.interaction_to_next_paint) / 1000000)
| summarize
    loads = countIf(is_ua),
    lcp_n = countIf(isNotNull(lcp_ms)), fcp_n = countIf(isNotNull(fcp_ms)), inp_n = countIf(isNotNull(inp_ms)),
    cls_n = countIf(isNotNull(cls_val)), ttfb_n = countIf(isNotNull(ttfb_ms)),
    lcp_p50 = percentile(lcp_ms, 50), lcp_p75 = percentile(lcp_ms, 75), lcp_p95 = percentile(lcp_ms, 95),
    fcp_p50 = percentile(fcp_ms, 50), fcp_p75 = percentile(fcp_ms, 75), fcp_p95 = percentile(fcp_ms, 95),
    inp_p50 = percentile(inp_ms, 50), inp_p75 = percentile(inp_ms, 75), inp_p95 = percentile(inp_ms, 95),
    cls_p50 = percentile(cls_val, 50), cls_p75 = percentile(cls_val, 75), cls_p95 = percentile(cls_val, 95),
    ttfb_p50 = percentile(ttfb_ms, 50), ttfb_p75 = percentile(ttfb_ms, 75), ttfb_p95 = percentile(ttfb_ms, 95)
